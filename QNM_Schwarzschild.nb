Cell[BoxData[{
 RowBox[{
  RowBox[{"plots", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"iy", ",", "l", ",", "s", ",", "point"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"iy", "=", 
        RowBox[{"-", "2"}]}], ";", 
       RowBox[{"l", "=", 
        RowBox[{"Extract", "[", 
         RowBox[{"label", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", "ix", "}"}], ",", 
            RowBox[{"{", "iy", "}"}]}], "}"}]}], "]"}]}], ";", 
       RowBox[{"s", "=", 
        RowBox[{"Extract", "[", 
         RowBox[{"scale", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", "ix", "}"}], ",", 
            RowBox[{"{", "iy", "}"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"point", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Extract", "[", 
           RowBox[{"data", ",", 
            RowBox[{"{", 
             RowBox[{";;", ",", 
              RowBox[{"{", 
               RowBox[{"ix", ",", "iy"}], "}"}]}], "}"}]}], "]"}], ",", 
          RowBox[{"Extract", "[", 
           RowBox[{"accept", ",", 
            RowBox[{"{", 
             RowBox[{";;", ",", 
              RowBox[{"{", 
               RowBox[{"ix", ",", "iy"}], "}"}]}], "}"}]}], "]"}], ",", 
          RowBox[{"Extract", "[", 
           RowBox[{"reject", ",", 
            RowBox[{"{", 
             RowBox[{";;", ",", 
              RowBox[{"{", 
               RowBox[{"ix", ",", "iy"}], "}"}]}], "}"}]}], "]"}]}], "}"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"plots", ",", 
         RowBox[{"ListPlot", "[", 
          RowBox[{"point", ",", 
           RowBox[{"AxesLabel", "->", "l"}], ",", 
           RowBox[{"ScalingFunctions", "->", "s"}], ",", 
           RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"ix", ",", "3"}], "}"}]}], "]"}]}], "]"}], ";"}]}], "Input",
