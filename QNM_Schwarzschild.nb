             RowBox[{"hHor", "[", "2", "]"}]}], "-", 
            RowBox[{"8", " ", "\[ImaginaryI]", " ", "M", " ", "\[Omega]", " ", 
             RowBox[{"hHor", "[", "2", "]"}]}]}], ")"}]}]}], ")"}]}]}], 
     RowBox[{"16", " ", 
      SuperscriptBox["M", "4"]}]], "\[Equal]", "0"}]}], "}"}]], "Output",
 CellChangeTimes->{{4.000786396854471*^9, 4.000786427715355*^9}},
 CellLabel->"Out[19]=",ExpressionUUID->"68e9e2e8-5304-4d46-875f-ea664b07461d"]
}, Open  ]],

