Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Series", " ", "coefficients"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{"CoefHor", "[", "ord_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"H", ",", "EQ", ",", "s"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"H", "[", "r_", "]"}], ":=", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"hHor", "[", "i", "]"}], 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"r", "-", 
             RowBox[{"2", " ", "M"}]}], ")"}], "i"]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", 
           RowBox[{"ord", "+", "5"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"EQ", "=", 
       RowBox[{"sHor", "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"h", "[", "r", "]"}], "->", 
           RowBox[{"H", "[", "r", "]"}]}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"h", "'"}], "[", "r", "]"}], "->", 
           RowBox[{
            RowBox[{"H", "'"}], "[", "r", "]"}]}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"h", "''"}], "[", "r", "]"}], "->", 
           RowBox[{
            RowBox[{"H", "''"}], "[", "r", "]"}]}]}], "}"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"s", "=", 
       RowBox[{"Simplify", "[", 
        RowBox[{"Series", "[", 
         RowBox[{"EQ", ",", 
          RowBox[{"{", 
           RowBox[{"r", ",", 
            RowBox[{"2", " ", "M"}], ",", "ord"}], "}"}]}], "]"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Solve", " ", "the", " ", "system"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Simplify", "[", 
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"SeriesCoefficient", "[", 
             RowBox[{"s", ",", "i"}], "]"}], "==", "0"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "0", ",", "ord"}], "}"}]}], "]"}], ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"hHor", "[", "i", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", 
             RowBox[{"ord", "+", "1"}]}], "}"}]}], "]"}]}], "]"}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}]}]], "Input",
 CellChangeTimes->{
