Cell[CellGroupData[{

Cell["Expansion at the horizon", "Subsection",
 CellChangeTimes->{{3.9929406627121983`*^9, 
  3.9929406699501534`*^9}},ExpressionUUID->"f69ef447-5be9-5f4e-ad63-\
ba2c146cfdb2"],

Cell[TextData[{
 "The black hole surface is totally absorbing, hence at the horizon we \
require ingoing waves only:\n\t\[Psi] \[Tilde] ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]\[Omega]"}], " ", 
     SubscriptBox["r", "*"]}]], TraditionalForm]],ExpressionUUID->
  "afd59741-2a6d-4d4d-ba76-011c8d1f60c9"],
 "\nwhere ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "*"], TraditionalForm]],ExpressionUUID->
  "faa1edc9-564b-f340-970b-18220af3169c"],
 " is the tortoise coordinate. We multiply for a function of ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],ExpressionUUID->
  "d24880e2-d775-f540-9fd1-01465f82adf0"],
 " and expand it as series of powers around the horizon:\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Psi]", "\[Tilde]", 
     RowBox[{
      SuperscriptBox["e", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]\[Omega]"}], " ", 
        SubscriptBox["r", "*"]}]], 
      RowBox[{"h", "(", "r", ")"}]}]}], " ", "=", " ", 
    RowBox[{
     SuperscriptBox[
      RowBox[{
       SuperscriptBox["e", 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]\[Omega]"}], " ", "r"}]], "(", 
       RowBox[{"r", "-", 
        RowBox[{"2", "M"}]}], ")"}], 
      RowBox[{
       RowBox[{"-", "2"}], "M", " ", "\[ImaginaryI]\[Omega]"}]], 
     RowBox[{"h", "(", "r", ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "6179035a-790e-ec4f-a970-95c37c951ab7"],
 "\tusing the definition of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "*"], TraditionalForm]],ExpressionUUID->
  "4c6ea01a-12e3-414f-bdbe-a2e0f9f5c720"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"h", "(", "r", ")"}], " ", "=", " ", 
    RowBox[{"\[Sum]", 
     SuperscriptBox[
      RowBox[{
       SubscriptBox["h", "n"], "(", 
       RowBox[{"r", "-", 
        RowBox[{"2", "M"}]}], ")"}], "n"]}]}], TraditionalForm]],
  ExpressionUUID->"75d17250-9112-4e4e-886d-15a29c265826"],
 "\nThen, we substitute in the master equation and solve for the coefficients \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["h", "n"], TraditionalForm]],ExpressionUUID->
  "66eaffba-838a-2f46-80bc-c908f4b95627"],
 "."
}], "Text",
 CellChangeTimes->{{3.9929408626048985`*^9, 3.9929409537049065`*^9}, {
   3.992941015640381*^9, 3.9929411123381977`*^9}, {3.992941166304949*^9, 
   3.992941408674917*^9}, {3.9929414655163517`*^9, 3.99294149122591*^9}, {
   3.992941557414856*^9, 3.992941575865017*^9}, {3.9929416170965786`*^9, 
   3.9929419585161247`*^9}, {3.9929421203377476`*^9, 3.992942231143875*^9}, {
   3.992943155154804*^9, 3.992943213678217*^9}, 
   3.9929432712048187`*^9},ExpressionUUID->"62cf46de-e0b6-484a-901d-\
81991483f9c6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Phi]Hor", "[", "r_", "]"}], ":=", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"r", "-", 
        RowBox[{"2", "M"}]}], ")"}], 
      RowBox[{
       RowBox[{"-", "2"}], " ", "M", " ", "\[ImaginaryI]", " ", "\[Omega]"}]], 
     RowBox[{"h", "[", "r", "]"}]}]}], ";"}], 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "term", " ", 
     SuperscriptBox["e", 
      RowBox[{"-", "\[ImaginaryI]\[Omega]r"}]], " ", "can", " ", "be", " ", 
     "neglected", " ", "since", " ", "it", " ", 
     RowBox[{"doens", "'"}], "t", " ", "go", " ", "to", " ", "0", " ", "when",
      " ", "r"}], "\[Rule]", "0"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"sHor", "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"r", "-", 
        RowBox[{"2", " ", "M"}]}], ")"}], 
      RowBox[{
       RowBox[{"2", " ", "M", " ", "\[ImaginaryI]", " ", "\[Omega]"}], "-", 
       "1"}]], "\[Times]", "EQ"}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Psi]", "[", "r", "]"}], "->", 
       RowBox[{"\[Phi]Hor", "[", "r", "]"}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Psi]", "'"}], "[", "r", "]"}], "->", 
       RowBox[{
        RowBox[{"\[Phi]Hor", "'"}], "[", "r", "]"}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Psi]", "''"}], "[", "r", "]"}], "->", 
       RowBox[{
        RowBox[{"\[Phi]Hor", "''"}], "[", "r", "]"}]}]}], "}"}]}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.992941974401829*^9, 3.992942046316248*^9}, {
  3.9929422385446377`*^9, 3.9929423513892136`*^9}, {3.992943333095009*^9, 
  3.9929433604940968`*^9}, {3.9935462056811543`*^9, 3.9935462147196198`*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"08249477-4453-bc4d-96b2-56490e9dc2f9"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "r"}], " ", 
       RowBox[{"(", 
        RowBox[{"l", "+", 
         SuperscriptBox["l", "2"], "-", 
         RowBox[{
          SuperscriptBox["r", "2"], " ", 
          SuperscriptBox["\[Omega]", "2"]}]}], ")"}]}], "+", 
      RowBox[{"2", " ", "M", " ", 
       RowBox[{"(", 
        RowBox[{"3", "+", 
         RowBox[{"\[ImaginaryI]", " ", "r", " ", "\[Omega]"}], "+", 
         RowBox[{
          SuperscriptBox["r", "2"], " ", 
          SuperscriptBox["\[Omega]", "2"]}]}], ")"}]}]}], ")"}], " ", 
    RowBox[{"h", "[", "r", "]"}]}], "+", 
   RowBox[{"r", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", " ", 
       RowBox[{"(", 
        RowBox[{"M", "-", 
         RowBox[{
         "2", " ", "\[ImaginaryI]", " ", "M", " ", "r", " ", "\[Omega]"}]}], 
        ")"}], " ", 
       RowBox[{
        SuperscriptBox["h", "\[Prime]",
         MultilineFunction->None], "[", "r", "]"}]}], "+", 
      RowBox[{"r", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "2"}], " ", "M"}], "+", "r"}], ")"}], " ", 
       RowBox[{
        SuperscriptBox["h", "\[Prime]\[Prime]",
         MultilineFunction->None], "[", "r", "]"}]}]}], ")"}]}]}], 
  SuperscriptBox["r", "4"]]], "Output",
 CellChangeTimes->{3.993545599347563*^9, 3.993546054847868*^9, 
  3.9935462156323853`*^9, 3.9935462551965046`*^9, 3.993546300249489*^9, 
