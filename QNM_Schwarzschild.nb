Cell[BoxData[
 RowBox[{
  RowBox[{"FindQNM", "[", 
   RowBox[{"\[Omega]guess_", ",", "theta_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"g", ",", "\[Omega]root"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"g", "[", 
       RowBox[{"x_", "?", "NumericQ"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"IntQNM", "[", 
        RowBox[{"x", ",", "theta", ",", "coefHor", ",", "coefInf"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Omega]root", "=", 
      RowBox[{"x", "/.", 
       RowBox[{
        RowBox[{"FindRoot", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"g", "[", "x", "]"}], "\[Equal]", "0"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "\[Omega]guess"}], "}"}], ",", 
          RowBox[{"AccuracyGoal", "\[Rule]", "6"}], ",", 
          RowBox[{"WorkingPrecision", "\[Rule]", "20"}]}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"Return", "[", 
      RowBox[{"{", 
       RowBox[{"\[Omega]root", ",", 
        RowBox[{"Abs", "[", 
         RowBox[{"g", "[", "\[Omega]root", "]"}], "]"}]}], "}"}], "]"}], 
     ";"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
