        RowBox[{
         RowBox[{"NDSolve", "[", 
          RowBox[{
           RowBox[{"Union", "[", 
            RowBox[{"EQs", ",", "BCs"}], "]"}], ",", "\[Xi]", ",", 
           RowBox[{"{", 
            RowBox[{"r", ",", "rHor", ",", "rm"}], "}"}], ",", "rules"}], 
          "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Solution", " ", "integration", " ", "from", " ", "infinity"}],
        " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"ordInf", "=", 
       RowBox[{"Length", "[", "coefInf", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"\[Xi]Inf", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"\[ImaginaryI]", " ", "\[Omega]", " ", 
           RowBox[{"rs", "[", "r", "]"}]}], "]"}], 
         RowBox[{"Sum", "[", 
          RowBox[{
           FractionBox[
            RowBox[{"gInf", "[", "i", "]"}], 
            SuperscriptBox["r", "i"]], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "0", ",", "ordInf"}], "}"}]}], "]"}]}], "//.", 
        RowBox[{"Union", "[", 
         RowBox[{"param", ",", "coefInf"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"BCs", "=", 
       RowBox[{"SetPrecision", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"\[Xi]", "[", "rInf", "]"}], "\[Equal]", "\[Xi]Inf"}], "/.", 
            RowBox[{"r", "->", "rInf"}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"\[Xi]", "'"}], "[", "rInf", "]"}], "==", 
             RowBox[{"D", "[", 
              RowBox[{"\[Xi]Inf", ",", "r"}], "]"}]}], "/.", 
            RowBox[{"r", "->", "rInf"}]}]}], "}"}], ",", "prec"}], "]"}]}], ";",
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"\[Psi]Inf", "=", 
       RowBox[{
        RowBox[{"\[Xi]", "[", "r", "]"}], "/.", 
        RowBox[{
         RowBox[{"NDSolve", "[", 
          RowBox[{
           RowBox[{"Union", "[", 
            RowBox[{"EQs", ",", "BCs"}], "]"}], ",", "\[Xi]", ",", 
           RowBox[{"{", 
            RowBox[{"r", ",", "rInf", ",", "rm"}], "}"}], ",", "rules"}], 
          "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Linear", " ", "combination"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"b", "=", 
       RowBox[{
        FractionBox["\[Psi]Hor", "\[Psi]Inf"], "/.", 
        RowBox[{"r", "\[Rule]", "rm"}]}]}], ";", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "we", " ", "fix", " ", "the", " ", "coefficients", " ", "of", " ", 
         "the", " ", "linear", " ", "combination", " ", "in", " ", "order", " ",
          "for", " ", "\[Psi]n", " ", "to", " ", "be", " ", "continuous", " ",
          "at", " ", "r"}], "=", "rm"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"\[Psi]n", "=", 
         RowBox[{"Piecewise", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"\[Psi]Hor", ",", 
              RowBox[{"r", "<", "rm"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"b", "\[Times]", "\[Psi]Inf"}], ",", 
              RowBox[{"r", "\[GreaterEqual]", "rm"}]}], "}"}]}], "}"}], 
          "]"}]}], ";"}], " ", "*)"}], "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"\[CapitalDelta]\[Psi]p", "=", 
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{"\[Psi]Hor", ",", "r"}], "]"}], "-", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"b", " ", "\[Psi]Inf"}], ",", "r"}], "]"}]}], 
         RowBox[{"D", "[", 
          RowBox[{"\[Psi]Hor", ",", "r"}], "]"}]], "/.", 
        RowBox[{"r", "\[Rule]", "rm"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"{", "\[CapitalDelta]\[Psi]p", "}"}]}]}], "\[IndentingNewLine]",
     "]"}]}]}]], "Input",
