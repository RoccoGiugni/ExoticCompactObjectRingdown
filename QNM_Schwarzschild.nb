   "\[VeryThinSpace]", "-", 
   RowBox[{
    RowBox[{"0.0889623156889357`", " ", "\[ImaginaryI]"}], 
    "\[InvisibleSpace]", "\<\"\\nInitial guess: \\!\\(\\*SubscriptBox[\\(\
\[Omega]\\), \\(guess\\)]\\) = \"\>", "\[InvisibleSpace]", 
    RowBox[{
     FractionBox["2", "5"], "-", 
     FractionBox["\[ImaginaryI]", "10"]}]}]}],
  SequenceForm[
  "For a Schwarzschild BH: \!\(\*SubscriptBox[\(\[Omega]\), \(0\)]\) = ", 
