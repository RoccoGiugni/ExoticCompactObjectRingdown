Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Integrator", " ", "V2"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"IntQNM", "[", 
    RowBox[{"\[Omega]0_", ",", "value_", ",", "coefHor_", ",", "coefInf_"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "rules", ",", "param", ",", "rHor", ",", "rm", ",", "rInf", ",", 
       "\[Xi]", ",", "\[Xi]Hor", ",", "\[Xi]Inf", ",", "EQs", ",", "BCs", ",",
        "ordHor", ",", "ordInf"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rules", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"AccuracyGoal", "\[Rule]", "12"}], ",", 
         RowBox[{"PrecisionGoal", "\[Rule]", "12"}], ",", 
         RowBox[{"WorkingPrecision", "->", "MachinePrecision"}]}], "}"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"param", "=", 
       RowBox[{"Union", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"M", "->", "1"}], ",", 
           RowBox[{"\[Omega]", "->", "\[Omega]0"}], ",", 
           RowBox[{
            RowBox[{"hHor", "[", "0", "]"}], "->", "1"}], ",", 
           RowBox[{
            RowBox[{"gInf", "[", "0", "]"}], "->", "1"}]}], "}"}], ",", 
         RowBox[{"Thread", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"l", ",", "eps", ",", "match", ",", "inf"}], "}"}], "->", 
           "value"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"rHor", "=", 
       RowBox[{
        RowBox[{"2", "M", 
         RowBox[{"(", 
          RowBox[{"1", "+", "eps"}], ")"}]}], "/.", "param"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rm", "=", 
       RowBox[{
        RowBox[{"match", "\[Times]", "M"}], "/.", "param"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rInf", "=", 
       RowBox[{
        RowBox[{"inf", "\[Times]", "M"}], "/.", "param"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"EQs", "=", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"EQ", "==", "0"}], "}"}], "//.", 
        RowBox[{"Union", "[", 
         RowBox[{"param", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"\[Psi]", "[", "r", "]"}], "->", 
             RowBox[{"\[Xi]", "[", "r", "]"}]}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"\[Psi]", "'"}], "[", "r", "]"}], "->", 
             RowBox[{
              RowBox[{"\[Xi]", "'"}], "[", "r", "]"}]}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"\[Psi]", "''"}], "[", "r", "]"}], "->", 
             RowBox[{
              RowBox[{"\[Xi]", "''"}], "[", "r", "]"}]}]}], "}"}]}], 
         "]"}]}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Solution", " ", "integrating", " ", "from", " ", "the", " ", 
        "horizon"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"ordHor", "=", 
       RowBox[{"Length", "[", "coefHor", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"\[Xi]Hor", "=", 
       RowBox[{
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"r", "-", 
            RowBox[{"2", " ", "M"}]}], ")"}], 
          RowBox[{
           RowBox[{"-", "2"}], " ", "M", " ", "\[ImaginaryI]", " ", 
           "\[Omega]"}]], 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"hHor", "[", "i", "]"}], 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"r", "-", 
               RowBox[{"2", " ", "M"}]}], ")"}], "i"]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "0", ",", "ordHor"}], "}"}]}], "]"}]}], "//.", 
        RowBox[{"Union", "[", 
         RowBox[{"param", ",", "coefHor"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"BCs", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Xi]", "[", "rHor", "]"}], "\[Equal]", "\[Xi]Hor"}], "/.", 
          RowBox[{"r", "\[Rule]", "rHor"}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"\[Xi]", "'"}], "[", "rHor", "]"}], "\[Equal]", 
           RowBox[{"D", "[", 
            RowBox[{"\[Xi]Hor", ",", "r"}], "]"}]}], "/.", 
          RowBox[{"r", "\[Rule]", "rHor"}]}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"solHor", "=", 
       RowBox[{"NDSolve", "[", 
        RowBox[{
         RowBox[{"Union", "[", 
          RowBox[{"EQs", ",", "BCs"}], "]"}], ",", "\[Xi]", ",", 
         RowBox[{"{", 
          RowBox[{"r", ",", "rHor", ",", "rm"}], "}"}], ",", "rules"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"\[Psi]Hor", "=", 
       RowBox[{
        RowBox[{"\[Xi]", "[", "r", "]"}], "/.", 
        RowBox[{"solHor", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Solution", " ", "integration", " ", "from", " ", "infinity"}],
        " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"ordInf", "=", 
       RowBox[{"Length", "[", "coefInf", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"\[Xi]Inf", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"\[ImaginaryI]", " ", "\[Omega]", " ", 
           RowBox[{"rs", "[", "r", "]"}]}], "]"}], 
         RowBox[{"Sum", "[", 
          RowBox[{
           FractionBox[
            RowBox[{"gInf", "[", "i", "]"}], 
            SuperscriptBox["r", "i"]], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "0", ",", "ordInf"}], "}"}]}], "]"}]}], "//.", 
        RowBox[{"Union", "[", 
         RowBox[{"param", ",", "coefInf"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"BCs", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Xi]", "[", "rInf", "]"}], "\[Equal]", "\[Xi]Inf"}], "/.", 
          RowBox[{"r", "\[Rule]", "rInf"}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"\[Xi]", "'"}], "[", "rInf", "]"}], "\[Equal]", 
           RowBox[{"D", "[", 
            RowBox[{"\[Xi]Inf", ",", "r"}], "]"}]}], "/.", 
          RowBox[{"r", "\[Rule]", "rInf"}]}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"solInf", "=", 
       RowBox[{"NDSolve", "[", 
        RowBox[{
         RowBox[{"Union", "[", 
          RowBox[{"EQs", ",", "BCs"}], "]"}], ",", "\[Xi]", ",", 
         RowBox[{"{", 
          RowBox[{"r", ",", "rInf", ",", "rm"}], "}"}], ",", "rules"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"\[Psi]Inf", "=", 
       RowBox[{
        RowBox[{"\[Xi]", "[", "r", "]"}], "/.", 
        RowBox[{"solInf", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Linear", " ", "combination"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"b", "=", 
       RowBox[{
        FractionBox["\[Psi]Hor", "\[Psi]Inf"], "/.", 
        RowBox[{"r", "\[Rule]", "rm"}]}]}], ";", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "we", " ", "fix", " ", "the", " ", "coefficients", " ", "of", " ", 
         "the", " ", "linear", " ", "combination", " ", "in", " ", "order", " ",
          "for", " ", "\[Psi]n", " ", "to", " ", "be", " ", "continuous", " ",
          "at", " ", "r"}], "=", "rm"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"\[Psi]n", "=", 
       RowBox[{"Piecewise", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[Psi]Hor", ",", 
            RowBox[{"r", "<", "rm"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"b", "\[Times]", "\[Psi]Inf"}], ",", 
            RowBox[{"r", "\[GreaterEqual]", "rm"}]}], "}"}]}], "}"}], "]"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"\[CapitalDelta]\[Psi]p", "=", 
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{"\[Psi]Hor", ",", "r"}], "]"}], "-", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"b", " ", "\[Psi]Inf"}], ",", "r"}], "]"}]}], 
         RowBox[{"D", "[", 
          RowBox[{"\[Psi]Hor", ",", "r"}], "]"}]], "/.", 
        RowBox[{"r", "\[Rule]", "rm"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"{", "\[CapitalDelta]\[Psi]p", "}"}]}]}], "\[IndentingNewLine]",
     "]"}]}]}]], "Input",
