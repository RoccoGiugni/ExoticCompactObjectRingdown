Cell[CellGroupData[{

Cell["QNM finder", "Subsection",
 CellChangeTimes->{{3.992943434254656*^9, 
  3.9929434453448944`*^9}},ExpressionUUID->"8de2f391-6704-1949-bdd5-\
c8b858ce5600"],

Cell["\<\
We adopt a direct integration method.
First, the master equation is integrated from the horizon and infinity using \
the limits computed above as boundary conditions. Then, the two results are \
\[OpenCurlyQuote]attached together\[CloseCurlyQuote] at a match point \
sufficiently far from both the horizon and infinity.
The QNM is estimated as the value smoothing the final result, i.e. giving a \
continuous first derivative at the match point. This can be achieved finding \
the root of a function that compute the difference of the first derivatives \
of the two results.\
\>", "Text",
 CellChangeTimes->{{3.9929443003446407`*^9, 3.992944310986555*^9}, {
  3.9929443486826344`*^9, 3.992944352907881*^9}, {3.9929444022599335`*^9, 
  3.9929446186594315`*^9}, {3.9929446634267178`*^9, 3.992944729824745*^9}, {
  3.992944844835047*^9, 3.992945129286682*^9}, {3.992945160599123*^9, 
  3.9929451830699787`*^9}},ExpressionUUID->"96400635-1d7b-cc44-9412-\
acffecb15507"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"coefHor", "=", 
   RowBox[{"Import", "[", "\"\<SeriesCoef/CoefHor_Schw_10.m\>\"", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"coefInf", "=", 
   RowBox[{"Import", "[", "\"\<SeriesCoef/CoefInf_Schw_10.m\>\"", "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.99294557763043*^9, 3.9929456218850365`*^9}, {
   3.9929456527577724`*^9, 3.992945741461546*^9}, 3.993550037860237*^9, {
   4.0026851153824863`*^9, 4.0026851196865788`*^9}, {4.002689750546461*^9, 
   4.0026898085861015`*^9}, {4.0026952732944393`*^9, 4.002695278483862*^9}, {
   4.0027017276010056`*^9, 4.0027017323824844`*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"aa82ca94-ad01-624a-bcf1-5b857befa808"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Integrator", " ", "V2", ".5"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"IntQNM", "[", 
    RowBox[{"\[Omega]0_", ",", "theta_", ",", "coefHor_", ",", "coefInf_"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "rules", ",", "param", ",", "prec", ",", "rHor", ",", "rm", ",", "rInf",
        ",", "\[Xi]", ",", "\[Xi]Hor", ",", "\[Xi]Inf", ",", "EQs", ",", 
       "BCs", ",", "ordHor", ",", "ordInf"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rules", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"AccuracyGoal", "\[Rule]", "12"}], ",", 
         RowBox[{"PrecisionGoal", "\[Rule]", "12"}], ",", 
         RowBox[{"WorkingPrecision", "->", "20"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"param", "=", 
       RowBox[{"Union", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"M", "->", "1"}], ",", 
           RowBox[{"\[Omega]", "->", "\[Omega]0"}], ",", 
           RowBox[{
            RowBox[{"hHor", "[", "0", "]"}], "->", "1"}], ",", 
           RowBox[{
            RowBox[{"gInf", "[", "0", "]"}], "->", "1"}]}], "}"}], ",", 
         RowBox[{"Thread", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"l", ",", "eps", ",", "match", ",", "inf"}], "}"}], "->", 
           "theta"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"prec", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"20", ",", 
         RowBox[{"Precision", "[", "param", "]"}]}], "]"}]}], ";", 
      RowBox[{"param", "=", 
       RowBox[{"SetPrecision", "[", 
        RowBox[{"param", ",", "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"rHor", "=", 
       RowBox[{
        RowBox[{"2", "M", 
         RowBox[{"(", 
          RowBox[{"1", "+", "eps"}], ")"}]}], "/.", "param"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rm", "=", 
       RowBox[{
        RowBox[{"match", "\[Times]", "M"}], "/.", "param"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rInf", "=", 
       RowBox[{
        RowBox[{"inf", "\[Times]", "M"}], "/.", "param"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"EQs", "=", 
       RowBox[{"SetPrecision", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"EQ", "==", "0"}], "}"}], "//.", 
          RowBox[{"Union", "[", 
           RowBox[{"param", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"\[Psi]", "[", "r", "]"}], "->", 
               RowBox[{"\[Xi]", "[", "r", "]"}]}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"\[Psi]", "'"}], "[", "r", "]"}], "->", 
               RowBox[{
                RowBox[{"\[Xi]", "'"}], "[", "r", "]"}]}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"\[Psi]", "''"}], "[", "r", "]"}], "->", 
               RowBox[{
                RowBox[{"\[Xi]", "''"}], "[", "r", "]"}]}]}], "}"}]}], 
           "]"}]}], ",", "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Solution", " ", "integrating", " ", "from", " ", "the", " ", 
        "horizon"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"ordHor", "=", 
       RowBox[{"Length", "[", "coefHor", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"\[Xi]Hor", "=", 
       RowBox[{
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"r", "-", 
            RowBox[{"2", " ", "M"}]}], ")"}], 
          RowBox[{
           RowBox[{"-", "2"}], " ", "M", " ", "\[ImaginaryI]", " ", 
           "\[Omega]"}]], 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"hHor", "[", "i", "]"}], 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"r", "-", 
               RowBox[{"2", " ", "M"}]}], ")"}], "i"]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "0", ",", "ordHor"}], "}"}]}], "]"}]}], "//.", 
        RowBox[{"Union", "[", 
         RowBox[{"param", ",", "coefHor"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"BCs", "=", 
       RowBox[{"SetPrecision", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"\[Xi]", "[", "rHor", "]"}], "\[Equal]", "\[Xi]Hor"}], "/.", 
            RowBox[{"r", "->", "rHor"}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"\[Xi]", "'"}], "[", "rHor", "]"}], "\[Equal]", 
             RowBox[{"D", "[", 
              RowBox[{"\[Xi]Hor", ",", "r"}], "]"}]}], "/.", 
            RowBox[{"r", "->", "rHor"}]}]}], "}"}], ",", "prec"}], "]"}]}], ";",
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"\[Psi]Hor", "=", 
       RowBox[{
        RowBox[{"\[Xi]", "[", "r", "]"}], "/.", 
        RowBox[{
         RowBox[{"NDSolve", "[", 
          RowBox[{
           RowBox[{"Union", "[", 
            RowBox[{"EQs", ",", "BCs"}], "]"}], ",", "\[Xi]", ",", 
           RowBox[{"{", 
            RowBox[{"r", ",", "rHor", ",", "rm"}], "}"}], ",", "rules"}], 
          "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Solution", " ", "integration", " ", "from", " ", "infinity"}],
        " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"ordInf", "=", 
       RowBox[{"Length", "[", "coefInf", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"\[Xi]Inf", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"\[ImaginaryI]", " ", "\[Omega]", " ", 
           RowBox[{"rs", "[", "r", "]"}]}], "]"}], 
         RowBox[{"Sum", "[", 
          RowBox[{
           FractionBox[
