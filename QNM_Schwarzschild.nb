Cell[CellGroupData[{

Cell["Expansion at infinity", "Subsection",
 CellChangeTimes->{{3.9929425154364414`*^9, 
  3.9929425274201336`*^9}},ExpressionUUID->"90d2d069-6959-8d49-8569-\
887de7717ec8"],

Cell[TextData[{
 "The goal of this Section is to compute an approximate solution at infinity.\
\nAt infinity only outgoing waves exist:\n\t\[Psi] \[Tilde] ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", 
    RowBox[{"\[ImaginaryI]\[Omega]", " ", 
     SubscriptBox["r", "*"]}]], TraditionalForm]],ExpressionUUID->
  "dd522c6d-7a1c-d548-9927-aca02dd9c150"],
 "\nWe multiply for a function of ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],ExpressionUUID->
  "8446e7bf-da46-e142-ad9f-4d26e95aac1b"],
 " and expand it as series of powers around infinity:\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Psi]", "\[Tilde]", 
    RowBox[{
     SuperscriptBox["e", 
      RowBox[{"\[ImaginaryI]\[Omega]", " ", 
       SubscriptBox["r", "*"]}]], 
     RowBox[{"g", "(", "r", ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "4d5a0d5d-a3b5-4e4f-802d-d9a919171ea8"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"g", "(", "r", ")"}], "=", " ", 
    RowBox[{"\[Sum]", " ", 
     RowBox[{
      SubscriptBox["g", "n"], 
      SuperscriptBox["r", 
       RowBox[{"-", "n"}]]}]}]}], TraditionalForm]],ExpressionUUID->
  "c14e18b9-59f4-ef4b-992a-cfc48e1b987c"],
 "\nThen, we substitute in the master equation and solve for the coefficients \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", "n"], TraditionalForm]],ExpressionUUID->
  "485cb901-fe6b-224a-969e-2cdece6c64db"],
 "."
}], "Text",
 CellChangeTimes->{{3.992942825164604*^9, 3.9929429256742306`*^9}, {
  3.9929429616858215`*^9, 3.992943140617382*^9}, {4.0029644552973194`*^9, 
  4.0029644837576103`*^9}},ExpressionUUID->"ee6ce17b-c56f-6b43-bf5e-\
db6fb9cfc86d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Phi]Inf", "[", "r_", "]"}], ":=", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{"\[ImaginaryI]", " ", "\[Omega]", " ", 
      RowBox[{"z", "[", "r", "]"}]}], "]"}], 
    RowBox[{"g", "[", "r", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"s", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"EQ", "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Psi]", "[", "r", "]"}], "->", 
        RowBox[{"\[Phi]Inf", "[", "r", "]"}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Psi]", "'"}], "[", "r", "]"}], "->", 
        RowBox[{
         RowBox[{"\[Phi]Inf", "'"}], "[", "r", "]"}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Psi]", "''"}], "[", "r", "]"}], "->", 
        RowBox[{
         RowBox[{"\[Phi]Inf", "''"}], "[", "r", "]"}]}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"sInf", "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Omega]", " ", 
       RowBox[{"z", "[", "r", "]"}]}], "]"}], "\[Times]", " ", "s"}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"z", "[", "r", "]"}], "->", 
       RowBox[{"rs", "[", "r", "]"}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"z", "'"}], "[", "r", "]"}], "->", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"rs", "[", "r", "]"}], ",", "r"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"z", "''"}], "[", "r", "]"}], "->", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"rs", "[", "r", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"r", ",", "2"}], "}"}]}], "]"}]}]}], "}"}]}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.992943310146513*^9, 3.992943319824991*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"86e7da5c-cefa-5940-a54c-e0cf50426cba"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"2", " ", "M"}], "-", "r"}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "6"}], " ", "M"}], "+", 
        RowBox[{"l", " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", "l"}], ")"}], " ", "r"}]}], ")"}], " ", 
      RowBox[{"g", "[", "r", "]"}]}], "+", 
     RowBox[{"r", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "2"}], " ", 
         RowBox[{"(", 
          RowBox[{"M", "+", 
           RowBox[{"\[ImaginaryI]", " ", 
            SuperscriptBox["r", "2"], " ", "\[Omega]"}]}], ")"}], " ", 
         RowBox[{
          SuperscriptBox["g", "\[Prime]",
           MultilineFunction->None], "[", "r", "]"}]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", " ", "M"}], "-", "r"}], ")"}], " ", "r", " ", 
         RowBox[{
          SuperscriptBox["g", "\[Prime]\[Prime]",
           MultilineFunction->None], "[", "r", "]"}]}]}], ")"}]}]}], ")"}]}], 
  SuperscriptBox["r", "4"]]], "Output",
 CellChangeTimes->{3.9935456067372475`*^9, 3.9935464166403637`*^9, 
  3.993550535865841*^9, 3.993551528346201*^9, 3.993615556744814*^9, 
  4.002685041192419*^9},
 CellLabel->"Out[16]=",ExpressionUUID->"acd2813d-1089-e241-923d-b04bdb180c40"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Series", " ", "coefficients"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"CoefInf", "[", "ord_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"G", ",", "EQ", ",", "s"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"G", "[", "r_", "]"}], ":=", 
       RowBox[{"Sum", "[", 
        RowBox[{
         FractionBox[
          RowBox[{"gInf", "[", "i", "]"}], 
          SuperscriptBox["r", "i"]], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", 
           RowBox[{"ord", "+", "5"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"EQ", "=", 
       RowBox[{"sInf", "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"g", "[", "r", "]"}], "->", 
           RowBox[{"G", "[", "r", "]"}]}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"g", "'"}], "[", "r", "]"}], "->", 
           RowBox[{
            RowBox[{"G", "'"}], "[", "r", "]"}]}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"g", "''"}], "[", "r", "]"}], "->", 
           RowBox[{
            RowBox[{"G", "''"}], "[", "r", "]"}]}]}], "}"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"s", "=", 
       RowBox[{"Simplify", "[", 
        RowBox[{"Series", "[", 
         RowBox[{"EQ", ",", 
          RowBox[{"{", 
           RowBox[{"r", ",", "\[Infinity]", ",", "ord"}], "}"}]}], "]"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Solve", " ", "the", " ", "system"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Simplify", "[", 
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"SeriesCoefficient", "[", 
             RowBox[{"s", ",", "i"}], "]"}], "==", "0"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "2", ",", "ord"}], "}"}]}], "]"}], ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"gInf", "[", "i", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", 
             RowBox[{"ord", "-", "1"}]}], "}"}]}], "]"}]}], "]"}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}]}]], "Input",
 CellChangeTimes->{3.992943961255001*^9},
 CellLabel->"In[17]:=",ExpressionUUID->"8853b716-a92c-e240-93f3-08edaf409968"],

Cell[BoxData[{
 RowBox[{
