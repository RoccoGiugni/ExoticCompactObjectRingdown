Cell[CellGroupData[{

Cell["Computing the QNMs", "Section",
 CellChangeTimes->{{3.992945228529789*^9, 
  3.992945240956333*^9}},ExpressionUUID->"da52d708-996d-5842-8bc7-\
f4d2dd242a6b"],

Cell["\<\
Follows the implementation of part of the QNM calculation method.

This Section focuses on the search for approximate solutions at the event \
horizon and at infinity.
Check \[OpenCurlyDoubleQuote]QNM_Compute.nb\[CloseCurlyDoubleQuote] for the \
actual integrator and finder.\
\>", "Text",
 CellChangeTimes->{{4.0029640498406544`*^9, 4.002964088552244*^9}, {
  4.0029641760731144`*^9, 4.002964179662979*^9}, {4.0029642662996216`*^9, 
  4.002964267762886*^9}, {4.0029643529126205`*^9, 4.0029643703779163`*^9}, {
  4.003318204959301*^9, 
  4.0033183278387947`*^9}},ExpressionUUID->"645867e6-5ec1-e34b-9568-\
2bc8084aa9c2"],

Cell[CellGroupData[{

Cell["Set-up", "Subsection",
 CellChangeTimes->{{3.992942356934084*^9, 
  3.992942382524788*^9}},ExpressionUUID->"230ca162-3c5e-6942-b57e-\
00e0136ef9f1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "r_", "]"}], ":=", 
   RowBox[{"1", "-", 
    FractionBox[
     RowBox[{"2", " ", "M"}], "r"]}]}], ";", 
  RowBox[{"VRW", "=", 
   RowBox[{
    RowBox[{"f", "[", "r", "]"}], 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{"l", 
        RowBox[{"(", 
         RowBox[{"l", "+", "1"}], ")"}]}], 
       SuperscriptBox["r", "2"]], "-", 
      FractionBox[
       RowBox[{"6", " ", "M"}], 
       SuperscriptBox["r", "3"]]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rs", "[", "r_", "]"}], ":=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"Integrate", "[", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"f", "[", "r", "]"}]], ",", "r"}], "]"}], ",", 
     RowBox[{"r", ">", "0"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EQRW", "=", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      RowBox[{"f", "[", "r", "]"}], "2"], 
     RowBox[{
      RowBox[{"\[Psi]", "''"}], "[", "r", "]"}]}], "+", 
    RowBox[{
     RowBox[{
      RowBox[{"f", "'"}], "[", "r", "]"}], 
     RowBox[{"f", "[", "r", "]"}], 
     RowBox[{
      RowBox[{"\[Psi]", "'"}], "[", "r", "]"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[Omega]", "2"], "-", "VRW"}], ")"}], 
     RowBox[{"\[Psi]", "[", "r", "]"}]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.992942385204567*^9, 3.9929424551347466`*^9}, {
  3.9929438084339676`*^9, 3.9929438380548687`*^9}, {4.002188026492832*^9, 
  4.002188050837015*^9}, {4.0033174583449993`*^9, 
  4.003317463728775*^9}},ExpressionUUID->"feb2537c-c19d-6a48-a764-\
ea75b49b7da0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Tortoise coordinate \!\(\*SubscriptBox[\(r\), \(*\)]\) = \>\"",
     ",", " ", 
    RowBox[{"rs", "[", "r", "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Regge-Wheeler equation:\\n \>\"", ",", " ", "EQRW", ",", 
    " ", "\"\< = 0\>\""}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{4.0002034005815964`*^9, 4.000203421345724*^9}, {
  4.0002034669326496`*^9, 4.0002035284629307`*^9}, {4.003317465949095*^9, 
  4.0033174660930977`*^9}},ExpressionUUID->"4d3ab1fd-e503-1943-aa60-\
2e3e2544eb68"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Tortoise coordinate \\!\\(\\*SubscriptBox[\\(r\\), \\(*\\)]\\) \
= \"\>", "\[InvisibleSpace]", 
   RowBox[{"r", "+", 
    RowBox[{"2", " ", "M", " ", 
     RowBox[{"Log", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], " ", "M"}], "+", "r"}], "]"}]}]}]}],
  SequenceForm[
  "Tortoise coordinate \!\(\*SubscriptBox[\(r\), \(*\)]\) = ", $CellContext`r + 
   2 $CellContext`M Log[(-2) $CellContext`M + $CellContext`r]],
  Editable->False]], "Print",
 CellChangeTimes->{4.0021880644904785`*^9, 4.002262928074169*^9},
 CellLabel->
  "During evaluation of \
In[5]:=",ExpressionUUID->"62ac34a7-8ff9-854d-a21a-80a29aa5e5bf"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Regge-Wheeler equation:\\n \"\>", "\[InvisibleSpace]", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             FractionBox[
              RowBox[{"6", " ", "M"}], 
              SuperscriptBox["r", "3"]]}], "+", 
            FractionBox[
             RowBox[{"l", " ", 
              RowBox[{"(", 
               RowBox[{"1", "+", "l"}], ")"}]}], 
             SuperscriptBox["r", "2"]]}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            FractionBox[
             RowBox[{"2", " ", "M"}], "r"]}], ")"}]}], ")"}]}], "+", 
       SuperscriptBox["\[Omega]", "2"]}], ")"}], " ", 
     RowBox[{"\[Psi]", "[", "r", "]"}]}], "+", 
    FractionBox[
     RowBox[{"2", " ", "M", " ", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        FractionBox[
         RowBox[{"2", " ", "M"}], "r"]}], ")"}], " ", 
      RowBox[{
       SuperscriptBox["\[Psi]", "\[Prime]",
        MultilineFunction->None], "[", "r", "]"}]}], 
     SuperscriptBox["r", "2"]], "+", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "-", 
        FractionBox[
         RowBox[{"2", " ", "M"}], "r"]}], ")"}], "2"], " ", 
     RowBox[{
      SuperscriptBox["\[Psi]", "\[Prime]\[Prime]",
       MultilineFunction->None], "[", "r", "]"}]}]}], 
   "\[InvisibleSpace]", "\<\" = 0\"\>"}],
  SequenceForm[
  "Regge-Wheeler equation:\n ", (-((-6) $CellContext`M $CellContext`r^(-3) + \
$CellContext`l (1 + $CellContext`l) $CellContext`r^(-2)) (1 - 
       2 $CellContext`M/$CellContext`r) + $CellContext`\[Omega]^2) \
$CellContext`\[Psi][$CellContext`r] + 
   2 $CellContext`M (1 - 2 $CellContext`M/$CellContext`r) $CellContext`r^(-2) 
    Derivative[
     1][$CellContext`\[Psi]][$CellContext`r] + (1 - 
      2 $CellContext`M/$CellContext`r)^2 
    Derivative[2][$CellContext`\[Psi]][$CellContext`r], " = 0"],
  Editable->False]], "Print",
 CellChangeTimes->{4.0021880644904785`*^9, 4.002262928101263*^9},
 CellLabel->
  "During evaluation of \
In[5]:=",ExpressionUUID->"de3f8538-a966-ac43-bbd7-9d4c565cef1c"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Expansion at the horizon", "Subsection",
 CellChangeTimes->{{3.9929406627121983`*^9, 
  3.9929406699501534`*^9}},ExpressionUUID->"f69ef447-5be9-5f4e-ad63-\
ba2c146cfdb2"],

Cell[TextData[{
 "The goal of this Section is to compute an approximate solution near the \
event horizon.\nThe black hole surface is totally absorbing, hence at the \
horizon we require ingoing waves only:\n\t\[Psi] \[Tilde] ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]\[Omega]"}], " ", 
     SubscriptBox["r", "*"]}]], TraditionalForm]],ExpressionUUID->
  "afd59741-2a6d-4d4d-ba76-011c8d1f60c9"],
 "\nwhere ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "*"], TraditionalForm]],ExpressionUUID->
  "faa1edc9-564b-f340-970b-18220af3169c"],
 " is the tortoise coordinate. We multiply for a function of ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],ExpressionUUID->
  "d24880e2-d775-f540-9fd1-01465f82adf0"],
 " and expand it as series of powers around the horizon:\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Psi]", "\[Tilde]", 
     RowBox[{
      SuperscriptBox["e", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]\[Omega]"}], " ", 
        SubscriptBox["r", "*"]}]], 
      RowBox[{"h", "(", "r", ")"}]}]}], " ", "=", " ", 
    RowBox[{
     SuperscriptBox[
      RowBox[{
       SuperscriptBox["e", 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]\[Omega]"}], " ", "r"}]], "(", 
       RowBox[{"r", "-", 
        RowBox[{"2", "M"}]}], ")"}], 
      RowBox[{
       RowBox[{"-", "2"}], "M", " ", "\[ImaginaryI]\[Omega]"}]], 
     RowBox[{"h", "(", "r", ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "6179035a-790e-ec4f-a970-95c37c951ab7"],
 "\tusing the definition of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "*"], TraditionalForm]],ExpressionUUID->
  "4c6ea01a-12e3-414f-bdbe-a2e0f9f5c720"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"h", "(", "r", ")"}], " ", "=", " ", 
    RowBox[{"\[Sum]", 
     SuperscriptBox[
      RowBox[{
       SubscriptBox["h", "n"], "(", 
       RowBox[{"r", "-", 
        RowBox[{"2", "M"}]}], ")"}], "n"]}]}], TraditionalForm]],
  ExpressionUUID->"75d17250-9112-4e4e-886d-15a29c265826"],
 "\nThen, we substitute in the master equation and solve for the coefficients \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["h", "n"], TraditionalForm]],ExpressionUUID->
  "66eaffba-838a-2f46-80bc-c908f4b95627"],
 "."
}], "Text",
 CellChangeTimes->{{3.9929408626048985`*^9, 3.9929409537049065`*^9}, {
   3.992941015640381*^9, 3.9929411123381977`*^9}, {3.992941166304949*^9, 
   3.992941408674917*^9}, {3.9929414655163517`*^9, 3.99294149122591*^9}, {
   3.992941557414856*^9, 3.992941575865017*^9}, {3.9929416170965786`*^9, 
   3.9929419585161247`*^9}, {3.9929421203377476`*^9, 3.992942231143875*^9}, {
   3.992943155154804*^9, 3.992943213678217*^9}, 3.9929432712048187`*^9, {
   4.0029643039517345`*^9, 
   4.0029644472103252`*^9}},ExpressionUUID->"62cf46de-e0b6-484a-901d-\
81991483f9c6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Phi]Hor", "[", "r_", "]"}], ":=", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"r", "-", 
        RowBox[{"2", "M"}]}], ")"}], 
      RowBox[{
       RowBox[{"-", "2"}], " ", "M", " ", "\[ImaginaryI]", " ", "\[Omega]"}]], 
     RowBox[{"h", "[", "r", "]"}]}]}], ";"}], 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "term", " ", 
     SuperscriptBox["e", 
      RowBox[{"-", "\[ImaginaryI]\[Omega]r"}]], " ", "can", " ", "be", " ", 
     "neglected", " ", "since", " ", "it", " ", 
     RowBox[{"doens", "'"}], "t", " ", "go", " ", "to", " ", "0", " ", "when",
      " ", "r"}], "\[Rule]", "0"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"sHor", "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"r", "-", 
        RowBox[{"2", " ", "M"}]}], ")"}], 
      RowBox[{
       RowBox[{"2", " ", "M", " ", "\[ImaginaryI]", " ", "\[Omega]"}], "-", 
       "1"}]], "\[Times]", "EQ"}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Psi]", "[", "r", "]"}], "->", 
       RowBox[{"\[Phi]Hor", "[", "r", "]"}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Psi]", "'"}], "[", "r", "]"}], "->", 
       RowBox[{
        RowBox[{"\[Phi]Hor", "'"}], "[", "r", "]"}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Psi]", "''"}], "[", "r", "]"}], "->", 
       RowBox[{
        RowBox[{"\[Phi]Hor", "''"}], "[", "r", "]"}]}]}], "}"}]}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.992941974401829*^9, 3.992942046316248*^9}, {
  3.9929422385446377`*^9, 3.9929423513892136`*^9}, {3.992943333095009*^9, 
  3.9929433604940968`*^9}, {3.9935462056811543`*^9, 3.9935462147196198`*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"08249477-4453-bc4d-96b2-56490e9dc2f9"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "r"}], " ", 
       RowBox[{"(", 
        RowBox[{"l", "+", 
         SuperscriptBox["l", "2"], "-", 
         RowBox[{
          SuperscriptBox["r", "2"], " ", 
          SuperscriptBox["\[Omega]", "2"]}]}], ")"}]}], "+", 
      RowBox[{"2", " ", "M", " ", 
       RowBox[{"(", 
        RowBox[{"3", "+", 
         RowBox[{"\[ImaginaryI]", " ", "r", " ", "\[Omega]"}], "+", 
         RowBox[{
          SuperscriptBox["r", "2"], " ", 
          SuperscriptBox["\[Omega]", "2"]}]}], ")"}]}]}], ")"}], " ", 
    RowBox[{"h", "[", "r", "]"}]}], "+", 
   RowBox[{"r", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", " ", 
       RowBox[{"(", 
        RowBox[{"M", "-", 
         RowBox[{
         "2", " ", "\[ImaginaryI]", " ", "M", " ", "r", " ", "\[Omega]"}]}], 
        ")"}], " ", 
       RowBox[{
        SuperscriptBox["h", "\[Prime]",
         MultilineFunction->None], "[", "r", "]"}]}], "+", 
      RowBox[{"r", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "2"}], " ", "M"}], "+", "r"}], ")"}], " ", 
       RowBox[{
        SuperscriptBox["h", "\[Prime]\[Prime]",
         MultilineFunction->None], "[", "r", "]"}]}]}], ")"}]}]}], 
  SuperscriptBox["r", "4"]]], "Output",
 CellChangeTimes->{3.993545599347563*^9, 3.993546054847868*^9, 
  3.9935462156323853`*^9, 3.9935462551965046`*^9, 3.993546300249489*^9, 
  3.99354640031406*^9, 3.9935505254141865`*^9, 3.9935515221236153`*^9, 
  3.9936155503324585`*^9, 4.0007863426670055`*^9, 4.0026849780220623`*^9},
 CellLabel->"Out[6]=",ExpressionUUID->"39579103-0826-f046-9722-d97c21cdd44a"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Series", " ", "coefficients"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{"CoefHor", "[", "ord_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"H", ",", "EQ", ",", "s"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"H", "[", "r_", "]"}], ":=", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"hHor", "[", "i", "]"}], 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"r", "-", 
             RowBox[{"2", " ", "M"}]}], ")"}], "i"]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", 
           RowBox[{"ord", "+", "5"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"EQ", "=", 
       RowBox[{"sHor", "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"h", "[", "r", "]"}], "->", 
           RowBox[{"H", "[", "r", "]"}]}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"h", "'"}], "[", "r", "]"}], "->", 
           RowBox[{
            RowBox[{"H", "'"}], "[", "r", "]"}]}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"h", "''"}], "[", "r", "]"}], "->", 
           RowBox[{
            RowBox[{"H", "''"}], "[", "r", "]"}]}]}], "}"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"s", "=", 
       RowBox[{"Simplify", "[", 
        RowBox[{"Series", "[", 
         RowBox[{"EQ", ",", 
          RowBox[{"{", 
           RowBox[{"r", ",", 
            RowBox[{"2", " ", "M"}], ",", "ord"}], "}"}]}], "]"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Solve", " ", "the", " ", "system"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Simplify", "[", 
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"SeriesCoefficient", "[", 
             RowBox[{"s", ",", "i"}], "]"}], "==", "0"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "0", ",", "ord"}], "}"}]}], "]"}], ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"hHor", "[", "i", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", 
             RowBox[{"ord", "+", "1"}]}], "}"}]}], "]"}]}], "]"}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}]}]], "Input",
 CellChangeTimes->{
  3.992943970045059*^9, {4.000786354805828*^9, 4.0007863702872677`*^9}, {
   4.002685320569826*^9, 4.0026853363304768`*^9}},
