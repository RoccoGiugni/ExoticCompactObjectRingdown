Cell[CellGroupData[{

Cell["QNM finder", "Subsection",
 CellChangeTimes->{{3.992943434254656*^9, 
  3.9929434453448944`*^9}},ExpressionUUID->"8de2f391-6704-1949-bdd5-\
c8b858ce5600"],

Cell["\<\
The functions to integrate the Regge-Wheeler equation and to find QNMs are \
implemented in \[OpenCurlyDoubleQuote]QNM_Compute.nb\[CloseCurlyDoubleQuote] \
in a generalized form.
Here follow components specific for Schwarzschild BHs, referring to the \
approximate solutions computed in the previous Sections. 

!! NOTE: when running a computation check out everything necessary has been \
defined. !!\
\>", "Text",
 CellChangeTimes->{{4.003317942318468*^9, 4.0033180079520664`*^9}, {
  4.0033180381355095`*^9, 4.003318180229126*^9}, {4.0033183564773026`*^9, 
  4.0033184802417927`*^9}},ExpressionUUID->"aece4649-3067-bd42-9865-\
6ddb98563075"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"-", " ", 
      RowBox[{"SchwBC", " ", "--"}]}]}], "-"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"coefI", "  ", ":", " ", 
    RowBox[{
    "list", " ", "of", " ", "substitution", " ", "rules", " ", "for", " ", 
     "the", " ", "series", " ", "coefficients", " ", "at", " ", "the", " ", 
     "horizon"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"coefE", "  ", ":", " ", 
    RowBox[{
    "list", " ", "of", " ", "substitution", " ", "rules", " ", "for", " ", 
     "the", " ", "series", " ", "coefficients", " ", "at", " ", 
     "infinity"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"output", " ", ":", " ", 
    RowBox[{
    "list", " ", "of", " ", "two", " ", "boundary", " ", "conditions", " ", 
     RowBox[{"(", 
      RowBox[{"see", " ", 
       RowBox[{"QNM_Compute", ".", "nb"}], " ", "for", " ", "applications"}], 
      ")"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"SchwBC", "[", 
     RowBox[{"coefI_", ",", "coefE_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ordI", ",", "bcI", ",", "ordE", ",", "bcE"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ordI", "=", 
        RowBox[{"Length", "[", "coefI", "]"}]}], ";", 
       RowBox[{"bcI", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Omega]", " ", 
            RowBox[{"rs", "[", "r", "]"}]}], "]"}], 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"hHor", "[", "i", "]"}], 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"r", "-", 
                RowBox[{"2", "M"}]}], ")"}], "i"]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "0", ",", "ordI"}], "}"}]}], "]"}]}], "//.", 
         "coefI"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"ordE", "=", 
        RowBox[{"Length", "[", "coefE", "]"}]}], ";", 
       RowBox[{"bcE", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"\[ImaginaryI]", " ", "\[Omega]", " ", 
            RowBox[{"rs", "[", "r", "]"}]}], "]"}], 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"gInf", "[", "i", "]"}], 
             SuperscriptBox["r", 
              RowBox[{"-", "i"}]]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "0", ",", "ordE"}], "}"}]}], "]"}]}], "//.", 
         "coefE"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"Return", "[", 
        RowBox[{"{", 
         RowBox[{"bcI", ",", "bcE"}], "}"}], "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{4.003317488843458*^9, 
  4.0033176826333694`*^9}},ExpressionUUID->"23301d67-bb6f-1645-badf-\
5534acd1d092"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"coefHor", "=", 
   RowBox[{"Import", "[", "\"\<SeriesCoef/CoefHor_Schw_10.m\>\"", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"coefInf", "=", 
   RowBox[{"Import", "[", "\"\<SeriesCoef/CoefInf_Schw_10.m\>\"", "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.99294557763043*^9, 3.9929456218850365`*^9}, {
   3.9929456527577724`*^9, 3.992945741461546*^9}, 3.993550037860237*^9, {
   4.0026851153824863`*^9, 4.0026851196865788`*^9}, {4.002689750546461*^9, 
   4.0026898085861015`*^9}, {4.0026952732944393`*^9, 4.002695278483862*^9}, {
   4.0027017276010056`*^9, 4.0027017323824844`*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"aa82ca94-ad01-624a-bcf1-5b857befa808"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Past integrators (here for knowledge)", "Subsection",
 CellChangeTimes->{{4.00019922738731*^9, 4.0001992325558395`*^9}, {
  4.003318497412445*^9, 
  4.003318507545723*^9}},ExpressionUUID->"3b0e9a84-e25f-5f4b-ba8c-\
7458ed7e7663"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Integrator", " ", "V2", ".5"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"IntQNM", "[", 
    RowBox[{"\[Omega]0_", ",", "theta_", ",", "coefHor_", ",", "coefInf_"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "rules", ",", "param", ",", "prec", ",", "rHor", ",", "rm", ",", "rInf",
        ",", "\[Xi]", ",", "\[Xi]Hor", ",", "\[Xi]Inf", ",", "EQs", ",", 
       "BCs", ",", "ordHor", ",", "ordInf"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rules", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"AccuracyGoal", "\[Rule]", "12"}], ",", 
         RowBox[{"PrecisionGoal", "\[Rule]", "12"}], ",", 
         RowBox[{"WorkingPrecision", "->", "20"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"param", "=", 
       RowBox[{"Union", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"M", "->", "1"}], ",", 
           RowBox[{"\[Omega]", "->", "\[Omega]0"}], ",", 
           RowBox[{
            RowBox[{"hHor", "[", "0", "]"}], "->", "1"}], ",", 
           RowBox[{
            RowBox[{"gInf", "[", "0", "]"}], "->", "1"}]}], "}"}], ",", 
         RowBox[{"Thread", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"l", ",", "eps", ",", "match", ",", "inf"}], "}"}], "->", 
           "theta"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"prec", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"20", ",", 
         RowBox[{"Precision", "[", "param", "]"}]}], "]"}]}], ";", 
      RowBox[{"param", "=", 
       RowBox[{"SetPrecision", "[", 
        RowBox[{"param", ",", "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"rHor", "=", 
       RowBox[{
        RowBox[{"2", "M", 
         RowBox[{"(", 
          RowBox[{"1", "+", "eps"}], ")"}]}], "/.", "param"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rm", "=", 
       RowBox[{
        RowBox[{"match", "\[Times]", "M"}], "/.", "param"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rInf", "=", 
       RowBox[{
        RowBox[{"inf", "\[Times]", "M"}], "/.", "param"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"EQs", "=", 
       RowBox[{"SetPrecision", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"EQ", "==", "0"}], "}"}], "//.", 
          RowBox[{"Union", "[", 
           RowBox[{"param", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"\[Psi]", "[", "r", "]"}], "->", 
               RowBox[{"\[Xi]", "[", "r", "]"}]}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"\[Psi]", "'"}], "[", "r", "]"}], "->", 
               RowBox[{
                RowBox[{"\[Xi]", "'"}], "[", "r", "]"}]}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"\[Psi]", "''"}], "[", "r", "]"}], "->", 
               RowBox[{
                RowBox[{"\[Xi]", "''"}], "[", "r", "]"}]}]}], "}"}]}], 
           "]"}]}], ",", "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Solution", " ", "integrating", " ", "from", " ", "the", " ", 
        "horizon"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"ordHor", "=", 
       RowBox[{"Length", "[", "coefHor", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"\[Xi]Hor", "=", 
       RowBox[{
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"r", "-", 
            RowBox[{"2", " ", "M"}]}], ")"}], 
          RowBox[{
           RowBox[{"-", "2"}], " ", "M", " ", "\[ImaginaryI]", " ", 
           "\[Omega]"}]], 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"hHor", "[", "i", "]"}], 
