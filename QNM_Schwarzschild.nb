Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "xs", " ", "are", " ", "supposed", " ", "to", " ", "be", " ", "the", " ", 
    "first", " ", "n", " ", "element", " ", "of", " ", "each", " ", "data", " ",
     "point"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"MultiPlot", "[", 
     RowBox[{"data_", ",", "iy_", ",", "n_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"plots", ",", "l", ",", "s", ",", "point"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"plots", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"l", "=", 
           RowBox[{"Extract", "[", 
            RowBox[{"label", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", "ix", "}"}], ",", 
               RowBox[{"{", "iy", "}"}]}], "}"}]}], "]"}]}], ";", 
          RowBox[{"s", "=", 
           RowBox[{"Extract", "[", 
            RowBox[{"scale", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", "ix", "}"}], ",", 
               RowBox[{"{", "iy", "}"}]}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"point", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Extract", "[", 
              RowBox[{"j", ",", 
               RowBox[{"{", 
                RowBox[{";;", ",", 
                 RowBox[{"{", 
                  RowBox[{"ix", ",", "iy"}], "}"}]}], "}"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "data"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"plots", ",", 
            RowBox[{"ListPlot", "[", 
             RowBox[{"point", ",", 
              RowBox[{"AxesLabel", "->", "l"}], ",", 
              RowBox[{"ScalingFunctions", "->", "s"}], ",", 
              RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"ix", ",", "n"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "plots", "]"}], ";"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}]}]], "Input",
