Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Tortoise coordinate \\!\\(\\*SubscriptBox[\\(r\\), \\(*\\)]\\) \
= \"\>", "\[InvisibleSpace]", 
   RowBox[{"r", "+", 
    RowBox[{"2", " ", "M", " ", 
     RowBox[{"Log", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], " ", "M"}], "+", "r"}], "]"}]}]}]}],
  SequenceForm[
  "Tortoise coordinate \!\(\*SubscriptBox[\(r\), \(*\)]\) = ", $CellContext`r + 
   2 $CellContext`M Log[(-2) $CellContext`M + $CellContext`r]],
  Editable->False]], "Print",
 CellChangeTimes->{4.0021880644904785`*^9, 4.002262928074169*^9},
 CellLabel->
  "During evaluation of \
In[5]:=",ExpressionUUID->"62ac34a7-8ff9-854d-a21a-80a29aa5e5bf"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Regge-Wheeler equation:\\n \"\>", "\[InvisibleSpace]", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             FractionBox[
              RowBox[{"6", " ", "M"}], 
              SuperscriptBox["r", "3"]]}], "+", 
            FractionBox[
             RowBox[{"l", " ", 
              RowBox[{"(", 
               RowBox[{"1", "+", "l"}], ")"}]}], 
             SuperscriptBox["r", "2"]]}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            FractionBox[
             RowBox[{"2", " ", "M"}], "r"]}], ")"}]}], ")"}]}], "+", 
       SuperscriptBox["\[Omega]", "2"]}], ")"}], " ", 
     RowBox[{"\[Psi]", "[", "r", "]"}]}], "+", 
    FractionBox[
     RowBox[{"2", " ", "M", " ", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        FractionBox[
         RowBox[{"2", " ", "M"}], "r"]}], ")"}], " ", 
      RowBox[{
       SuperscriptBox["\[Psi]", "\[Prime]",
        MultilineFunction->None], "[", "r", "]"}]}], 
     SuperscriptBox["r", "2"]], "+", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "-", 
        FractionBox[
         RowBox[{"2", " ", "M"}], "r"]}], ")"}], "2"], " ", 
     RowBox[{
      SuperscriptBox["\[Psi]", "\[Prime]\[Prime]",
       MultilineFunction->None], "[", "r", "]"}]}]}], 
   "\[InvisibleSpace]", "\<\" = 0\"\>"}],
  SequenceForm[
  "Regge-Wheeler equation:\n ", (-((-6) $CellContext`M $CellContext`r^(-3) + \
$CellContext`l (1 + $CellContext`l) $CellContext`r^(-2)) (1 - 
       2 $CellContext`M/$CellContext`r) + $CellContext`\[Omega]^2) \
$CellContext`\[Psi][$CellContext`r] + 
   2 $CellContext`M (1 - 2 $CellContext`M/$CellContext`r) $CellContext`r^(-2) 
    Derivative[
     1][$CellContext`\[Psi]][$CellContext`r] + (1 - 
      2 $CellContext`M/$CellContext`r)^2 
    Derivative[2][$CellContext`\[Psi]][$CellContext`r], " = 0"],
  Editable->False]], "Print",
 CellChangeTimes->{4.0021880644904785`*^9, 4.002262928101263*^9},
 CellLabel->
  "During evaluation of \
In[5]:=",ExpressionUUID->"de3f8538-a966-ac43-bbd7-9d4c565cef1c"]
}, Open  ]]
}, Open  ]]
