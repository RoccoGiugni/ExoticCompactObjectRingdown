Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "3"}], "+", "l", "+", 
           SuperscriptBox["l", "2"], "-", 
           RowBox[{"2", " ", "\[ImaginaryI]", " ", "M", " ", "\[Omega]"}], "-", 
           RowBox[{"8", " ", 
            SuperscriptBox["M", "2"], " ", 
            SuperscriptBox["\[Omega]", "2"]}]}], ")"}], " ", 
         RowBox[{"hHor", "[", "0", "]"}]}], ")"}]}], "+", 
      RowBox[{"2", " ", "M", " ", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"4", " ", "\[ImaginaryI]", " ", "M", " ", "\[Omega]"}]}], 
        ")"}], " ", 
       RowBox[{"hHor", "[", "1", "]"}]}]}], 
     RowBox[{"8", " ", 
      SuperscriptBox["M", "3"]}]], "\[Equal]", "0"}], ",", 
   RowBox[{
    FractionBox[
     RowBox[{
      RowBox[{"3", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "4"}], "+", "l", "+", 
         SuperscriptBox["l", "2"], "-", 
         RowBox[{"2", " ", "\[ImaginaryI]", " ", "M", " ", "\[Omega]"}], "-", 
         RowBox[{"4", " ", 
          SuperscriptBox["M", "2"], " ", 
          SuperscriptBox["\[Omega]", "2"]}]}], ")"}], " ", 
       RowBox[{"hHor", "[", "0", "]"}]}], "-", 
      RowBox[{"2", " ", "M", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"l", " ", 
          RowBox[{"hHor", "[", "1", "]"}]}], "+", 
         RowBox[{
          SuperscriptBox["l", "2"], " ", 
          RowBox[{"hHor", "[", "1", "]"}]}], "-", 
         RowBox[{"2", " ", "M", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"5", " ", "\[ImaginaryI]", " ", "\[Omega]", " ", 
             RowBox[{"hHor", "[", "1", "]"}]}], "+", 
            RowBox[{"4", " ", "M", " ", 
             SuperscriptBox["\[Omega]", "2"], " ", 
             RowBox[{"hHor", "[", "1", "]"}]}], "+", 
            RowBox[{"4", " ", 
             RowBox[{"hHor", "[", "2", "]"}]}], "-", 
            RowBox[{"8", " ", "\[ImaginaryI]", " ", "M", " ", "\[Omega]", " ", 
             RowBox[{"hHor", "[", "2", "]"}]}]}], ")"}]}]}], ")"}]}]}], 
     RowBox[{"16", " ", 
      SuperscriptBox["M", "4"]}]], "\[Equal]", "0"}]}], "}"}]], "Output",
 CellChangeTimes->{{4.000786396854471*^9, 4.000786427715355*^9}},
 CellLabel->"Out[19]=",ExpressionUUID->"68e9e2e8-5304-4d46-875f-ea664b07461d"]
}, Open  ]],

