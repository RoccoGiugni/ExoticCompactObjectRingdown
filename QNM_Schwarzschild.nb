Cell[CellGroupData[{

Cell["Numerical Stability", "Section",
 CellFrame->{{0, 0}, {0, 1}},
 CellChangeTimes->{{3.992945301247753*^9, 
  3.992945308933895*^9}},ExpressionUUID->"e3690fe3-377c-3f44-abf3-\
64432e95ec90"],

Cell["\<\
In this Section the QNM finder is tested against different sets of its \
hyperparameters. The latter are the \[OpenCurlyQuote]integration parameters\
\[CloseCurlyQuote] defining numerically the event horizon (\[Epsilon]), the \
point of match (\[Mu]) and infinity (\[Iota]), and the order at which the \
series expansion at the horizon and at infinity are truncated.\
\>", "Text",
 CellChangeTimes->{{4.002952471921526*^9, 4.002952518150999*^9}, {
  4.002952554910614*^9, 
  4.002952740445652*^9}},ExpressionUUID->"6a474db1-77f7-6a43-aa32-\
4aa94ee399c1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Omega]SBH", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"0.7473433688360838", "-", " ", 
       RowBox[{"0.1779246313778714", "\[ImaginaryI]"}]}], ")"}], "/", "2"}]}],
    ";"}], 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"analytical", " ", "value", " ", "of", " ", "Schwarzschild", " ", 
     RowBox[{"BH", "'"}], "s", " ", "n"}], "=", 
    RowBox[{"1", " ", "QNM"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Omega]guess", "=", 
   RowBox[{
    FractionBox["2", "5"], "-", 
    RowBox[{
     FractionBox["1", "10"], " ", "\[ImaginaryI]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<For a Schwarzschild BH: \!\(\*SubscriptBox[\(\[Omega]\), \
\(0\)]\) = \>\"", ",", " ", "\[Omega]SBH", ",", 
    " ", "\"\<\\nInitial guess: \!\(\*SubscriptBox[\(\[Omega]\), \(guess\)]\) \
= \>\"", ",", " ", "\[Omega]guess"}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{4.0021882941899548`*^9, 4.0021883705965385`*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"7037fc7e-6acc-b94e-a637-b7b19b8b724e"],

