Cell[CellGroupData[{

Cell["QNM Finder", "Chapter",
 CellChangeTimes->{{4.0032061782518425`*^9, 4.003206205895132*^9}, 
   4.003208999371887*^9},ExpressionUUID->"4e337d89-8bf3-6040-b66a-\
3db497475212"],

Cell["\<\
We adopt a direct integration method to find the first quasi-normal mode \
(QNM) of a specific compact object (CO).

First, the perturbation equation is numerically integrated from the horizon \
(surface in the case of an ECO) to the outside and from infinity to the \
inside. The two solutions are \[OpenCurlyDoubleQuote]attached together\
\[CloseCurlyDoubleQuote] at a point of match. The QNM is estimated as the \
value smoothing the solution. This is done searching for a continuous \
derivative, i.e. requesting zero deviation between the left and right side \
when evaluated at the point of match.

In this Chapter the implementation is generalized to accept any perturbation \
equation (e.g. Regge-Wheeler or Teukolsky) and boundary condition. Two \
functions are defined:
\t- IntQNM: performs direct integration of the perturbation equation at fixed \
\[Omega], returns the deviation of the first derivate;
\t- FindQNM: searches the root of IntQNM.\
\>", "Text",
 CellChangeTimes->{{4.003210284796711*^9, 4.0032104227682457`*^9}, {
  4.0032104571818695`*^9, 4.0032104862016144`*^9}, {4.0032117920777016`*^9, 
  4.003211793726856*^9}, {4.003211824085804*^9, 4.003211933206215*^9}, {
  4.0032119696187897`*^9, 4.0032120890624256`*^9}, {4.0032121318256207`*^9, 
  4.0032126207753563`*^9}, {4.0032127293276215`*^9, 
  4.0032127295019894`*^9}},ExpressionUUID->"3e03dbdc-6129-f842-b80c-\
31d9c35dd0da"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"-", " ", 
      RowBox[{"Integrator", " ", "--"}]}]}], "-"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"NOTE", ":"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"eq_", "    ", ":", " ", 
    RowBox[{
     RowBox[{"perturbation", " ", "equation"}], " ", "-", " ", 
     RowBox[{"the", " ", 
      RowBox[{"unknown", "'"}], "s", " ", "name", " ", "must", " ", "be", " ",
       "\[Psi]"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"par_", "   ", ":", " ", 
    RowBox[{
     RowBox[{
     "list", " ", "of", " ", "rules", " ", "for", " ", "the", " ", "CO", " ", 
      "parameters", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"e", ".", "g", ".", " ", "mass"}], ",", " ", "spin", ",", " ", 
        RowBox[{"etc", "."}]}], ")"}]}], " ", "-", " ", 
     RowBox[{
     "names", " ", "depends", " ", "on", " ", "the", " ", "definition", " ", 
      "of", " ", "eq_"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"theta_", " ", ":", " ", 
    RowBox[{
    "list", " ", "of", " ", "rules", " ", "for", " ", "the", " ", 
     "integration", " ", "parameters", " ", 
     RowBox[{"(", 
      RowBox[{"eps", ",", " ", 
       RowBox[{"match", " ", "and", " ", "inf"}]}], ")"}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"BCs_", "   ", ":", " ", 
    RowBox[{
    "list", " ", "of", " ", "two", " ", "expressions", " ", "depending", " ", 
     "on", " ", "r", " ", "and", " ", "the", " ", "CO"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "In", " ", "principle", " ", "par_", " ", "and", " ", "theta_", " ", 
     "can", " ", "be", " ", "substituted", " ", "by", " ", "a", " ", "single",
      " ", "list", " ", "of", " ", 
     RowBox[{"rules", ".", " ", "\[IndentingNewLine]", "Although"}]}], ",", 
    " ", 
    RowBox[{
    "this", " ", "distinction", " ", "allows", " ", "to", " ", "more", " ", 
     "easily", " ", "separate", " ", "fixed", " ", "parameters", " ", "and", " ",
      "variables", " ", "during", " ", "a", " ", "parameter", " ", "space", " ",
      "exploration", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"see", " ", "below"}], ")"}], ".", " ", "\[IndentingNewLine]", 
      "Here"}], " ", "we", " ", "leave", " ", "two", " ", "lists", " ", "for",
      " ", "consistency", " ", "and", " ", "to", " ", "pass", " ", "them", " ",
      "without", " ", "manipulations", " ", "of", " ", "sort"}]}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"IntQNM", "[", 
     RowBox[{
     "\[Omega]0_", ",", "eq_", ",", "par_", ",", "theta_", ",", "BCs_"}], 
     "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "rules", ",", "param", ",", "prec", ",", "rI", ",", "rM", ",", "rE", ",",
         "\[Xi]", ",", "\[Xi]I", ",", "\[Xi]E", ",", "EQ", ",", "BC", ",", 
        "b", ",", "\[CapitalDelta]\[Xi]p"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"rules", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"AccuracyGoal", "\[Rule]", "12"}], ",", 
          RowBox[{"PrecisionGoal", "\[Rule]", "12"}], ",", 
          RowBox[{"WorkingPrecision", "->", "20"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"NOTE", ":", " ", 
         RowBox[{
         "a", " ", "precision", " ", "of", " ", "at", " ", "least", " ", 
          "WorkingPrecision", " ", "is", " ", "forced", " ", "across", " ", 
          "the", " ", "whole", " ", "function"}]}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"param", "=", 
        RowBox[{"Union", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[Omega]", "->", "\[Omega]0"}], "}"}], ",", "par", ",", 
          "theta"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"prec", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"20", ",", 
          RowBox[{"Precision", "[", "param", "]"}]}], "]"}]}], ";", 
       RowBox[{"param", "=", 
        RowBox[{"SetPrecision", "[", 
         RowBox[{"param", ",", "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"rI", "=", 
        RowBox[{
         RowBox[{"2", "M", 
          RowBox[{"(", 
           RowBox[{"1", "+", "eps"}], ")"}]}], "/.", "param"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"rM", "=", 
        RowBox[{
         RowBox[{"match", " ", "M"}], "/.", "param"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"rE", "=", 
        RowBox[{
         RowBox[{"inf", " ", "M"}], "/.", "param"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"The", " ", "unknown", " ", 
         RowBox[{"function", "'"}], "s", " ", "name", " ", "is", " ", 
         "standardized", " ", "to", " ", "\[Psi]"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"EQ", "=", 
        RowBox[{"SetPrecision", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"eq", "==", "0"}], "}"}], "//.", 
           RowBox[{"Union", "[", 
            RowBox[{"param", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"\[Psi]", "[", "r", "]"}], "->", 
                RowBox[{"\[Xi]", "[", "r", "]"}]}], ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"\[Psi]", "'"}], "[", "r", "]"}], "->", 
                RowBox[{
                 RowBox[{"\[Xi]", "'"}], "[", "r", "]"}]}], ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"\[Psi]", "''"}], "[", "r", "]"}], "->", 
                RowBox[{
                 RowBox[{"\[Xi]", "''"}], "[", "r", "]"}]}]}], "}"}]}], 
            "]"}]}], ",", "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Solution", " ", "integrating", " ", "from", " ", "the", " ", 
         "horizon"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"BC", "=", 
        RowBox[{"SetPrecision", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"\[Xi]", "[", "rI", "]"}], "==", 
              RowBox[{"BCs", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"\[Xi]", "'"}], "[", "rI", "]"}], "==", 
              RowBox[{"D", "[", 
               RowBox[{
                RowBox[{"BCs", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", "r"}], "]"}]}]}], "}"}],
            "//.", 
           RowBox[{"Union", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"r", "->", "rI"}], "}"}], ",", "param"}], "]"}]}], ",", 
          "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"\[Xi]I", "=", 
        RowBox[{
         RowBox[{"\[Xi]", "[", "r", "]"}], "/.", 
         RowBox[{
          RowBox[{"NDSolve", "[", 
           RowBox[{
            RowBox[{"Union", "[", 
             RowBox[{"EQ", ",", "BC"}], "]"}], ",", "\[Xi]", ",", 
            RowBox[{"{", 
             RowBox[{"r", ",", "rI", ",", "rM"}], "}"}], ",", "rules"}], 
           "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Solution", " ", "integration", " ", "from", " ", "infinity"}], " ", 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"BC", "=", 
        RowBox[{"SetPrecision", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"\[Xi]", "[", "rE", "]"}], "\[Equal]", 
              RowBox[{"BCs", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"\[Xi]", "'"}], "[", "rE", "]"}], "==", 
              RowBox[{"D", "[", 
               RowBox[{
                RowBox[{"BCs", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], ",", "r"}], "]"}]}]}], "}"}],
            "//.", 
           RowBox[{"Union", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"r", "->", "rE"}], "}"}], ",", "param"}], "]"}]}], ",", 
          "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"\[Xi]E", "=", 
        RowBox[{
         RowBox[{"\[Xi]", "[", "r", "]"}], "/.", 
         RowBox[{
          RowBox[{"NDSolve", "[", 
           RowBox[{
            RowBox[{"Union", "[", 
             RowBox[{"EQ", ",", "BC"}], "]"}], ",", "\[Xi]", ",", 
            RowBox[{"{", 
             RowBox[{"r", ",", "rE", ",", "rM"}], "}"}], ",", "rules"}], 
           "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Linear", " ", "combination"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"b", "=", 
        RowBox[{
         FractionBox["\[Xi]I", "\[Xi]E"], "/.", 
         RowBox[{"r", "\[Rule]", "rM"}]}]}], ";", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
         "we", " ", "fix", " ", "the", " ", "coefficients", " ", "of", " ", 
          "the", " ", "linear", " ", "combination", " ", "in", " ", "order", " ",
           "for", " ", "\[Psi]n", " ", "to", " ", "be", " ", "continuous", " ",
           "at", " ", "r"}], "=", "rm"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"\[CapitalUpsilon]n", "=", 
          RowBox[{"Piecewise", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"\[CapitalUpsilon]hor", ",", 
               RowBox[{"r", "<", "rm"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"b", "\[Times]", "\[CapitalUpsilon]inf"}], ",", 
               RowBox[{"r", "\[GreaterEqual]", "rm"}]}], "}"}]}], "}"}], 
           "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"\[CapitalDelta]\[Xi]p", "=", 
        RowBox[{
         FractionBox[
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{"\[Xi]I", ",", "r"}], "]"}], "-", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"b", " ", "\[Xi]E"}], ",", "r"}], "]"}]}], 
          RowBox[{"D", "[", 
           RowBox[{"\[Xi]I", ",", "r"}], "]"}]], "/.", 
         RowBox[{"r", "\[Rule]", "rM"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "\[CapitalDelta]\[Xi]p", "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{4.0032062155198174`*^9, 4.0032062515951004`*^9}, {
   4.0032062830495453`*^9, 4.0032063747749405`*^9}, {4.003206418193634*^9, 
   4.0032066278145657`*^9}, {4.0032068045709953`*^9, 4.003206957887724*^9}, {
   4.0032076114166565`*^9, 4.003207614924309*^9}, {4.0032076831437283`*^9, 
   4.0032077764650345`*^9}, {4.00320782993046*^9, 4.0032078559935246`*^9}, {
   4.0032079154371624`*^9, 4.003207916096096*^9}, {4.003208106114031*^9, 
   4.003208429446007*^9}, {4.0032084663791428`*^9, 4.003208802337944*^9}, {
   4.003208852114414*^9, 4.0032089577969933`*^9}, {4.003209092555212*^9, 
   4.0032090967642536`*^9}, {4.003209762790308*^9, 4.003209768392414*^9}, {
   4.003209893121868*^9, 4.0032098945801315`*^9}, {4.003210247151655*^9, 
