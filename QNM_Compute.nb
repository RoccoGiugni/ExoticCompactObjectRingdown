Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"-", " ", 
      RowBox[{"GridSearch", " ", "--"}]}]}], "-", " ", 
    RowBox[{"to", " ", "be", " ", "tested"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"NOTE", ":"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"par_", "    ", ":", " ", 
    RowBox[{
    "list", " ", "of", " ", "rules", " ", "setting", " ", "any", " ", "fixed",
      " ", "parameter", " ", "of", " ", "the", " ", "computation"}]}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"fun_", "    ", ":", " ", 
    RowBox[{
    "function", " ", "setting", " ", "the", " ", "substitution", " ", "rules",
      " ", 
     RowBox[{"(", 
      RowBox[{
      "allows", " ", "to", " ", "choose", " ", "which", " ", "parameters", " ",
        "to", " ", "change"}], ")"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"ranges_", " ", "=", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"start", ",", " ", "end", ",", " ", "step"}], "}"}], ",", 
         RowBox[{"{", "...", "}"}], ",", "..."}], "}"}], ",", 
       RowBox[{"{", "...", "}"}]}], "}"}], " ", "sets", " ", "the", " ", 
     "grid", " ", "values"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"GridSearch", "[", 
     RowBox[{"\[Omega]0_", ",", "par_", ",", "fun_", ",", "ranges_"}], "]"}], 
    ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"axis", ",", "data", ",", "dims", ",", "n", ",", 
        RowBox[{"i", "=", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"axis", "=", 
        RowBox[{"Union", "@@@", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Range", "@@", "#"}], "&"}], ",", "ranges", ",", 
           RowBox[{"{", "2", "}"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"dims", "=", 
        RowBox[{"Length", "/@", "axis"}]}], ";", 
       RowBox[{"n", "=", 
        RowBox[{"Times", "@@", "dims"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"data", "=", 
        RowBox[{"Monitor", "[", 
         RowBox[{
          RowBox[{"ParallelMap", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"With", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"r", "=", 
                 RowBox[{"FindQNM", "[", 
                  RowBox[{"\[Omega]0", ",", "par", ",", 
                   RowBox[{"fun", "[", "#", "]"}]}], "]"}]}], "}"}], ",", 
               RowBox[{
                RowBox[{"i", "++"}], ";", 
                RowBox[{"Join", "[", 
                 RowBox[{"#", ",", "r"}], "]"}]}]}], "]"}], "&"}], ",", 
            RowBox[{"Tuples", "[", "axis", "]"}], ",", 
            RowBox[{"Method", "->", "\"\<FinestGrained\>\""}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"ProgressIndicator", "[", 
              RowBox[{"i", ",", 
               RowBox[{"{", 
                RowBox[{"0", ",", "n"}], "}"}]}], "]"}], ",", "\"\< \>\"", ",",
              "i", ",", "\"\</\>\"", ",", "n"}], "}"}], "]"}]}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"Return", "[", 
        RowBox[{"Fold", "[", 
         RowBox[{"Partition", ",", "data", ",", 
          RowBox[{"Reverse", "@", 
           RowBox[{"Rest", "@", "dims"}]}]}], "]"}], "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{4.0032899324064426`*^9, 4.0032899969715233`*^9}, {
