Cell[CellGroupData[{

Cell["Computation", "Subsubsection",
 CellChangeTimes->{{4.0034911906157207`*^9, 4.003491204852463*^9}, {
  4.0034914355430603`*^9, 
  4.0034914377519016`*^9}},ExpressionUUID->"644b3601-961a-0a47-b834-\
99bbaa4f739e"],

Cell["\<\
Options (opt):
\t1. True \[Rule] New values of \[Epsilon] are added to an existing file;
\t2. True \[Rule] New values of \[Eta] are added to an existing file (if 1. \
is also True it prevails);
\t \t- Default (i.e. 1. and 2. are both False) create a new file with \
user-entered starting guess.
\t 3. True \[Rule] Gives the correct shape output when \[Epsilon] is the \
initialization parameter.\
\>", "Text",
 CellChangeTimes->{{4.0034915520543976`*^9, 4.0034915924291153`*^9}, {
  4.0034916304099255`*^9, 4.0034919562023315`*^9}, {4.0034919874043465`*^9, 
  4.003492028485506*^9}},ExpressionUUID->"4c1629bc-5ce3-534d-94d4-\
7b63cc869d4a"],

