               RowBox[{"[", "3", "]"}], "]"}]}], ";", "r"}]}], "]"}], "&"}], ",",
          "points"}], "]"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"RunLine", "[", 
      RowBox[{"\[Omega]0_", ",", "par_", ",", "name_", ",", "points_"}], 
      "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Omega]guess", "=", "\[Omega]0"}], ",", "n", ",", 
         RowBox[{"i", "=", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
