Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"NOTE", ":", " ", 
    RowBox[{
    "combinations", " ", "of", " ", "plus", " ", "and", " ", "minus", " ", 
     "sign", " ", "in", " ", "ops", " ", "and", " ", "ranges", " ", "allow", " ",
      "to", " ", "select", " ", "direction", " ", "of", " ", 
     "integration"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ops", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        FractionBox[
         RowBox[{"1", "-", 
          RowBox[{"10", "^", 
           RowBox[{"-", "#"}]}]}], 
         RowBox[{"16", "\[Pi]"}]], "&"}], ",", 
       RowBox[{
        RowBox[{"10", "^", "#"}], "&"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
