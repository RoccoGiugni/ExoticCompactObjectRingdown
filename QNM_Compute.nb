Cell[TextData[{
 "OUTPUT FILE\n\nData format: length ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e9f8fa3c-0864-ad49-8b43-b287c56d4035"],
 " \[OpenCurlyDoubleQuote]matrix\[CloseCurlyDoubleQuote] with elements \
{match, inf, Re[\[Omega]], Im[\[Eta]], check}, where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "=", 
    RowBox[{"number", " ", "of", " ", "points"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "80a491a6-2c6b-2447-b4e0-7f7841c68898"],
 ".\nName format:\n\t- Object type : ECO1, i.e. non-spinning ECO;\n\t- \
Parameters : log[",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Eta]", "'"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3ccc2013-67db-9347-820d-11dadab5297f"],
 "]_log[\[Epsilon]]_ordI-ordE (if equal one is omitted);\n\t- Output          \
 : e(=eps)_m(=match)_i(=inf)_R(=Re[\[Omega]])_I(=Im[\[Omega]])_c(=check);\n\t\
- File numeration (i.e. different run and/or parameter volume)."
}], "Text",
 CellChangeTimes->{{4.003482565589369*^9, 4.0034830160482807`*^9}, {
  4.003483047572075*^9, 4.003483173466505*^9}, {4.003483231827999*^9, 
