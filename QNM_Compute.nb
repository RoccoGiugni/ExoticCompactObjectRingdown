Cell[CellGroupData[{

Cell["Old stuff", "Section",
 CellChangeTimes->{{4.003215383995081*^9, 
  4.0032153858721066`*^9}},ExpressionUUID->"74f078a4-4d34-2a49-8050-\
0fddbdd9784c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"{", "}"}]}], ";", 
  RowBox[{"n", "=", "250"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[Epsilon]", ",", "\[Mu]", ",", "\[Iota]", ",", "\[Omega]found", ",", 
      "check"}], "}"}], ",", 
    RowBox[{"Monitor", "[", 
     RowBox[{
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Epsilon]", "=", 
          RowBox[{"10", "^", 
           RowBox[{"-", "7"}]}]}], 
         RowBox[{"(*", 
          RowBox[{"RandomVariate", "[", 
           RowBox[{"UniformDistribution", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "7"}], ",", 
              RowBox[{"-", "3"}]}], "}"}], "]"}], "]"}], "*)"}], ";", 
         RowBox[{"\[Mu]", "=", 
          RowBox[{"RandomVariate", "[", 
           RowBox[{"UniformDistribution", "[", 
            RowBox[{"{", 
             RowBox[{"5", ",", "15"}], "}"}], "]"}], "]"}]}], ";", 
         RowBox[{"\[Iota]", "=", "60"}], 
         RowBox[{"(*", 
          RowBox[{"RandomVariate", "[", 
           RowBox[{"UniformDistribution", "[", 
            RowBox[{"{", 
             RowBox[{"25", ",", "150"}], "}"}], "]"}], "]"}], "*)"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"\[Omega]found", "=", 
          RowBox[{
           RowBox[{"FindQNM", "[", 
            RowBox[{"\[Omega]guess", ",", 
             RowBox[{"{", 
              RowBox[{"2", ",", "\[Epsilon]", ",", "\[Mu]", ",", "\[Iota]"}], 
              "}"}]}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"data", ",", 
           RowBox[{"{", 
            RowBox[{
            "\[Epsilon]", ",", "\[Mu]", ",", "\[Iota]", ",", "\[Omega]found", 
             ",", 
             RowBox[{"Abs", "[", 
              RowBox[{"\[Omega]found", "-", "\[Omega]SBH"}], "]"}]}], "}"}]}],
           "]"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"i", ",", "n"}], "}"}]}], "]"}], ",", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<Iteration: i = \>\"", ",", "i"}], "}"}], "]"}]}], 
     "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"Sort", "[", 
    RowBox[{"data", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"#1", "[", 
        RowBox[{"[", 
         RowBox[{"-", "1"}], "]"}], "]"}], "<", 
       RowBox[{"#2", "[", 
        RowBox[{"[", 
         RowBox[{"-", "1"}], "]"}], "]"}]}], "&"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Dim[data] = \>\"", ",", 
    RowBox[{"data", "//", "Dimensions"}]}], "]"}], ";"}]}], "Input",
