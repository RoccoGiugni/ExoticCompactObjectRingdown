Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"-", " ", 
      RowBox[{"Integrator", " ", "--"}]}]}], "-"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"NOTE", ":"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"eq_", "    ", ":", " ", 
    RowBox[{
     RowBox[{"perturbation", " ", "equation"}], " ", "-", " ", 
     RowBox[{"the", " ", 
      RowBox[{"unknown", "'"}], "s", " ", "name", " ", "must", " ", "be", " ",
       "\[Psi]"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"par_", "   ", ":", " ", 
    RowBox[{
     RowBox[{
     "list", " ", "of", " ", "rules", " ", "for", " ", "the", " ", "CO", " ", 
      "parameters", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"e", ".", "g", ".", " ", "mass"}], ",", " ", "spin", ",", " ", 
        RowBox[{"etc", "."}]}], ")"}]}], " ", "-", " ", 
     RowBox[{
     "names", " ", "depends", " ", "on", " ", "the", " ", "definition", " ", 
      "of", " ", "eq_"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"theta_", " ", ":", " ", 
    RowBox[{
    "list", " ", "of", " ", "rules", " ", "for", " ", "the", " ", 
     "integration", " ", "parameters", " ", 
     RowBox[{"(", 
      RowBox[{"eps", ",", " ", 
       RowBox[{"match", " ", "and", " ", "inf"}]}], ")"}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"BCs_", "   ", ":", " ", 
    RowBox[{
    "list", " ", "of", " ", "two", " ", "expressions", " ", "depending", " ", 
     "on", " ", "r", " ", "and", " ", "the", " ", "CO"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "In", " ", "principle", " ", "par_", " ", "and", " ", "theta_", " ", 
     "can", " ", "be", " ", "substituted", " ", "by", " ", "a", " ", "single",
      " ", "list", " ", "of", " ", 
     RowBox[{"rules", ".", " ", "\[IndentingNewLine]", "Although"}]}], ",", 
    " ", 
    RowBox[{
    "this", " ", "distinction", " ", "allows", " ", "to", " ", "more", " ", 
     "easily", " ", "separate", " ", "fixed", " ", "parameters", " ", "and", " ",
      "variables", " ", "during", " ", "a", " ", "parameter", " ", "space", " ",
      "exploration", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"see", " ", "below"}], ")"}], ".", " ", "\[IndentingNewLine]", 
      "Here"}], " ", "we", " ", "leave", " ", "to", " ", "lists", " ", "for", 
     " ", "consistency", " ", "and", " ", "to", " ", "pass", " ", "them", " ",
      "without", " ", "manipulations", " ", "of", " ", "sort"}]}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"IntQNM", "[", 
     RowBox[{
     "\[Omega]0_", ",", "eq_", ",", "par_", ",", "theta_", ",", "BCs_"}], 
     "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "rules", ",", "param", ",", "prec", ",", "rI", ",", "rM", ",", "rE", ",",
         "\[Xi]", ",", "\[Xi]I", ",", "\[Xi]E", ",", "EQ", ",", "BC", ",", 
        "b", ",", "\[CapitalDelta]\[Xi]p"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"rules", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"AccuracyGoal", "\[Rule]", "12"}], ",", 
          RowBox[{"PrecisionGoal", "\[Rule]", "12"}], ",", 
          RowBox[{"WorkingPrecision", "->", "20"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"NOTE", ":", " ", 
         RowBox[{
         "a", " ", "precision", " ", "of", " ", "at", " ", "least", " ", 
          "WorkingPrecision", " ", "is", " ", "forced", " ", "across", " ", 
          "the", " ", "whole", " ", "function"}]}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"param", "=", 
        RowBox[{"Union", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[Omega]", "->", "\[Omega]0"}], "}"}], ",", "par", ",", 
          "theta"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"prec", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"20", ",", 
          RowBox[{"Precision", "[", "param", "]"}]}], "]"}]}], ";", 
       RowBox[{"param", "=", 
        RowBox[{"SetPrecision", "[", 
         RowBox[{"param", ",", "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"rI", "=", 
        RowBox[{
         RowBox[{"2", "M", 
          RowBox[{"(", 
           RowBox[{"1", "+", "eps"}], ")"}]}], "/.", "param"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"rM", "=", 
        RowBox[{
         RowBox[{"match", " ", "M"}], "/.", "param"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"rE", "=", 
        RowBox[{
         RowBox[{"inf", " ", "M"}], "/.", "param"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"The", " ", "unknown", " ", 
         RowBox[{"function", "'"}], "s", " ", "name", " ", "is", " ", 
         "standardized", " ", "to", " ", "\[Psi]"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"EQ", "=", 
        RowBox[{"SetPrecision", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"eq", "==", "0"}], "}"}], "//.", 
           RowBox[{"Union", "[", 
            RowBox[{"param", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"\[Psi]", "[", "r", "]"}], "->", 
                RowBox[{"\[Xi]", "[", "r", "]"}]}], ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"\[Psi]", "'"}], "[", "r", "]"}], "->", 
                RowBox[{
                 RowBox[{"\[Xi]", "'"}], "[", "r", "]"}]}], ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"\[Psi]", "''"}], "[", "r", "]"}], "->", 
                RowBox[{
                 RowBox[{"\[Xi]", "''"}], "[", "r", "]"}]}]}], "}"}]}], 
            "]"}]}], ",", "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Solution", " ", "integrating", " ", "from", " ", "the", " ", 
         "horizon"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"BC", "=", 
        RowBox[{"SetPrecision", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"\[Xi]", "[", "rI", "]"}], "==", 
              RowBox[{"BCs", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"\[Xi]", "'"}], "[", "rI", "]"}], "==", 
              RowBox[{"D", "[", 
               RowBox[{
                RowBox[{"BCs", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", "r"}], "]"}]}]}], "}"}],
            "//.", 
           RowBox[{"Union", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"r", "->", "rI"}], "}"}], ",", "param"}], "]"}]}], ",", 
          "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"\[Xi]I", "=", 
        RowBox[{
         RowBox[{"\[Xi]", "[", "r", "]"}], "/.", 
         RowBox[{
          RowBox[{"NDSolve", "[", 
           RowBox[{
            RowBox[{"Union", "[", 
             RowBox[{"EQ", ",", "BC"}], "]"}], ",", "\[Xi]", ",", 
            RowBox[{"{", 
             RowBox[{"r", ",", "rI", ",", "rM"}], "}"}], ",", "rules"}], 
           "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Solution", " ", "integration", " ", "from", " ", "infinity"}], " ", 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"BC", "=", 
        RowBox[{"SetPrecision", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"\[Xi]", "[", "rE", "]"}], "\[Equal]", 
              RowBox[{"BCs", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"\[Xi]", "'"}], "[", "rE", "]"}], "==", 
              RowBox[{"D", "[", 
               RowBox[{
                RowBox[{"BCs", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], ",", "r"}], "]"}]}]}], "}"}],
            "//.", 
           RowBox[{"Union", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"r", "->", "rE"}], "}"}], ",", "param"}], "]"}]}], ",", 
          "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"\[Xi]E", "=", 
        RowBox[{
         RowBox[{"\[Xi]", "[", "r", "]"}], "/.", 
         RowBox[{
          RowBox[{"NDSolve", "[", 
           RowBox[{
            RowBox[{"Union", "[", 
             RowBox[{"EQ", ",", "BC"}], "]"}], ",", "\[Xi]", ",", 
            RowBox[{"{", 
             RowBox[{"r", ",", "rE", ",", "rM"}], "}"}], ",", "rules"}], 
           "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Linear", " ", "combination"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"b", "=", 
        RowBox[{
         FractionBox["\[Xi]I", "\[Xi]E"], "/.", 
         RowBox[{"r", "\[Rule]", "rM"}]}]}], ";", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
         "we", " ", "fix", " ", "the", " ", "coefficients", " ", "of", " ", 
          "the", " ", "linear", " ", "combination", " ", "in", " ", "order", " ",
           "for", " ", "\[Psi]n", " ", "to", " ", "be", " ", "continuous", " ",
           "at", " ", "r"}], "=", "rm"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"\[CapitalUpsilon]n", "=", 
          RowBox[{"Piecewise", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"\[CapitalUpsilon]hor", ",", 
               RowBox[{"r", "<", "rm"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"b", "\[Times]", "\[CapitalUpsilon]inf"}], ",", 
               RowBox[{"r", "\[GreaterEqual]", "rm"}]}], "}"}]}], "}"}], 
           "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"\[CapitalDelta]\[Xi]p", "=", 
        RowBox[{
         FractionBox[
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{"\[Xi]I", ",", "r"}], "]"}], "-", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"b", " ", "\[Xi]E"}], ",", "r"}], "]"}]}], 
          RowBox[{"D", "[", 
           RowBox[{"\[Xi]I", ",", "r"}], "]"}]], "/.", 
         RowBox[{"r", "\[Rule]", "rM"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "\[CapitalDelta]\[Xi]p", "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
