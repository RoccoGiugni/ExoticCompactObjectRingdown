   "par_", " ", "and", " ", "theta_", " ", "are", " ", "the", " ", "same", " ",
     "of", " ", "IntQNM"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "EQ", " ", "and", " ", "BC", " ", "are", " ", "set", " ", "outside", " ", 
    "for", " ", "the", " ", "specific", " ", "CO"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"FindQNM", "[", 
     RowBox[{"\[Omega]0_", ",", "par_", ",", "theta_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", ",", "\[Omega]root", ",", "rules"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"rules", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"AccuracyGoal", "->", "6"}], ",", 
          RowBox[{"WorkingPrecision", "->", "20"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"g", "[", 
         RowBox[{"x_", "?", "NumericQ"}], "]"}], ":=", 
        RowBox[{"IntQNM", "[", 
         RowBox[{"x", ",", "EQ", ",", "par", ",", "theta", ",", "BC"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"\[Omega]root", "=", 
        RowBox[{"x", "/.", 
         RowBox[{
          RowBox[{"FindRoot", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"g", "[", "x", "]"}], "\[Equal]", "0"}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "\[Omega]0"}], "}"}], ",", 
            RowBox[{"AccuracyGoal", "->", "6"}], ",", 
            RowBox[{"WorkingPrecision", "->", "20"}]}], 
           RowBox[{"(*", 
            RowBox[{",", 
             RowBox[{"EvaluationMonitor", ":>", 
              RowBox[{"Print", "[", 
               
               RowBox[{"\"\<\[Omega] = \>\"", ",", " ", "x", 
                ",", "\"\< \[CapitalDelta]\[Psi]' = \>\"", ",", 
                RowBox[{"Abs", "[", 
                 RowBox[{"g", "[", "x", "]"}], "]"}]}], "]"}]}]}], "*)"}], 
           "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Return", "[", 
        RowBox[{"{", 
         RowBox[{"\[Omega]root", ",", 
          RowBox[{"Abs", "[", 
           RowBox[{"g", "[", "\[Omega]root", "]"}], "]"}]}], "}"}], "]"}], 
       ";"}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{4.0032097308804893`*^9, 4.003209745206764*^9}, {
