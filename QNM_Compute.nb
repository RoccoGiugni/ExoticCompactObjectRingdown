Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", " ", "RandomSearch"}]}], " ", 
     RowBox[{"V2", " ", "--"}]}], "-", " ", 
    RowBox[{"to", " ", "be", " ", "tested"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"NOTE", ":"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"par_", "    ", ":", " ", 
    RowBox[{
    "list", " ", "of", " ", "rules", " ", "for", " ", "CO", " ", "parameters",
      " ", 
     RowBox[{"(", 
      RowBox[{"see", " ", "IntQNM", " ", "above"}], ")"}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"ops_", "    ", ":", " ", 
    RowBox[{
    "list", " ", "of", " ", "functions", " ", "to", " ", "set", " ", 
     "hyperparameters", " ", "taking", " ", "as", " ", "input", " ", "an", " ",
      "uniformly", " ", "distributed", " ", "random", " ", "variable"}]}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"ranges_", " ", ":", " ", 
    RowBox[{
    "ranges", " ", "of", " ", "each", " ", "uniform", " ", "distribution"}]}],
    " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"n_", "      ", ":", " ", 
    RowBox[{"number", " ", "of", " ", "iterations"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"output", "  ", ":", " ", 
    RowBox[{"{", 
     RowBox[{"theta", ",", " ", 
      RowBox[{"Re", "[", "\[Omega]", "]"}], ",", " ", 
      RowBox[{"Im", "[", "\[Omega]", "]"}], ",", " ", "check"}], "}"}]}], " ",
    "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"RandomSearch", "[", 
     RowBox[{"\[Omega]0_", ",", "par_", ",", "specs_", ",", "n_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"data", ",", "name", ",", "ops", ",", "range", ",", "theta", ",", 
        RowBox[{"i", "=", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"name", ",", "ops", ",", "range"}], "}"}], "=", 
        RowBox[{"specs", "//", "Transpose"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"theta", "=", 
        RowBox[{
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"#1", "[", "#2", "]"}], "&"}], ",", 
           RowBox[{"{", 
            RowBox[{"ops", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"RandomVariate", "[", 
                RowBox[{
                 RowBox[{"UniformDistribution", "[", "#", "]"}], ",", "n"}], 
                "]"}], "&"}], "/@", "range"}]}], "}"}]}], "]"}], "//", 
         "Transpose"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"data", "=", 
        RowBox[{"Monitor", "[", 
         RowBox[{
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"With", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"r", "=", 
                 RowBox[{"FindQNM", "[", 
                  RowBox[{"\[Omega]guess", ",", "par", ",", 
                   RowBox[{"Thread", "[", 
                    RowBox[{"name", "->", "#"}], "]"}]}], "]"}]}], "}"}], ",",
                "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"i", "++"}], ";", 
                RowBox[{"Join", "[", 
                 RowBox[{"#", ",", "r"}], "]"}]}]}], "]"}], "&"}], ",", 
            "theta"}], "]"}], ",", "i"}], 
         RowBox[{"(*", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"ProgressIndicator", "[", 
              RowBox[{"i", ",", 
               RowBox[{"{", 
                RowBox[{"0", ",", "n"}], "}"}]}], "]"}], ",", "\"\< \>\"", ",",
              "i", ",", "\"\</\>\"", ",", "n"}], "}"}], "]"}], "*)"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "data", "]"}], ";"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}]}]], "Input",
