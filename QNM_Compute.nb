Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"-", " ", 
      RowBox[{"RandomSearch", " ", "--"}]}]}], "-"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"NOTE", ":"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"par_", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["\[Omega]", "guess"], ",", " ", 
      SubscriptBox["\[Omega]", "true"], ",", " ", 
      RowBox[{
      "and", " ", "list", " ", "of", " ", "rules", " ", "for", " ", "CO", " ",
        "parameters", " ", 
       RowBox[{"(", 
        RowBox[{"see", " ", "IntQNM", " ", "above"}], ")"}]}]}], "}"}]}], " ",
    "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"ops_", "    ", ":", " ", 
    RowBox[{
    "functions", " ", "to", " ", "set", " ", "hyperparameters", " ", "taking",
      " ", "as", " ", "input", " ", "an", " ", "uniformly", " ", 
     "distributed", " ", "random", " ", "variable"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"ranges_", " ", ":", " ", 
    RowBox[{
    "ranges", " ", "of", " ", "each", " ", "uniform", " ", "distribution"}]}],
    " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"n_", "      ", ":", " ", 
    RowBox[{"number", " ", "of", " ", "iterations"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"output", "  ", ":", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"theta", ",", " ", 
        RowBox[{"Re", "[", "\[CapitalDelta]\[Omega]", "]"}], ",", " ", 
        RowBox[{"Im", "[", "\[CapitalDelta]\[Omega]", "]"}], ",", " ", 
        RowBox[{"Abs", "[", "\[CapitalDelta]\[Omega]", "]"}]}], "}"}], " ", 
      "where", " ", "\[CapitalDelta]\[Omega]"}]}], " ", "=", " ", 
    RowBox[{
     SubscriptBox["\[Omega]", "found"], " ", "-", " ", 
     SubscriptBox["\[Omega]", "true"]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"RandomSearch", "[", 
     RowBox[{"par_", ",", "ops_", ",", "ranges_", ",", "n_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"data", ",", "theta", ",", "\[CapitalDelta]\[Omega]"}], "}"}], 
      ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"data", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Monitor", "[", 
        RowBox[{
         RowBox[{"Do", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"theta", "=", 
             RowBox[{"MapThread", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"#1", "[", "#2", "]"}], "&"}], ",", 
               RowBox[{"{", 
                RowBox[{"ops", ",", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"RandomVariate", "[", 
                    RowBox[{"UniformDistribution", "[", "#", "]"}], "]"}], 
                   "&"}], "/@", "ranges"}]}], "}"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"\[CapitalDelta]\[Omega]", "=", 
             RowBox[{
              RowBox[{
               RowBox[{"FindQNM", "[", 
                RowBox[{
                 RowBox[{"par", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], ",", 
                 RowBox[{"par", "[", 
                  RowBox[{"[", "3", "]"}], "]"}], ",", "theta"}], "]"}], "[", 
               RowBox[{"[", "1", "]"}], "]"}], "-", 
              RowBox[{"par", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"data", ",", 
              RowBox[{"Join", "[", 
               RowBox[{"theta", ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"Re", "[", "\[CapitalDelta]\[Omega]", "]"}], ",", 
                  RowBox[{"Im", "[", "\[CapitalDelta]\[Omega]", "]"}], ",", 
                  RowBox[{"Abs", "[", "\[CapitalDelta]\[Omega]", "]"}]}], 
                 "}"}]}], "]"}]}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "n"}], "}"}]}], "]"}], ",", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Iteration: i = \>\"", ",", "i"}], "}"}], "]"}]}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "data", "]"}], ";"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{4.00279115887166*^9, 4.002791169591364*^9}, {
