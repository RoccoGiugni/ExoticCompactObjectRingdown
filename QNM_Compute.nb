Cell[CellGroupData[{

Cell["Grid Search", "Chapter",
 CellChangeTimes->{{4.002357812880436*^9, 
  4.0023578178116455`*^9}},ExpressionUUID->"d076368d-8b94-4e48-b734-\
bf344c85f167"],

Cell[TextData[{
 "In this Chapter the hyperparameter space is explored along a grid. This \
approach grants a relatively rigorous search over the selected volume, hence \
allowing the study of chosen combinations of parameters.\n\nMultiple \
functions are defined:\n\t- RunLine: run FindQNM (see previous Chapter)  over \
a 1D list of parameters sets, i.e. {{p1, q1,...},{p2,q2,...},...};\n\t- \
GridSearchECO: run RunLine over a 2D parameter grid;\n\t- GridSearch: simple \
exploration over a grid where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Omega]", "guess"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8d01823f-c872-fd4b-bc5e-47bc81940fce"],
 " is fixed (hence most parameters defining the CO as well)."
}], "Text",
 CellChangeTimes->{{4.0032195394815083`*^9, 4.0032197327316647`*^9}, {
  4.0032948953550987`*^9, 4.0032949262026176`*^9}, {4.0033142625715656`*^9, 
  4.0033143120344505`*^9}, {4.003314346082409*^9, 4.0033145387033806`*^9}, {
  4.0033146752059193`*^9, 4.0033146756545563`*^9}, {4.0033156047818184`*^9, 
  4.003315697789465*^9}},ExpressionUUID->"cf1d0d9b-0999-684e-9224-\
f399db84a429"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"-", " ", 
      RowBox[{"RunLine", " ", "--"}]}]}], "-"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"NOTE", ":"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"par_", "    ", ":", " ", 
    RowBox[{
    "list", " ", "of", " ", "rules", " ", "setting", " ", "any", " ", "fixed",
      " ", "parameter", " ", "of", " ", "the", " ", "computation"}]}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"fun_", "    ", ":", " ", 
    RowBox[{
    "function", " ", "setting", " ", "the", " ", "substitution", " ", "rules",
      " ", 
     RowBox[{"(", 
      RowBox[{
      "allows", " ", "to", " ", "choose", " ", "which", " ", "parameters", " ",
        "to", " ", "change"}], ")"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"points_", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"p1", ",", "q1", ",", "..."}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"p2", ",", "q2", ",", "..."}], "}"}], ",", "..."}], "}"}]}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"RunLine", "[", 
     RowBox[{"\[Omega]0_", ",", "par_", ",", "fun_", ",", "points_"}], "]"}], 
    ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Omega]guess", "=", "\[Omega]0"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"r", "=", 
             RowBox[{"Join", "[", 
              RowBox[{"#", ",", 
               RowBox[{"FindQNM", "[", 
                RowBox[{"\[Omega]guess", ",", "par", ",", 
                 RowBox[{"fun", "[", "#", "]"}]}], "]"}]}], "]"}]}], "}"}], ",", 
           RowBox[{
            RowBox[{"\[Omega]guess", "=", 
             RowBox[{"r", "[", 
              RowBox[{"[", "3", "]"}], "]"}]}], ";", "r"}]}], "]"}], "&"}], ",",
         "points"}], "]"}]}], "\[IndentingNewLine]", "]"}]}], 
   ";"}]}]], "Input",
 CellChangeTimes->{{4.0033145586508656`*^9, 4.003314688833723*^9}, {
  4.0033147448629475`*^9, 
  4.00331474733753*^9}},ExpressionUUID->"6c6713b8-75d3-174d-ac4a-\
9c5736844dc5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"-", " ", 
      RowBox[{"GridSearchECO", " ", "--"}]}]}], "-"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"NOTE", ":"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"par_", "    ", ":", " ", 
    RowBox[{
    "list", " ", "of", " ", "rules", " ", "setting", " ", "any", " ", "fixed",
      " ", "parameter", " ", "of", " ", "the", " ", "computation"}]}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"fun_", "    ", ":", " ", 
    RowBox[{
    "function", " ", "setting", " ", "the", " ", "substitution", " ", "rules",
      " ", 
     RowBox[{"(", 
      RowBox[{
      "allows", " ", "to", " ", "choose", " ", "which", " ", "parameters", " ",
        "to", " ", "change"}], ")"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"ranges_", " ", "=", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"start", ",", " ", "end", ",", " ", "step"}], "}"}], ",", 
         RowBox[{"{", "...", "}"}], ",", "..."}], "}"}], ",", 
       RowBox[{"{", "...", "}"}]}], "}"}], " ", "sets", " ", "the", " ", 
     "grid", " ", "values"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"GridSearchECO", "[", 
     RowBox[{"\[Omega]0_", ",", "par_", ",", "fun_", ",", "ranges_"}], "]"}], 
    ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ai", ",", "aj", ",", "row1", ",", "cols", ",", "n", ",", 
        RowBox[{"i", "=", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"ai", ",", "aj"}], "}"}], "=", 
        RowBox[{"Union", "@@@", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Range", "@@", "#"}], "&"}], ",", "ranges", ",", 
           RowBox[{"{", "2", "}"}]}], "]"}]}]}], ";", 
       RowBox[{"n", "=", 
        RowBox[{"Times", "@@", 
         RowBox[{"Length", "/@", 
          RowBox[{"{", 
           RowBox[{"ai", ",", "aj"}], "}"}]}]}]}], ";", 
       RowBox[{"(*", " ", 
        RowBox[{
        "grid", " ", "values", " ", "in", " ", "each", " ", "dimensions"}], 
        " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"DistributeDefinitions", "[", 
        RowBox[{"RunLine", ",", "FindQNM"}], "]"}], ";", 
       RowBox[{"SetSharedVariable", "[", "i", "]"}], ";", 
       RowBox[{"(*", " ", 
        RowBox[{
        "definitions", " ", "to", " ", "run", " ", "parallel", " ", 
         "computations"}], " ", "*)"}], "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"row1", "=", 
        RowBox[{"RunLine", "[", 
         RowBox[{"\[Omega]0", ",", "par", ",", "fun", ",", 
          RowBox[{"Thread", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"First", "[", "aj", "]"}], ",", "ai"}], "}"}], "]"}]}], 
         "]"}]}], ";", 
       RowBox[{"(*", " ", 
        RowBox[{"j", "=", 
         RowBox[{
         "1", " ", "is", " ", "fixed", " ", "and", " ", "runs", " ", "over", " ",
           "i"}]}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"cols", "=", 
        RowBox[{"Monitor", "[", 
         RowBox[{
          RowBox[{"ParallelMap", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"With", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"c", "=", 
                 RowBox[{"Prepend", "[", 
                  RowBox[{
                   RowBox[{"RunLine", "[", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "3", "]"}], "]"}], ",", "par", ",", "fun", ",", 
                    RowBox[{"Thread", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Rest", "[", "aj", "]"}], ",", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "]"}]}], "]"}], ",",
                    "#"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"i", "++"}], ";", "c"}]}], "]"}], "&"}], ",", "row1", 
            ",", 
            RowBox[{"Method", "->", "\"\<FinestGrained\>\""}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"ProgressIndicator", "[", 
              RowBox[{"i", ",", 
               RowBox[{"{", 
                RowBox[{"0", ",", "n"}], "}"}]}], "]"}], ",", "\"\< \>\"", ",",
              "i", ",", "\"\</\>\"", ",", "n"}], "}"}], "]"}]}], "]"}]}], ";", 
       RowBox[{"(*", " ", 
        RowBox[{
        "runs", " ", "over", " ", "j", " ", "in", " ", "parallel", " ", "for",
          " ", "every", " ", "i"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Return", "[", 
        RowBox[{"cols", "//", "Transpose"}], "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{4.0032950352287292`*^9, 4.0032950611408787`*^9}, {
