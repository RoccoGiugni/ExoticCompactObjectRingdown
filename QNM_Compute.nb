 CellChangeTimes->{{4.002358394900728*^9, 4.0023584120938873`*^9}, {
  4.0029616377262936`*^9, 
  4.002961640174658*^9}},ExpressionUUID->"1b38ea80-012c-964b-b384-\
94dfaf8bed72"],

Cell[BoxData[
 RowBox[{
  RowBox[{"EQ", "=", "EQRW"}], ";", 
  RowBox[{"BC", "=", 
   RowBox[{"EcoBC", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", 
     RowBox[{
     "Import", "[", "\"\<SeriesCoef\\\\CoefInf_Schw_10.m\>\"", "]"}]}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.003218962874672*^9, 4.0032190165087337`*^9}, {
  4.003219070415531*^9, 
  4.0032191810990543`*^9}},ExpressionUUID->"fd935734-c0c0-644a-a58b-\
9c9b822cf0ac"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Omega]guess", "=", 
   RowBox[{
    RowBox[{"2", "/", "5"}], "-", 
    RowBox[{"\[ImaginaryI]", "/", "10"}]}]}], ";", 
  RowBox[{"par", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"l", "->", "2"}], ",", 
     RowBox[{"M", "->", "1"}], ",", 
     RowBox[{"\[Eta]", "->", 
      FractionBox["1", 
       RowBox[{"16", "\[Pi]"}]]}], ",", 
     RowBox[{"\[Epsilon]", "->", 
      SuperscriptBox["10", 
       RowBox[{"-", "10"}]]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"out", "=", 
   RowBox[{"RandomSearch", "[", 
    RowBox[{"\[Omega]guess", ",", "par", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"#", "&"}], ",", 
       RowBox[{"#", "&"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"5", ",", "15"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"50", ",", "150"}], "}"}]}], "}"}], ",", "1000"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Dim[out] = \>\"", ",", 
     RowBox[{"out", "//", "Dimensions"}]}], "]"}], ";"}], 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"data", "=", 
     RowBox[{"Sort", "[", 
      RowBox[{"data", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#1", "[", 
          RowBox[{"[", 
           RowBox[{"-", "1"}], "]"}], "]"}], "<", 
         RowBox[{"#2", "[", 
          RowBox[{"[", 
           RowBox[{"-", "1"}], "]"}], "]"}]}], "&"}]}], "]"}]}], ";"}], " ", 
   "*)"}]}]}], "Input",
 CellChangeTimes->{{4.003218962874672*^9, 4.0032190165087337`*^9}, {
   4.003219070415531*^9, 4.0032191810990543`*^9}, {4.0032192714233513`*^9, 
