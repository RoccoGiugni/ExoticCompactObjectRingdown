       RowBox[{"here", " ", "for", " ", "compatibility"}]}], ")"}]}]}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"coefE", "  ", ":", " ", 
    RowBox[{
    "list", " ", "of", " ", "substitution", " ", "rules", " ", "for", " ", 
     "the", " ", "series", " ", "coefficients", " ", "at", " ", 
     "infinity"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"output", " ", ":", " ", 
    RowBox[{
    "list", " ", "of", " ", "two", " ", "boundary", " ", "conditions", " ", 
     RowBox[{"(", 
      RowBox[{"see", " ", 
       RowBox[{"QNM_Compute", ".", "nb"}], " ", "for", " ", "applications"}], 
      ")"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"EcoBC", "[", 
     RowBox[{"coefI_", ",", "coefE_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ordI", ",", "bcI", ",", "ordE", ",", "bcE"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ordI", "=", 
        RowBox[{"Length", "[", "coefI", "]"}]}], ";", 
       RowBox[{"bcI", "=", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "\[ImaginaryI]"}], " ", "k", " ", 
           RowBox[{"rs", "[", "r", "]"}]}], "]"}], 
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"r", "-", 
             RowBox[{"3", "M"}]}], ")"}], 
           RowBox[{
            FractionBox[
             RowBox[{"l", 
              RowBox[{"(", 
               RowBox[{"l", "+", "1"}], ")"}]}], "2"], "-", "1"}]], "/", 
          "r"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"ordE", "=", 
        RowBox[{"Length", "[", "coefE", "]"}]}], ";", 
       RowBox[{"bcE", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"\[ImaginaryI]", " ", "\[Omega]", " ", 
            RowBox[{"rs", "[", "r", "]"}]}], "]"}], 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"gInf", "[", "i", "]"}], 
