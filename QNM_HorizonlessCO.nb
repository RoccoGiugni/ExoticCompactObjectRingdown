Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Tortoise coordinate \\!\\(\\*SubscriptBox[\\(r\\), \\(*\\)]\\) \
= \"\>", "\[InvisibleSpace]", 
   RowBox[{"r", "+", 
    RowBox[{"2", " ", "M", " ", 
     RowBox[{"Log", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], " ", "M"}], "+", "r"}], "]"}]}]}]}],
  SequenceForm[
  "Tortoise coordinate \!\(\*SubscriptBox[\(r\), \(*\)]\) = ", $CellContext`r + 
   2 $CellContext`M Log[(-2) $CellContext`M + $CellContext`r]],
  Editable->False]], "Print",
 CellChangeTimes->{
  4.000203422272314*^9, {4.000203514487383*^9, 4.000203529201166*^9}},
