   3.9988136497101707`*^9}, {3.9988138142516136`*^9, 
   3.9988138208731194`*^9}, {3.998813885731188*^9, 3.998813887659416*^9}, {
   3.999061507619652*^9, 3.9990615448421345`*^9}, {3.999061594802187*^9, 
   3.9990616714665356`*^9}, {3.999061708269308*^9, 3.9990617467144012`*^9}, {
   3.999061887699936*^9, 3.9990618888462944`*^9}, {3.9990619510950794`*^9, 
   3.9990619580721455`*^9}, {3.999072063329033*^9, 3.9990720737788124`*^9}, {
