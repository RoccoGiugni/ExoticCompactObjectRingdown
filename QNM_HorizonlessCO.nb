Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"-", " ", 
      RowBox[{"EcoBC", " ", "--"}]}]}], "-"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"coefI", "  ", ":", " ", 
    RowBox[{"empty", " ", "list", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
       "the", " ", "horizon", " ", "BC", " ", "is", " ", "completely", " ", 
        "defined", " ", "inside"}], " ", "-", " ", 
       RowBox[{"here", " ", "for", " ", "compatibility"}]}], ")"}]}]}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"coefE", "  ", ":", " ", 
    RowBox[{
    "list", " ", "of", " ", "substitution", " ", "rules", " ", "for", " ", 
     "the", " ", "series", " ", "coefficients", " ", "at", " ", 
     "infinity"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"output", " ", ":", " ", 
    RowBox[{
    "list", " ", "of", " ", "two", " ", "boundary", " ", "conditions", " ", 
     RowBox[{"(", 
      RowBox[{"see", " ", 
       RowBox[{"QNM_Compute", ".", "nb"}], " ", "for", " ", "applications"}], 
      ")"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"EcoBC", "[", 
     RowBox[{"coefI_", ",", "coefE_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ordI", ",", "bcI", ",", "ordE", ",", "bcE"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"k", "=", 
        FractionBox["\[Omega]", 
         RowBox[{"16", "\[Pi]", " ", "\[Eta]"}]]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ordI", "=", 
        RowBox[{"Length", "[", "coefI", "]"}]}], ";", 
       RowBox[{"bcI", "=", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "\[ImaginaryI]"}], " ", "k", " ", 
           RowBox[{"rs", "[", "r", "]"}]}], "]"}], 
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"r", "-", 
             RowBox[{"3", "M"}]}], ")"}], 
           RowBox[{
            FractionBox[
             RowBox[{"l", 
              RowBox[{"(", 
               RowBox[{"l", "+", "1"}], ")"}]}], "2"], "-", "1"}]], "/", 
          "r"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"ordE", "=", 
        RowBox[{"Length", "[", "coefE", "]"}]}], ";", 
       RowBox[{"bcE", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"\[ImaginaryI]", " ", "\[Omega]", " ", 
            RowBox[{"rs", "[", "r", "]"}]}], "]"}], 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"gInf", "[", "i", "]"}], 
             SuperscriptBox["r", 
              RowBox[{"-", "i"}]]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "0", ",", "ordE"}], "}"}]}], "]"}]}], "//.", 
         "coefE"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"Return", "[", 
        RowBox[{"{", 
         RowBox[{"bcI", ",", "bcE"}], "}"}], "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{4.003317760079479*^9, 4.003317859996565*^9}, {
  4.0033765685485916`*^9, 4.0033765695250435`*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"e2b2450c-51e9-a54e-a45e-5c398f4f18a3"],

