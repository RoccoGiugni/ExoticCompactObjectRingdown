  3.992942382524788*^9}},ExpressionUUID->"cf3e9b24-301a-3743-8e73-\
0c7514203549"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "r_", "]"}], ":=", 
   RowBox[{"1", "-", 
    FractionBox[
     RowBox[{"2", " ", "M"}], "r"]}]}], ";", 
  RowBox[{"VRW", "=", 
   RowBox[{
    RowBox[{"f", "[", "r", "]"}], 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{"l", 
        RowBox[{"(", 
         RowBox[{"l", "+", "1"}], ")"}]}], 
       SuperscriptBox["r", "2"]], "-", 
      FractionBox[
       RowBox[{"6", " ", "M"}], 
       SuperscriptBox["r", "3"]]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rs", "[", "r_", "]"}], ":=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"Integrate", "[", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"f", "[", "r", "]"}]], ",", "r"}], "]"}], ",", 
     RowBox[{"r", ">", "0"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EQRW", "=", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      RowBox[{"f", "[", "r", "]"}], "2"], 
     RowBox[{
      RowBox[{"\[Psi]", "''"}], "[", "r", "]"}]}], "+", 
    RowBox[{
     RowBox[{
      RowBox[{"f", "'"}], "[", "r", "]"}], 
     RowBox[{"f", "[", "r", "]"}], 
     RowBox[{
      RowBox[{"\[Psi]", "'"}], "[", "r", "]"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[Omega]", "2"], "-", "VRW"}], ")"}], 
     RowBox[{"\[Psi]", "[", "r", "]"}]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.992942385204567*^9, 3.9929424551347466`*^9}, {
   3.9929438084339676`*^9, 3.9929438380548687`*^9}, {3.999073143278101*^9, 
   3.9990731442275352`*^9}, {3.9996781988622284`*^9, 
