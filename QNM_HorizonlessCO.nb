Cell["\<\
INTEGRATOR VERSION 1

We adopt a direct integration method.
The master equation is solved numerically from infinity, using BH\
\[CloseCurlyQuote]s boundary conditions (see QNM_Schwarzschild_FV.nb).
The output is the membrane paradigm\[CloseCurlyQuote]s BC (see above).\
\>", "Text",
 CellChangeTimes->{{3.9990722550026875`*^9, 3.999072497618765*^9}, {
  3.9990744606985874`*^9, 3.999074472798275*^9}, {3.9990745178373127`*^9, 
  3.9990745577975445`*^9}, {3.999074683357586*^9, 
  3.999074738697996*^9}},ExpressionUUID->"9a7548a0-1e01-164e-b5cc-\
7b5c43a04f4e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Integrator", " ", "V1"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"IntQNM", "[", 
    RowBox[{"\[Omega]0_", ",", "value_", ",", "coefInf_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "rules", ",", "param", ",", "rHor", ",", "rInf", ",", "\[Xi]", ",", 
       "\[Xi]Inf", ",", "EQs", ",", "BCs", ",", "ordInf"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rules", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"AccuracyGoal", "\[Rule]", "12"}], ",", 
         RowBox[{"PrecisionGoal", "\[Rule]", "12"}], ",", 
         RowBox[{"WorkingPrecision", "->", "MachinePrecision"}]}], "}"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"param", "=", 
       RowBox[{"Union", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"M", "->", "1"}], ",", 
           RowBox[{"\[Omega]", "->", "\[Omega]0"}], ",", 
           RowBox[{
            RowBox[{"gInf", "[", "0", "]"}], "->", "1"}]}], "}"}], ",", 
         RowBox[{"Thread", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"l", ",", "\[Eta]", ",", "\[Epsilon]", ",", "inf"}], 
            "}"}], "->", "value"}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"rHor", "=", 
       RowBox[{
        RowBox[{"2", "M", 
         RowBox[{"(", 
          RowBox[{"1", "+", "\[Epsilon]"}], ")"}]}], "/.", "param"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rInf", "=", 
       RowBox[{
        RowBox[{"inf", "\[Times]", "M"}], "/.", "param"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"EQs", "=", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"EQ", "==", "0"}], "}"}], "//.", 
        RowBox[{"Union", "[", 
         RowBox[{"param", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"\[Psi]", "[", "r", "]"}], "->", 
             RowBox[{"\[Xi]", "[", "r", "]"}]}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"\[Psi]", "'"}], "[", "r", "]"}], "->", 
             RowBox[{
              RowBox[{"\[Xi]", "'"}], "[", "r", "]"}]}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"\[Psi]", "''"}], "[", "r", "]"}], "->", 
             RowBox[{
              RowBox[{"\[Xi]", "''"}], "[", "r", "]"}]}]}], "}"}]}], 
         "]"}]}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Integration", " ", "from", " ", "infinity"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"ordInf", "=", 
       RowBox[{"Length", "[", "coefInf", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"\[Xi]Inf", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"\[ImaginaryI]", " ", "\[Omega]", " ", 
           RowBox[{"rs", "[", "r", "]"}]}], "]"}], 
         RowBox[{"Sum", "[", 
          RowBox[{
           FractionBox[
            RowBox[{"gInf", "[", "i", "]"}], 
            SuperscriptBox["r", "i"]], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "0", ",", "ordInf"}], "}"}]}], "]"}]}], "//.", 
        RowBox[{"Union", "[", 
         RowBox[{"param", ",", "coefInf"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"BCs", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Xi]", "[", "rInf", "]"}], "\[Equal]", "\[Xi]Inf"}], "/.", 
          RowBox[{"r", "\[Rule]", "rInf"}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"\[Xi]", "'"}], "[", "rInf", "]"}], "==", 
           RowBox[{"D", "[", 
            RowBox[{"\[Xi]Inf", ",", "r"}], "]"}]}], "/.", 
          RowBox[{"r", "->", "rInf"}]}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"sol", "=", 
       RowBox[{"NDSolve", "[", 
        RowBox[{
         RowBox[{"Union", "[", 
          RowBox[{"EQs", ",", "BCs"}], "]"}], ",", "\[Xi]", ",", 
         RowBox[{"{", 
          RowBox[{"r", ",", "rInf", ",", "rHor"}], "}"}], ",", "rules"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"\[Psi]n", "=", 
       RowBox[{
        RowBox[{"\[Xi]", "[", "r", "]"}], "/.", 
        RowBox[{"sol", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Membrane", " ", 
        RowBox[{"paradigm", "'"}], "s", " ", "BC"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"\[CapitalDelta]\[Psi]p", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{"\[Psi]n", ",", "r"}], "]"}], 
          RowBox[{"f", "[", "r", "]"}]}], "-", 
         RowBox[{"\[Alpha]", " ", "\[Psi]n"}]}], "/.", 
        RowBox[{"Union", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"r", "\[Rule]", "rHor"}], "}"}], ",", "param"}], "]"}]}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"{", "\[CapitalDelta]\[Psi]p", "}"}]}]}], "\[IndentingNewLine]",
     "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9929434800455894`*^9, 3.992943510524275*^9}, {
