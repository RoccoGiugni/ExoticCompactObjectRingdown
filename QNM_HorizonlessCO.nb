Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Integrator", " ", "V1"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"IntQNM", "[", 
    RowBox[{"\[Omega]0_", ",", "value_", ",", "coefInf_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "rules", ",", "param", ",", "rHor", ",", "rInf", ",", "\[Xi]", ",", 
       "\[Xi]Inf", ",", "EQs", ",", "BCs", ",", "ordInf"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rules", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"AccuracyGoal", "\[Rule]", "12"}], ",", 
         RowBox[{"PrecisionGoal", "\[Rule]", "12"}], ",", 
         RowBox[{"WorkingPrecision", "->", "MachinePrecision"}]}], "}"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"param", "=", 
       RowBox[{"Union", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"M", "->", "1"}], ",", 
           RowBox[{"\[Omega]", "->", "\[Omega]0"}], ",", 
           RowBox[{
            RowBox[{"gInf", "[", "0", "]"}], "->", "1"}]}], "}"}], ",", 
         RowBox[{"Thread", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"l", ",", "\[Eta]", ",", "\[Epsilon]", ",", "inf"}], 
            "}"}], "->", "value"}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"rHor", "=", 
       RowBox[{
        RowBox[{"2", "M", 
         RowBox[{"(", 
          RowBox[{"1", "+", "\[Epsilon]"}], ")"}]}], "/.", "param"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rInf", "=", 
       RowBox[{
        RowBox[{"inf", "\[Times]", "M"}], "/.", "param"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"EQs", "=", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"EQ", "==", "0"}], "}"}], "//.", 
        RowBox[{"Union", "[", 
         RowBox[{"param", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"\[Psi]", "[", "r", "]"}], "->", 
             RowBox[{"\[Xi]", "[", "r", "]"}]}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"\[Psi]", "'"}], "[", "r", "]"}], "->", 
             RowBox[{
              RowBox[{"\[Xi]", "'"}], "[", "r", "]"}]}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"\[Psi]", "''"}], "[", "r", "]"}], "->", 
             RowBox[{
              RowBox[{"\[Xi]", "''"}], "[", "r", "]"}]}]}], "}"}]}], 
         "]"}]}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Integration", " ", "from", " ", "infinity"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"ordInf", "=", 
       RowBox[{"Length", "[", "coefInf", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"\[Xi]Inf", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"\[ImaginaryI]", " ", "\[Omega]", " ", 
           RowBox[{"rs", "[", "r", "]"}]}], "]"}], 
         RowBox[{"Sum", "[", 
          RowBox[{
           FractionBox[
            RowBox[{"gInf", "[", "i", "]"}], 
            SuperscriptBox["r", "i"]], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "0", ",", "ordInf"}], "}"}]}], "]"}]}], "//.", 
        RowBox[{"Union", "[", 
         RowBox[{"param", ",", "coefInf"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"BCs", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Xi]", "[", "rInf", "]"}], "\[Equal]", "\[Xi]Inf"}], "/.", 
          RowBox[{"r", "\[Rule]", "rInf"}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"\[Xi]", "'"}], "[", "rInf", "]"}], "==", 
           RowBox[{"D", "[", 
            RowBox[{"\[Xi]Inf", ",", "r"}], "]"}]}], "/.", 
          RowBox[{"r", "->", "rInf"}]}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"sol", "=", 
       RowBox[{"NDSolve", "[", 
        RowBox[{
         RowBox[{"Union", "[", 
          RowBox[{"EQs", ",", "BCs"}], "]"}], ",", "\[Xi]", ",", 
         RowBox[{"{", 
          RowBox[{"r", ",", "rInf", ",", "rHor"}], "}"}], ",", "rules"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"\[Psi]n", "=", 
       RowBox[{
        RowBox[{"\[Xi]", "[", "r", "]"}], "/.", 
        RowBox[{"sol", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Membrane", " ", 
        RowBox[{"paradigm", "'"}], "s", " ", "BC"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"\[CapitalDelta]\[Psi]p", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{"\[Psi]n", ",", "r"}], "]"}], 
          RowBox[{"f", "[", "r", "]"}]}], "-", 
         RowBox[{"\[Alpha]", " ", "\[Psi]n"}]}], "/.", 
        RowBox[{"Union", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"r", "\[Rule]", "rHor"}], "}"}], ",", "param"}], "]"}]}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"{", "\[CapitalDelta]\[Psi]p", "}"}]}]}], "\[IndentingNewLine]",
     "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9929434800455894`*^9, 3.992943510524275*^9}, {
   3.9929435736849613`*^9, 3.9929435993396664`*^9}, {3.9929436635139275`*^9, 
   3.992943774179348*^9}, {3.99294388860557*^9, 3.9929439559446335`*^9}, {
