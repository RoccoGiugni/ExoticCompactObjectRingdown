Cell[CellGroupData[{

Cell["File: \
\[OpenCurlyDoubleQuote]QNM_ECO1_heoc_6.m\[CloseCurlyDoubleQuote]", \
"Subsubsection",
 CellChangeTimes->{{4.0021770114541073`*^9, 4.0021770233323708`*^9}, {
  4.0022621004631367`*^9, 4.0022621165245*^9}, {4.002262488138748*^9, 
  4.0022624893216248`*^9}},ExpressionUUID->"b615712b-a3b5-0345-b334-\
a315b8c0fee3"],

Cell[TextData[{
 "Starting from \[Eta] \[Tilde] 0. Already at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Epsilon]", "=", 
    SuperscriptBox["10", 
     RowBox[{"9", "+", 
      RowBox[{"1", "/", "2"}]}]]}], TraditionalForm]],ExpressionUUID->
  "06b519e8-3ef4-4642-afec-a6c5aa1014b7"],
 " it gives the same result for the first values of \[Eta]. For \[Eta] \
\[Tilde] [0.01954, 0.01989] the result seems to acquire physical meaning, but \
higher \[Eta] still give strange results."
}], "Text",
 CellChangeTimes->{{4.0013919146782646`*^9, 4.0013919261733437`*^9}, {
  4.0013919573689175`*^9, 4.0013920005103607`*^9}, {4.001392110085863*^9, 
  4.0013921103426647`*^9}, {4.0013921914922276`*^9, 4.001392222266323*^9}, {
  4.001392308906761*^9, 4.001392309050167*^9}, {4.001398442182722*^9, 
  4.0013984430441895`*^9}, {4.0014807565840855`*^9, 4.001480788733906*^9}, {
  4.0014808762641296`*^9, 4.0014809349140263`*^9}, {4.0014809715729237`*^9, 
  4.001481150161316*^9}, {4.001481773310524*^9, 4.001481891789221*^9}, {
  4.002262755014759*^9, 4.002262757623188*^9}, {4.0027078583271065`*^9, 
  4.0027078593674603`*^9}},ExpressionUUID->"4320b290-c5a3-f742-8c54-\
d88ff37aaa1e"],

