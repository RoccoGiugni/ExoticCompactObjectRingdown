Cell[CellGroupData[{

Cell["QNM finder", "Subsection",
 CellChangeTimes->{{3.992943434254656*^9, 
  3.9929434453448944`*^9}},ExpressionUUID->"8b8b0c00-28dd-b545-a10d-\
7a318135b5dd"],

Cell["\<\
The functions to integrate the Regge-Wheeler equation and to find QNMs are \
implemented in \[OpenCurlyDoubleQuote]QNM_Compute.nb\[CloseCurlyDoubleQuote] \
in a generalized form.
Here follow components specific for non-spinning ECOs, referring to the \
approximate solutions computed in the previous Sections.

!! NOTE: when running a computation check out everything necessary has been \
defined. !!\
\>", "Text",
 CellChangeTimes->{{4.003317942318468*^9, 4.0033180079520664`*^9}, {
   4.0033180381355095`*^9, 4.003318180229126*^9}, {4.0033183564773026`*^9, 
   4.0033184802417927`*^9}, {4.003318648545347*^9, 4.003318653953327*^9}, {
   4.0034663254525948`*^9, 4.003466358628134*^9}, 
   4.0034664645507317`*^9},ExpressionUUID->"0df5b381-f3bc-8848-b661-\
f003b122b961"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"SubsHE", "[", "in_", "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Eta]", "->", 
       RowBox[{"in", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", 
      RowBox[{"eps", "->", 
       RowBox[{"in", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}]}], ";"}], 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "maybe", " ", "this", " ", "definition", " ", "can", " ", "be", " ", 
     "avoided"}], "..."}], " ", "*)"}]}]], "Input",
