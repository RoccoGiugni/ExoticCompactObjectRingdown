                   RowBox[{"i", ",", "j"}], "]"}], "]"}]}], "]"}]}], "]"}]}], 
            ";", "\[IndentingNewLine]", 
            RowBox[{"\[Omega]guess", "=", 
             RowBox[{"\[Omega]new", "[", 
              RowBox[{"[", 
               RowBox[{"j", ",", "i", ",", "3"}], "]"}], "]"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", 
