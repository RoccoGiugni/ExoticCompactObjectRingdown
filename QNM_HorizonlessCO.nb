In[11]:=",ExpressionUUID->"7655d179-ace4-124f-b56b-fb67adaf9bd0"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Regge-Wheeler equation:\\n \"\>", "\[InvisibleSpace]", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             FractionBox[
              RowBox[{"6", " ", "M"}], 
              SuperscriptBox["r", "3"]]}], "+", 
            FractionBox[
             RowBox[{"l", " ", 
              RowBox[{"(", 
               RowBox[{"1", "+", "l"}], ")"}]}], 
             SuperscriptBox["r", "2"]]}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            FractionBox[
             RowBox[{"2", " ", "M"}], "r"]}], ")"}]}], ")"}]}], "+", 
       SuperscriptBox["\[Omega]", "2"]}], ")"}], " ", 
     RowBox[{"\[Psi]", "[", "r", "]"}]}], "+", 
    FractionBox[
     RowBox[{"2", " ", "M", " ", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        FractionBox[
         RowBox[{"2", " ", "M"}], "r"]}], ")"}], " ", 
      RowBox[{
       SuperscriptBox["\[Psi]", "\[Prime]",
        MultilineFunction->None], "[", "r", "]"}]}], 
     SuperscriptBox["r", "2"]], "+", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "-", 
        FractionBox[
         RowBox[{"2", " ", "M"}], "r"]}], ")"}], "2"], " ", 
     RowBox[{
      SuperscriptBox["\[Psi]", "\[Prime]\[Prime]",
       MultilineFunction->None], "[", "r", "]"}]}]}], 
   "\[InvisibleSpace]", "\<\" = 0\"\>"}],
  SequenceForm[
  "Regge-Wheeler equation:\n ", ((-((-6) $CellContext`M $CellContext`r^(-3) + \
$CellContext`l (1 + $CellContext`l) $CellContext`r^(-2))) (1 - 
       2 ($CellContext`M/$CellContext`r)) + $CellContext`\[Omega]^2) \
$CellContext`\[Psi][$CellContext`r] + 
   2 $CellContext`M (1 - 
     2 ($CellContext`M/$CellContext`r)) $CellContext`r^(-2) 
    Derivative[
     1][$CellContext`\[Psi]][$CellContext`r] + (1 - 
      2 ($CellContext`M/$CellContext`r))^2 
    Derivative[2][$CellContext`\[Psi]][$CellContext`r], " = 0"],
  Editable->False]], "Print",
 CellChangeTimes->{
  4.000203422272314*^9, {4.000203514487383*^9, 4.000203529201166*^9}},
 CellLabel->
  "During evaluation of \
In[11]:=",ExpressionUUID->"0e5a71e6-c1c4-0646-962a-39c9d34146de"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Inner Boundary Condition", "Subsection",
 CellChangeTimes->{{3.998555659327261*^9, 
  3.9985557084369373`*^9}},ExpressionUUID->"b91659d4-11ce-6a4f-a010-\
166eb66632af"],

Cell[TextData[{
 "Since the object has no horizon the inner boundary (obviously) is set by \
its radius ",
 Cell[BoxData[
  SubscriptBox["r", "CO"]], "InlineCode",ExpressionUUID->
  "70290313-64b3-2148-a122-75bf357f7032"],
 ".\nThe outer boundary condition of a Schwarzschild BH is valid also in this \
case.\n\nMagari implementare espansione in serie con funzione integrata \
sotto.\n\nCercare QNMs al variare di eps (fino a 1, i.e. stella di neutroni) \
e eta (tra 0 a 1/16\[Pi]) con griglia abbastanza fitta e vedere la dipendenza \
del QNM da eps e eta. Se ci sono discontinuit\[AGrave] \[EGrave] perch\
\[EAcute] trova altri QNM (e.g. overtone) \[Rule] griglia pi\[UGrave] fitta."
}], "Text",
 CellChangeTimes->{{3.998555730550535*^9, 3.998555940439806*^9}, {
  3.999062245416689*^9, 
  3.9990624364018326`*^9}},ExpressionUUID->"109951b4-9c1d-a447-b63c-\
3c4b5cc91a2a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Membrane", " ", 
     RowBox[{"paradigm", "'"}], "s", " ", "BC", " ", "from", " ", 
     RowBox[{"Eq", ".", " ", "11"}], " ", "of", " ", 
     RowBox[{"https", ":"}]}], "//", 
    RowBox[{
     RowBox[{
      RowBox[{"arxiv", ".", "org"}], "/", "pdf"}], "/", "2006.14628"}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Alpha]", "=", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        FractionBox[
         RowBox[{"\[ImaginaryI]", " ", "\[Omega]"}], 
         RowBox[{"16", "\[Pi]", " ", "\[Eta]"}]]}], "-", 
       RowBox[{
        FractionBox[
         SuperscriptBox["r", "2"], 
         RowBox[{"2", 
          RowBox[{"(", 
           RowBox[{"r", "-", 
            RowBox[{"3", "M"}]}], ")"}]}]], "V"}]}], ")"}]}], ";"}], 
   RowBox[{"(*", " ", 
    RowBox[{"\[Rule]", " ", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]\[Omega]"}], " ", "in", " ", "the", " ", 
      "BH", " ", "case"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"\[Psi]MP", "=", 
    RowBox[{
     RowBox[{"\[Psi]", "[", "r", "]"}], "/.", 
     RowBox[{
      RowBox[{"DSolve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"\[Psi]", "'"}], "[", "r", "]"}], 
           RowBox[{"f", "[", "r", "]"}]}], "==", 
          RowBox[{"\[Alpha]", " ", 
           RowBox[{"\[Psi]", "[", "r", "]"}]}]}], "}"}], ",", 
        RowBox[{"\[Psi]", "[", "r", "]"}], ",", "r"}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}]}]}]}]}]], "Input",
 CellChangeTimes->{{3.9985559572814407`*^9, 3.9985560016284924`*^9}, {
