Cell[CellGroupData[{

Cell["Numerical stability", "Section",
 CellChangeTimes->{{4.002358713124935*^9, 4.002358719878807*^9}, {
  4.0023587553530216`*^9, 4.002358780823002*^9}, {4.0034876577931843`*^9, 
  4.0034876644440937`*^9}},ExpressionUUID->"e9fc8fcd-7ba4-274b-80eb-\
b7c0e429d051"],

Cell["\<\
In this Section the QNM finder is tested against different sets of its \
hyperparameters. The latter are the \[OpenCurlyQuote]integration parameters\
\[CloseCurlyQuote] defining numerically the point of match (\[Mu]) and \
infinity (\[Iota]), and the order at which the series expansion at the \
horizon and at infinity are truncated.

In the case of \[OpenCurlyQuote]integration parameters\[CloseCurlyQuote] the \
space is explored randomly. See `QNM_Compute.nb` for the functions handling \
the sampling and the computation.\
\>", "Text",
 CellChangeTimes->{{4.002952471921526*^9, 4.002952518150999*^9}, {
  4.002952554910614*^9, 4.002952740445652*^9}, {4.0034929305349064`*^9, 
  4.003492937702442*^9}, {4.0034931370868587`*^9, 4.003493156126766*^9}, {
  4.003493207874487*^9, 
  4.0034932963087673`*^9}},ExpressionUUID->"6597b467-ab43-6147-8146-\
cb1aba0d6ffc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"-", " ", 
      RowBox[{"MultiPlot", " ", "--"}]}]}], "-"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "xs", " ", "are", " ", "supposed", " ", "to", " ", "be", " ", "the", " ", 
    "first", " ", "n", " ", "element", " ", "of", " ", "each", " ", "data", " ",
     "point"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"MultiPlot", "[", 
     RowBox[{"data_", ",", "iy_", ",", "n_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"plots", ",", "l", ",", "s", ",", "point"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"plots", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"l", "=", 
           RowBox[{"Extract", "[", 
            RowBox[{"label", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", "ix", "}"}], ",", 
               RowBox[{"{", "iy", "}"}]}], "}"}]}], "]"}]}], ";", 
          RowBox[{"s", "=", 
           RowBox[{"Extract", "[", 
            RowBox[{"scale", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", "ix", "}"}], ",", 
               RowBox[{"{", "iy", "}"}]}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"point", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Extract", "[", 
              RowBox[{"j", ",", 
               RowBox[{"{", 
                RowBox[{";;", ",", 
                 RowBox[{"{", 
                  RowBox[{"ix", ",", "iy"}], "}"}]}], "}"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "data"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"plots", ",", 
            RowBox[{"ListPlot", "[", 
             RowBox[{"point", ",", 
              RowBox[{"AxesLabel", "->", "l"}], ",", 
              RowBox[{"ScalingFunctions", "->", "s"}], ",", 
              RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"ix", ",", "n"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "plots", "]"}], ";"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{4.0029530879054375`*^9, 4.002953219788595*^9}, {
   4.002953294908287*^9, 4.0029534604551697`*^9}, {4.0029534954100037`*^9, 
