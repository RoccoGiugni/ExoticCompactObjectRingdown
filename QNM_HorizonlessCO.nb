Cell[CellGroupData[{

Cell["QNM finder", "Subsection",
 CellChangeTimes->{{3.992943434254656*^9, 
  3.9929434453448944`*^9}},ExpressionUUID->"8b8b0c00-28dd-b545-a10d-\
7a318135b5dd"],

Cell["\<\
The functions to integrate the Regge-Wheeler equation and to find QNMs are \
implemented in \[OpenCurlyDoubleQuote]QNM_Compute.nb\[CloseCurlyDoubleQuote] \
in a generalized form.
Here follow components specific for non-spinning ECOs, referring to the \
approximate solutions computed in the previous Sections. 

!! NOTE: when running a computation check out everything necessary has been \
defined. !!\
\>", "Text",
 CellChangeTimes->{{4.003317942318468*^9, 4.0033180079520664`*^9}, {
  4.0033180381355095`*^9, 4.003318180229126*^9}, {4.0033183564773026`*^9, 
  4.0033184802417927`*^9}, {4.003318648545347*^9, 
  4.003318653953327*^9}},ExpressionUUID->"0df5b381-f3bc-8848-b661-\
f003b122b961"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"SubsHE", "[", "in_", "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Eta]", "->", 
       RowBox[{"in", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", 
      RowBox[{"eps", "->", 
       RowBox[{"in", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}]}], ";"}], 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "maybe", " ", "this", " ", "definition", " ", "can", " ", "be", " ", 
     "avoided"}], "..."}], " ", "*)"}]}]], "Input",
 CellChangeTimes->{{4.0033036274712467`*^9, 4.0033036669019165`*^9}, {
  4.0033188655042057`*^9, 4.003318886736595*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"59e47643-6f0f-ad4d-934a-d4b5f7d4f748"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"-", " ", 
      RowBox[{"EcoBC", " ", "--"}]}]}], "-"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"coefI", "  ", ":", " ", 
    RowBox[{"empty", " ", "list", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
       "the", " ", "horizon", " ", "BC", " ", "is", " ", "completely", " ", 
        "defined", " ", "inside"}], " ", "-", " ", 
       RowBox[{"here", " ", "for", " ", "compatibility"}]}], ")"}]}]}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"coefE", "  ", ":", " ", 
    RowBox[{
    "list", " ", "of", " ", "substitution", " ", "rules", " ", "for", " ", 
     "the", " ", "series", " ", "coefficients", " ", "at", " ", 
     "infinity"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"output", " ", ":", " ", 
    RowBox[{
    "list", " ", "of", " ", "two", " ", "boundary", " ", "conditions", " ", 
     RowBox[{"(", 
      RowBox[{"see", " ", 
       RowBox[{"QNM_Compute", ".", "nb"}], " ", "for", " ", "applications"}], 
      ")"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"EcoBC", "[", 
     RowBox[{"coefI_", ",", "coefE_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ordI", ",", "bcI", ",", "ordE", ",", "bcE"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"k", "=", 
        FractionBox["\[Omega]", 
         RowBox[{"16", "\[Pi]", " ", "\[Eta]"}]]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ordI", "=", 
        RowBox[{"Length", "[", "coefI", "]"}]}], ";", 
       RowBox[{"bcI", "=", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "\[ImaginaryI]"}], " ", "k", " ", 
           RowBox[{"rs", "[", "r", "]"}]}], "]"}], 
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"r", "-", 
             RowBox[{"3", "M"}]}], ")"}], 
           RowBox[{
            FractionBox[
             RowBox[{"l", 
              RowBox[{"(", 
               RowBox[{"l", "+", "1"}], ")"}]}], "2"], "-", "1"}]], "/", 
          "r"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"ordE", "=", 
        RowBox[{"Length", "[", "coefE", "]"}]}], ";", 
       RowBox[{"bcE", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"\[ImaginaryI]", " ", "\[Omega]", " ", 
            RowBox[{"rs", "[", "r", "]"}]}], "]"}], 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"gInf", "[", "i", "]"}], 
             SuperscriptBox["r", 
              RowBox[{"-", "i"}]]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "0", ",", "ordE"}], "}"}]}], "]"}]}], "//.", 
         "coefE"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"Return", "[", 
        RowBox[{"{", 
         RowBox[{"bcI", ",", "bcE"}], "}"}], "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{4.003317760079479*^9, 4.003317859996565*^9}, {
  4.0033765685485916`*^9, 4.0033765695250435`*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"e2b2450c-51e9-a54e-a45e-5c398f4f18a3"],

