    RowBox[{"--", 
     RowBox[{"-", " ", 
      RowBox[{"EcoBC", " ", "--"}]}]}], "-"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"coefI", "  ", ":", " ", 
    RowBox[{"empty", " ", "list", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
       "the", " ", "horizon", " ", "BC", " ", "is", " ", "completely", " ", 
