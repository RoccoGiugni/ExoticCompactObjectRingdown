794b13aea3c2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FindQNM", "[", 
   RowBox[{"\[Omega]guess_", ",", "ECO_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"g", ",", "\[Omega]root"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"g", "[", 
       RowBox[{"x_", "?", "NumericQ"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"IntQNM", "[", 
        RowBox[{"x", ",", "ECO", ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "10", ",", "50"}], "}"}], ",", "coefInf"}], "]"}],
        "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", 
     RowBox[{"(*", " ", 
      RowBox[{
      "watch", " ", "out", " ", "for", " ", "differences", " ", "in", " ", 
       "input", " ", "parameters"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"\[Omega]root", "=", 
      RowBox[{"x", "/.", 
       RowBox[{
        RowBox[{"FindRoot", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"g", "[", "x", "]"}], "\[Equal]", "0"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "\[Omega]guess"}], "}"}], ",", 
          RowBox[{"AccuracyGoal", "\[Rule]", "6"}], ",", 
          RowBox[{"WorkingPrecision", "\[Rule]", "20"}]}], 
         RowBox[{"(*", 
          RowBox[{",", 
           RowBox[{"EvaluationMonitor", ":>", 
            RowBox[{"Print", "[", 
             
             RowBox[{"\"\<\[Omega] = \>\"", ",", " ", "x", 
              ",", "\"\< \[CapitalDelta]\[Psi]' = \>\"", ",", 
              RowBox[{"Abs", "[", 
               RowBox[{"g", "[", "x", "]"}], "]"}]}], "]"}]}]}], "*)"}], 
         "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Return", "[", 
      RowBox[{"{", 
       RowBox[{"\[Omega]root", ",", 
        RowBox[{"Abs", "[", 
         RowBox[{"g", "[", "\[Omega]root", "]"}], "]"}]}], "}"}], "]"}], 
     ";"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
