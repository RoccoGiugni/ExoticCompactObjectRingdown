Cell[CellGroupData[{

Cell["Computing the QNMs", "Section",
 CellChangeTimes->{{3.992945228529789*^9, 
  3.992945240956333*^9}},ExpressionUUID->"cd531f92-8b15-d84a-9254-\
614328658e8e"],

Cell["\<\
Follows the implementation of part of the QNM calculation method. We emulate \
the method used in the non-rotating BH case.

This Section focuses on the search for approximate solutions near the ECO\
\[CloseCurlyQuote]s surface and at infinity. BCs near the surface are the \
membrane paradigm\[CloseCurlyQuote]s BC itself and its analytical solution.
Check \[OpenCurlyDoubleQuote]QNM_Compute.nb\[CloseCurlyDoubleQuote] for the \
actual integrator and finder.\
\>", "Text",
 CellChangeTimes->{{4.0029640498406544`*^9, 4.002964088552244*^9}, {
  4.0029641760731144`*^9, 4.002964179662979*^9}, {4.0029642662996216`*^9, 
  4.002964267762886*^9}, {4.0029643529126205`*^9, 4.0029643703779163`*^9}, {
  4.003318204959301*^9, 4.0033183278387947`*^9}, {4.0033186958870335`*^9, 
  4.0033187655138435`*^9}},ExpressionUUID->"aef7a1f6-3d89-164a-9c68-\
62f658cd311f"],

