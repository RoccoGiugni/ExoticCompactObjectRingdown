    "first", " ", "\[Eta]", " ", "and", " ", "last", " ", "\[Epsilon]"}], " ",
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Omega]new", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "\[Epsilon]array"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "\[Eta]array"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Monitor", "[", 
     RowBox[{
      RowBox[{"Do", "[", 
