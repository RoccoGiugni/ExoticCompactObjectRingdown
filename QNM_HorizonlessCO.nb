   4.0033021895189705`*^9}, {4.003302904062748*^9, 4.0033029079107265`*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"9a30aa10-9cd8-d445-b40e-857123c943e2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Print", "[", 
