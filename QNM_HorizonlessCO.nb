Cell["\<\
INTEGRATOR VERSION 2

We emulate the method used in the non-rotating BH case (see \
QNM_Schwarzschild_FV.nb).
The BCs at the horizon are the membrane paradigm\[CloseCurlyQuote]s BC itself \
and its analytical solution.
The output is the derivative deviation at the match point.\
\>", "Text",
 CellChangeTimes->{{3.9929443003446407`*^9, 3.992944310986555*^9}, {
  3.9929443486826344`*^9, 3.992944352907881*^9}, {3.9929444022599335`*^9, 
  3.9929446186594315`*^9}, {3.9929446634267178`*^9, 3.992944729824745*^9}, {
  3.992944844835047*^9, 3.992945129286682*^9}, {3.992945160599123*^9, 
  3.9929451830699787`*^9}, {3.9990722243618393`*^9, 3.9990722316976776`*^9}, {
  3.999072535977213*^9, 3.9990727624625626`*^9}, {3.9990744797074738`*^9, 
  3.9990744812687035`*^9}, {3.999074757717308*^9, 
  3.9990747969285717`*^9}},ExpressionUUID->"2b082cce-a800-bf4a-b629-\
d397c762b6da"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Integrator", " ", "V2"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"IntQNM", "[", 
    RowBox[{"\[Omega]0_", ",", "ECO_", ",", "value_", ",", "coefInf_"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "rules", ",", "param", ",", "rHor", ",", "rm", ",", "rInf", ",", 
       "\[Xi]", ",", "\[Xi]Hor", ",", "\[Xi]Inf", ",", "EQs", ",", "BCs", ",",
        "ordInf"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rules", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"AccuracyGoal", "\[Rule]", "12"}], ",", 
         RowBox[{"PrecisionGoal", "\[Rule]", "12"}], ",", 
         RowBox[{"WorkingPrecision", "->", "20"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"param", "=", 
       RowBox[{"Union", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"M", "->", "1"}], ",", 
           RowBox[{"\[Omega]", ":>", 
            RowBox[{"SetPrecision", "[", 
             RowBox[{"\[Omega]0", ",", 
              RowBox[{"Max", "[", 
               RowBox[{
                RowBox[{"Precision", "[", "\[Omega]0", "]"}], ",", "20"}], 
               "]"}]}], "]"}]}], ",", 
           RowBox[{
            RowBox[{"gInf", "[", "0", "]"}], "->", "1"}]}], "}"}], ",", 
         RowBox[{"Thread", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\[Eta]", ",", "\[Epsilon]"}], "}"}], "->", "ECO"}], 
          "]"}], ",", 
         RowBox[{"Thread", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"l", ",", "match", ",", "inf"}], "}"}], "->", "value"}], 
          "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"rHor", "=", 
       RowBox[{
        RowBox[{"2", "M", 
         RowBox[{"(", 
          RowBox[{"1", "+", "\[Epsilon]"}], ")"}]}], "/.", "param"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rm", "=", 
       RowBox[{
        RowBox[{"match", "\[Times]", "M"}], "/.", "param"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rInf", "=", 
       RowBox[{
        RowBox[{"inf", "\[Times]", "M"}], "/.", "param"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"EQs", "=", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"EQ", "==", "0"}], "}"}], "//.", 
        RowBox[{"Union", "[", 
         RowBox[{"param", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"\[Psi]", "[", "r", "]"}], "->", 
             RowBox[{"\[Xi]", "[", "r", "]"}]}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"\[Psi]", "'"}], "[", "r", "]"}], "->", 
             RowBox[{
              RowBox[{"\[Xi]", "'"}], "[", "r", "]"}]}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"\[Psi]", "''"}], "[", "r", "]"}], "->", 
             RowBox[{
              RowBox[{"\[Xi]", "''"}], "[", "r", "]"}]}]}], "}"}]}], 
         "]"}]}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Integration", " ", "from", " ", "the", " ", "horizon"}], " ", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"\[Xi]Hor", "=", 
       RowBox[{
        RowBox[{"Exp", "[", 
         FractionBox[
          RowBox[{
           RowBox[{
            RowBox[{"-", "16"}], " ", "\[Pi]", " ", "\[Eta]", " ", 
            RowBox[{"Log", "[", "r", "]"}]}], "-", 
           RowBox[{"8", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "2"}], "+", "l", "+", 
              SuperscriptBox["l", "2"]}], ")"}], " ", "\[Pi]", " ", "\[Eta]", 
            " ", 
            RowBox[{"Log", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "3"}], " ", "M"}], "+", "r"}], "]"}]}], "-", 
           RowBox[{"\[ImaginaryI]", " ", "\[Omega]", " ", 
            RowBox[{"(", 
             RowBox[{"r", "+", 
              RowBox[{"2", " ", "M", " ", 
               RowBox[{"Log", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"-", "2"}], " ", "M"}], "+", "r"}], "]"}]}]}], 
             ")"}]}]}], 
          RowBox[{"16", " ", "\[Pi]", " ", "\[Eta]"}]], "]"}], "//.", 
        "param"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"BCs", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Xi]", "[", "rHor", "]"}], "==", "\[Xi]Hor"}], "/.", 
          RowBox[{"r", "->", "rHor"}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"\[Xi]", "'"}], "[", "rHor", "]"}], "==", 
           RowBox[{"D", "[", 
            RowBox[{"\[Xi]Hor", ",", "r"}], "]"}]}], "/.", 
          RowBox[{"r", "->", "rHor"}]}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"solHor", "=", 
       RowBox[{"NDSolve", "[", 
        RowBox[{
         RowBox[{"Union", "[", 
          RowBox[{"EQs", ",", "BCs"}], "]"}], ",", "\[Xi]", ",", 
         RowBox[{"{", 
          RowBox[{"r", ",", "rHor", ",", "rm"}], "}"}], ",", "rules"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"\[Psi]Hor", "=", 
       RowBox[{
        RowBox[{"\[Xi]", "[", "r", "]"}], "/.", 
        RowBox[{"solHor", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Integration", " ", "from", " ", "infinity"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"ordInf", "=", 
       RowBox[{"Length", "[", "coefInf", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"\[Xi]Inf", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"\[ImaginaryI]", " ", "\[Omega]", " ", 
           RowBox[{"rs", "[", "r", "]"}]}], "]"}], 
         RowBox[{"Sum", "[", 
          RowBox[{
           FractionBox[
            RowBox[{"gInf", "[", "i", "]"}], 
            SuperscriptBox["r", "i"]], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "0", ",", "ordInf"}], "}"}]}], "]"}]}], "//.", 
        RowBox[{"Union", "[", 
         RowBox[{"param", ",", "coefInf"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"BCs", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Xi]", "[", "rInf", "]"}], "\[Equal]", "\[Xi]Inf"}], "/.", 
          RowBox[{"r", "\[Rule]", "rInf"}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"\[Xi]", "'"}], "[", "rInf", "]"}], "==", 
           RowBox[{"D", "[", 
            RowBox[{"\[Xi]Inf", ",", "r"}], "]"}]}], "/.", 
          RowBox[{"r", "->", "rInf"}]}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"solInf", "=", 
       RowBox[{"NDSolve", "[", 
        RowBox[{
         RowBox[{"Union", "[", 
          RowBox[{"EQs", ",", "BCs"}], "]"}], ",", "\[Xi]", ",", 
         RowBox[{"{", 
          RowBox[{"r", ",", "rInf", ",", "rHor"}], "}"}], ",", "rules"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"\[Psi]Inf", "=", 
       RowBox[{
        RowBox[{"\[Xi]", "[", "r", "]"}], "/.", 
        RowBox[{"solInf", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Linear", " ", "combination"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"b", "=", 
       RowBox[{
        FractionBox["\[Psi]Hor", "\[Psi]Inf"], "/.", 
        RowBox[{"r", "\[Rule]", "rm"}]}]}], ";", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "we", " ", "fix", " ", "the", " ", "coefficients", " ", "of", " ", 
         "the", " ", "linear", " ", "combination", " ", "in", " ", "order", " ",
          "for", " ", "\[Psi]n", " ", "to", " ", "be", " ", "continuous", " ",
          "at", " ", "r"}], "=", "rm"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"\[Psi]n", "=", 
       RowBox[{"Piecewise", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[Psi]Hor", ",", 
            RowBox[{"r", "<", "rm"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"b", "\[Times]", "\[Psi]Inf"}], ",", 
            RowBox[{"r", "\[GreaterEqual]", "rm"}]}], "}"}]}], "}"}], "]"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"\[CapitalDelta]\[Psi]p", "=", 
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{"\[Psi]Hor", ",", "r"}], "]"}], "-", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"b", " ", "\[Psi]Inf"}], ",", "r"}], "]"}]}], 
         RowBox[{"D", "[", 
          RowBox[{"\[Psi]Hor", ",", "r"}], "]"}]], "/.", 
        RowBox[{"r", "\[Rule]", "rm"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"{", "\[CapitalDelta]\[Psi]p", "}"}]}]}], "\[IndentingNewLine]",
     "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9929434800455894`*^9, 3.992943510524275*^9}, {
   3.9929435736849613`*^9, 3.9929435993396664`*^9}, {3.9929436635139275`*^9, 
