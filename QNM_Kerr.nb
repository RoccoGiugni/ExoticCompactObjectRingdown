Cell[BoxData[{
 RowBox[{
  RowBox[{"ap", "=", 
   RowBox[{"Max", "[", 
    RowBox[{
     RowBox[{"Abs", "[", "m", "]"}], ",", 
     RowBox[{"Abs", "[", "s", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"am", "=", 
   FractionBox[
    RowBox[{"m", " ", "s"}], 
    RowBox[{"Max", "[", 
     RowBox[{
      RowBox[{"Abs", "[", "m", "]"}], ",", 
      RowBox[{"Abs", "[", "s", "]"}]}], "]"}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"h", "[", "l_", "]"}], ":=", 
   FractionBox[
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["l", "2"], "-", 
       SuperscriptBox["ap", "2"]}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["l", "2"], "-", 
