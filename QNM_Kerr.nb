Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Series", " ", "coefficients"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"CoefHor", "[", "ord_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"H", ",", "CT", ",", "s1", ",", "s2"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"H", "[", "r_", "]"}], ":=", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"hHor", "[", "i", "]"}], 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"r", "-", 
             RowBox[{"2", " ", "M"}]}], ")"}], "i"]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", 
           RowBox[{"ord", "+", "5"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"CT", "=", 
       RowBox[{"l", 
        RowBox[{"(", 
         RowBox[{"l", "+", "1"}], ")"}], 
        SuperscriptBox["r", "7"], "\[Omega]", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"r", "-", 
           RowBox[{"2", " ", "M"}]}], ")"}], 
         RowBox[{
          RowBox[{
          "2", " ", "M", " ", "\[ImaginaryI]", " ", "\[CapitalOmega]"}], "-", 
          "1"}]]}]}], ";", 
      RowBox[{"(*", " ", 
       RowBox[{"inverse", " ", "of", " ", "the", " ", "common", " ", "term"}],
        " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"s1", "=", 
       RowBox[{"Simplify", "[", 
        RowBox[{"Normal", "[", 
         RowBox[{"Series", "[", 
          RowBox[{
           RowBox[{"CT", "\[Times]", "sHor"}], ",", 
           RowBox[{"{", 
            RowBox[{"\[Chi]", ",", "0", ",", "1"}], "}"}]}], "]"}], "]"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"s2", "=", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"Series", "[", 
          RowBox[{
           RowBox[{"s1", "/.", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"h", "[", "r", "]"}], "->", 
               RowBox[{"H", "[", "r", "]"}]}], ",", 
              RowBox[{
               RowBox[{
