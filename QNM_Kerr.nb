Cell[CellGroupData[{

Cell["QNM finder", "Subsection",
 CellChangeTimes->{{3.9884489219885693`*^9, 
  3.988448923940319*^9}},ExpressionUUID->"8911a55b-47fc-d844-a8df-\
6a631cfd1a5b"],

Cell["\<\
The functions to integrate the Teukolsky equation and to find QNMs are \
implemented in \[OpenCurlyDoubleQuote]QNM_Compute.nb\[CloseCurlyDoubleQuote] \
in a generalized form.
Here follow components specific for spinning BHs, referring to the \
approximate solutions computed in the previous Sections.

!! NOTE: when running a computation check out everything necessary has been \
defined. !!\
\>", "Text",
 CellChangeTimes->{{4.003317942318468*^9, 4.0033180079520664`*^9}, {
   4.0033180381355095`*^9, 4.003318180229126*^9}, {4.0033183564773026`*^9, 
   4.0033184802417927`*^9}, {4.003318648545347*^9, 4.003318653953327*^9}, {
   4.0034662834741764`*^9, 4.003466307060877*^9}, {4.0034663665911713`*^9, 
   4.0034663675490704`*^9}, 
   4.003466451707802*^9},ExpressionUUID->"b01d29f9-c967-c841-bfef-\
4dcf7f9150ed"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"-", " ", 
      RowBox[{"KerrBC", " ", "--"}]}]}], "-"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"coefI", "  ", ":", " ", 
    RowBox[{
    "list", " ", "of", " ", "substitution", " ", "rules", " ", "for", " ", 
     "the", " ", "series", " ", "coefficients", " ", "at", " ", "the", " ", 
     "horizon"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"coefE", "  ", ":", " ", 
    RowBox[{
    "list", " ", "of", " ", "substitution", " ", "rules", " ", "for", " ", 
     "the", " ", "series", " ", "coefficients", " ", "at", " ", 
     "infinity"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"output", " ", ":", " ", 
    RowBox[{
    "list", " ", "of", " ", "two", " ", "boundary", " ", "conditions", " ", 
     RowBox[{"(", 
      RowBox[{"see", " ", 
       RowBox[{"QNM_Compute", ".", "nb"}], " ", "for", " ", "applications"}], 
      ")"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"KerrBC", "[", 
     RowBox[{"coefI_", ",", "coefE_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ordI", ",", "bcI", ",", "ordE", ",", "bcE"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[CapitalOmega]", "=", 
        FractionBox["a", 
         RowBox[{"2", "M", " ", "rp"}]]}], ";", 
       RowBox[{"k", "=", 
        RowBox[{"\[Omega]", "-", 
         RowBox[{"m", " ", "\[CapitalOmega]"}]}]}], ";", 
       RowBox[{"(*", " ", 
        RowBox[{"frequency", " ", "near", " ", "the", " ", "horizon"}], " ", 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"ordI", "=", 
        RowBox[{"Length", "[", "coefI", "]"}]}], ";", 
       RowBox[{"bcI", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "\[ImaginaryI]"}], " ", "k", " ", 
            RowBox[{"rs", "[", "r", "]"}]}], "]"}], 
          SuperscriptBox[
           RowBox[{"\[CapitalDelta]", "[", "r", "]"}], 
           RowBox[{
            RowBox[{"-", "s"}], "/", "2"}]], 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"hHor", "[", "i", "]"}], 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"r", "-", "rp"}], ")"}], "i"]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "0", ",", "ordI"}], "}"}]}], "]"}]}], "//.", 
         "coefI"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"ordE", "=", 
        RowBox[{"Length", "[", "coefE", "]"}]}], ";", 
       RowBox[{"bcE", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"\[ImaginaryI]", " ", "\[Omega]", " ", 
            RowBox[{"rs", "[", "r", "]"}]}], "]"}], 
          SuperscriptBox["r", 
           RowBox[{"-", "s"}]], 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"gInf", "[", "i", "]"}], 
             SuperscriptBox["r", 
              RowBox[{"-", "i"}]]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "0", ",", "ordE"}], "}"}]}], "]"}]}], "//.", 
         "coefE"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"Return", "[", 
        RowBox[{"{", 
         RowBox[{"bcI", ",", "bcE"}], "}"}], "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{4.0034660898437653`*^9, 4.003466117841074*^9}, {
  4.003466236804264*^9, 
  4.0034662413888702`*^9}},ExpressionUUID->"6b522f00-a68c-d747-9cd3-\
f811ea5d48b0"],

