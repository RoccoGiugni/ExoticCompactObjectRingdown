      "\[IndentingNewLine]", 
      RowBox[{"s", "=", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"Series", "[", 
          RowBox[{
           RowBox[{"sInf", "/.", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
