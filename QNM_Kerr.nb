Cell[BoxData[{
 RowBox[{
  RowBox[{"plots", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"index", ",", "l", ",", "s", ",", "point"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"index", "=", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"-", "1"}]}], "}"}]}], ";", 
        RowBox[{"l", "=", 
         RowBox[{"Extract", "[", 
          RowBox[{"label", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", "i", "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"-", "1"}], "}"}]}], "}"}]}], "]"}]}], ";", 
        RowBox[{"s", "=", 
         RowBox[{"Extract", "[", 
          RowBox[{"scale", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", "i", "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"-", "1"}], "}"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"point", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Extract", "[", 
            RowBox[{
             RowBox[{"Abs", "[", "data", "]"}], ",", 
             RowBox[{"{", 
              RowBox[{";;", ",", "index"}], "}"}]}], "]"}], 
           RowBox[{"(*", 
            RowBox[{",", 
             RowBox[{"Extract", "[", 
              RowBox[{"accept", ",", 
               RowBox[{"{", 
                RowBox[{";;", ",", "index"}], "}"}]}], "]"}]}], "*)"}], ",", 
           RowBox[{"Extract", "[", 
            RowBox[{"reject", ",", 
             RowBox[{"{", 
              RowBox[{";;", ",", "index"}], "}"}]}], "]"}]}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"plots", ",", 
          RowBox[{"ListPlot", "[", 
           RowBox[{"point", ",", 
            RowBox[{"AxesLabel", "->", "l"}], ",", 
            RowBox[{"ScalingFunctions", "->", "s"}], ",", 
            RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"i", ",", "3"}], "}"}]}], "]"}]}], "]"}], ";"}], 
