         RowBox[{
          RowBox[{
           RowBox[{"\[Xi]", "'"}], "[", "rInf", "]"}], "==", "BC2"}]}], 
        "}"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"\[Psi]Inf", "=", 
