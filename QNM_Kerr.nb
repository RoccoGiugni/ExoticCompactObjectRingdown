Cell[CellGroupData[{

Cell["Angular eigenvalues", "Subsection",
 CellChangeTimes->{{3.992864167385851*^9, 3.9928641700706997`*^9}, {
  3.995109585235956*^9, 
  3.9951095946333694`*^9}},ExpressionUUID->"c56777ff-4fc5-464c-b640-\
97b9f80c8d12"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ap", "=", 
   RowBox[{"Max", "[", 
    RowBox[{
     RowBox[{"Abs", "[", "m", "]"}], ",", 
     RowBox[{"Abs", "[", "s", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"am", "=", 
   FractionBox[
    RowBox[{"m", " ", "s"}], 
    RowBox[{"Max", "[", 
     RowBox[{
      RowBox[{"Abs", "[", "m", "]"}], ",", 
      RowBox[{"Abs", "[", "s", "]"}]}], "]"}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"h", "[", "l_", "]"}], ":=", 
   FractionBox[
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["l", "2"], "-", 
       SuperscriptBox["ap", "2"]}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["l", "2"], "-", 
       SuperscriptBox["am", "2"]}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["l", "2"], "-", 
       SuperscriptBox["s", "2"]}], ")"}]}], 
    RowBox[{"2", 
     RowBox[{"(", 
      RowBox[{"l", "-", 
       FractionBox["1", "2"]}], ")"}], 
     SuperscriptBox["l", "3"], 
     RowBox[{"(", 
      RowBox[{"l", "+", 
       FractionBox["1", "2"]}], ")"}]}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fslm", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"l", 
        RowBox[{"(", 
         RowBox[{"l", "+", "1"}], ")"}]}], "\[Minus]", 
       RowBox[{"s", 
        RowBox[{"(", 
         RowBox[{"s", "+", "1"}], ")"}]}]}], ",", 
      RowBox[{
       RowBox[{"\[Minus]", "2"}], 
       FractionBox[
        RowBox[{"m", " ", 
         SuperscriptBox["s", "2"]}], 
        RowBox[{"l", 
         RowBox[{"(", 
          RowBox[{"l", "+", "1"}], ")"}]}]]}], ",", 
      RowBox[{
       RowBox[{"h", "[", 
        RowBox[{"l", "+", "1"}], "]"}], "\[Minus]", 
       RowBox[{"h", "[", "l", "]"}], "\[Minus]", "1"}]}], "}"}]}], ";"}], 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"see", " ", 
     RowBox[{"Eqs", ".", " ", "2.16"}], " ", "of", " ", 
     RowBox[{"https", ":"}]}], "//", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"arxiv", ".", "org"}], "/", "pdf"}], "/", "gr"}], "-", 
     RowBox[{"qc", "/", "0511111"}]}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Aslm", "=", 
    RowBox[{"Simplify", "[", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"fslm", "[", 
         RowBox[{"[", "n", "]"}], "]"}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"a", " ", "\[Omega]"}], ")"}], 
         RowBox[{"n", "-", "1"}]]}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "1", ",", "3"}], "}"}]}], "]"}], "]"}]}], ";"}], 
  RowBox[{"(*", " ", 
   RowBox[{
   "angular", " ", "eigenvalues", " ", "in", " ", "the", " ", "limit", " ", 
    "a\[Omega]", " ", 
    RowBox[{"<<", " ", "1"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Lambda]", "=", 
   RowBox[{"Aslm", "+", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"a", " ", "\[Omega]"}], ")"}], "2"], "-", 
    RowBox[{"2", "a", " ", "\[Omega]", " ", "m"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{
  3.992864420543949*^9, {3.9928644545222073`*^9, 3.99286447999642*^9}, {
