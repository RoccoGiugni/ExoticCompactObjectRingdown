Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Series", " ", "coefficients"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"CoefInf", "[", "ord_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"G", ",", "CT", ",", "s1", ",", "s2"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"G", "[", "r_", "]"}], ":=", 
       RowBox[{"Sum", "[", 
        RowBox[{
         FractionBox[
          RowBox[{"gInf", "[", "i", "]"}], 
          SuperscriptBox["r", "i"]], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", 
           RowBox[{"ord", "+", "5"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"CT", "=", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Omega]", " ", 
         RowBox[{"rs", "[", "r", "]"}]}], "]"}]}], ";", 
      RowBox[{"(*", " ", 
       RowBox[{"inverse", " ", "of", " ", "the", " ", "common", " ", "term"}],
        " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"s1", "=", 
       RowBox[{"Simplify", "[", 
        RowBox[{"Normal", "[", 
         RowBox[{"Series", "[", 
          RowBox[{
           RowBox[{"CT", "\[Times]", "sInf"}], ",", 
           RowBox[{"{", 
            RowBox[{"\[Chi]", ",", "0", ",", "1"}], "}"}]}], "]"}], "]"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"s2", "=", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"Series", "[", 
          RowBox[{
           RowBox[{"s1", "/.", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"g", "[", "r", "]"}], "->", 
               RowBox[{"G", "[", "r", "]"}]}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"g", "'"}], "[", "r", "]"}], "->", 
               RowBox[{
                RowBox[{"G", "'"}], "[", "r", "]"}]}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"g", "''"}], "[", "r", "]"}], "->", 
               RowBox[{
                RowBox[{"G", "''"}], "[", "r", "]"}]}]}], "}"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"r", ",", "\[Infinity]", ",", "ord"}], "}"}]}], "]"}], ",", 
         RowBox[{"\[Omega]", ">", "0"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
