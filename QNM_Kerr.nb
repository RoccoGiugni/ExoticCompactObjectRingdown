           RowBox[{"{", 
            RowBox[{"i", ",", "0", ",", "ordInf"}], "}"}]}], "]"}]}], "//.", 
        RowBox[{"Union", "[", 
         RowBox[{"param", ",", "coefInf"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"BC1", "=", 
       RowBox[{"SetPrecision", "[", 
        RowBox[{
         RowBox[{"\[Xi]Inf", "/.", 
