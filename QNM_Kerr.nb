Cell[BoxData[
 RowBox[{
  RowBox[{"FindQNM", "[", 
   RowBox[{"\[Omega]guess_", ",", "\[Chi]0_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "gg", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"gg", "[", 
       RowBox[{"xx_", "?", "NumericQ"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"IntQNM", "[", 
        RowBox[{"xx", ",", "\[Chi]0", ",", 
         RowBox[{"{", 
          RowBox[{
           SuperscriptBox["10", 
            RowBox[{"-", "3"}]], ",", "10", ",", "50"}], "}"}], ",", 
         "coefHor", ",", "coefInf"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"root", "=", 
      RowBox[{"xx", "/.", 
       RowBox[{
        RowBox[{"FindRoot", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"gg", "[", "xx", "]"}], "\[Equal]", "0"}], ",", 
          RowBox[{"{", 
           RowBox[{"xx", ",", "\[Omega]guess"}], "}"}], ",", 
          RowBox[{"AccuracyGoal", "\[Rule]", "6"}], ",", 
          RowBox[{"WorkingPrecision", "\[Rule]", "20"}]}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"check", "=", 
      RowBox[{"Abs", "[", 
       RowBox[{"gg", "[", "root", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"root", ",", "check"}], "}"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
