Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Expand", " ", "EQ", " ", "using", " ", "\[Psi]"}], "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox["e", 
       RowBox[{"\[ImaginaryI]\[Omega]z", "[", "r", "]"}]], 
      RowBox[{"g", "[", "r", "]"}], " ", "and", " ", 
      RowBox[{"z", "[", "r", "]"}]}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["r", "*"], ".", " ", "At"}], " ", "infinity", " ", 
       "\[CapitalOmega]"}], " ", "\[Rule]", " ", "\[Omega]"}]}]}], "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"\[Phi]", "[", "r_", "]"}], ":=", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"\[ImaginaryI]", " ", "\[Omega]", " ", 
        RowBox[{"z", "[", "r", "]"}]}], "]"}], 
      RowBox[{"g", "[", "r", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"s", "=", 
     RowBox[{"Simplify", "[", 
      RowBox[{"EQ1", "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Psi]", "[", "r", "]"}], "->", 
          RowBox[{"\[Phi]", "[", "r", "]"}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Psi]", "'"}], "[", "r", "]"}], "->", 
          RowBox[{
           RowBox[{"\[Phi]", "'"}], "[", "r", "]"}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Psi]", "''"}], "[", "r", "]"}], "->", 
          RowBox[{
           RowBox[{"\[Phi]", "''"}], "[", "r", "]"}]}]}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"sInf", "=", 
    RowBox[{"Simplify", "[", 
     RowBox[{"s", "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"z", "[", "r", "]"}], "->", 
         RowBox[{"rs", "[", "r", "]"}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"z", "'"}], "[", "r", "]"}], "->", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"rs", "[", "r", "]"}], ",", "r"}], "]"}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"z", "''"}], "[", "r", "]"}], "->", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"rs", "[", "r", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"r", ",", "2"}], "}"}]}], "]"}]}]}], "}"}]}], 
     "]"}]}]}]}]], "Input",
