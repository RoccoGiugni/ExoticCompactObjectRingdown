Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Potential", " ", "from", " ", 
     RowBox[{"Eq", ".", " ", "4.2"}], " ", "of", " ", 
     RowBox[{"https", ":"}]}], "//", 
    RowBox[{
     RowBox[{
      RowBox[{"arxiv", ".", "org"}], "/", "pdf"}], "/", "0808.1615"}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"K", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["r", "2"], "+", 
         SuperscriptBox["a", "2"]}], ")"}], "\[Omega]"}], "-", 
      RowBox[{"a", " ", "m"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"G", "=", 
     RowBox[{
      FractionBox[
       RowBox[{"s", 
        RowBox[{"(", 
         RowBox[{"r", "-", "M"}], ")"}]}], 
       RowBox[{
        SuperscriptBox["r", "2"], "+", 
        SuperscriptBox["a", "2"]}]], "+", 
      FractionBox[
       RowBox[{"r", " ", 
        RowBox[{"\[CapitalDelta]", "[", "r", "]"}]}], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["r", "2"], "+", 
          SuperscriptBox["a", "2"]}], ")"}], "2"]]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"V2", "=", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      FractionBox[
       RowBox[{
        SuperscriptBox["K", "2"], "-", 
        RowBox[{"2", "\[ImaginaryI]", " ", "s", 
         RowBox[{"(", 
          RowBox[{"r", "-", "M"}], ")"}], "K"}], "+", 
        RowBox[{
         RowBox[{"\[CapitalDelta]", "[", "r", "]"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
           "4", "\[ImaginaryI]", " ", "s", " ", "\[Omega]", " ", "r"}], "-", 
           "\[CapitalLambda]"}], ")"}]}]}], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["r", "2"], "+", 
          SuperscriptBox["a", "2"]}], ")"}], "2"]], "-", 
      SuperscriptBox["G", "2"], "-", 
      RowBox[{
       FractionBox[
        RowBox[{"\[CapitalDelta]", "[", "r", "]"}], 
        RowBox[{
         SuperscriptBox["r", "2"], "+", 
         SuperscriptBox["a", "2"]}]], 
       RowBox[{"D", "[", 
        RowBox[{"G", ",", "r"}], "]"}]}]}], "]"}]}], 
   RowBox[{"(*", " ", 
    RowBox[{"where", " ", "the", " ", "last", " ", "term", " ", "is", " ", 
     RowBox[{"dG", "/", 
      SubscriptBox["dr", "*"]}], " ", "in", " ", "terms", " ", "of", " ", 
     "r"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"EQ2", "=", 
     RowBox[{
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         FractionBox[
          RowBox[{"\[CapitalDelta]", "[", "r", "]"}], 
          RowBox[{
           SuperscriptBox["r", "2"], "+", 
           SuperscriptBox["a", "2"]}]], ")"}], "2"], 
       RowBox[{
        RowBox[{"Y", "''"}], "[", "r", "]"}]}], "+", 
      RowBox[{
       FractionBox[
        RowBox[{"\[CapitalDelta]", "[", "r", "]"}], 
        RowBox[{
         SuperscriptBox["r", "2"], "+", 
         SuperscriptBox["a", "2"]}]], 
       RowBox[{"D", "[", 
        RowBox[{
         FractionBox[
          RowBox[{"\[CapitalDelta]", "[", "r", "]"}], 
          RowBox[{
           SuperscriptBox["r", "2"], "+", 
           SuperscriptBox["a", "2"]}]], ",", "r"}], "]"}], 
       RowBox[{
        RowBox[{"Y", "'"}], "[", "r", "]"}]}], "+", 
      RowBox[{"V2", " ", 
       RowBox[{"Y", "[", "r", "]"}]}]}]}], ";"}], 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"where", " ", 
      RowBox[{"Y", "[", "r", "]"}]}], "=", 
