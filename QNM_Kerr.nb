Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Integrator", " ", "V1", ".5"}], " ", "-", " ", 
    RowBox[{"precision", " ", "check", " ", "implementation"}], " ", "-", " ", 
    RowBox[{"to", " ", "be", " ", "tested"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"IntQNM", "[", 
    RowBox[{
    "\[Omega]0_", ",", "\[Chi]0_", ",", "value_", ",", "coefHor_", ",", 
     "coefInf_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "rules", ",", "param", ",", "prec", ",", "rHor", ",", "rm", ",", "rInf",
        ",", "\[Xi]", ",", "\[Xi]Hor", ",", "\[Xi]Inf", ",", "EQs", ",", 
       "BCs", ",", "ordHor", ",", "ordInf"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rules", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"AccuracyGoal", "\[Rule]", "12"}], ",", 
         RowBox[{"PrecisionGoal", "\[Rule]", "12"}], ",", 
         RowBox[{"WorkingPrecision", "->", "20"}]}], "}"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{",", 
        RowBox[{"Method", "\[Rule]", "\"\<StiffnessSwitching\>\""}]}], "*)"}],
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"param", "=", 
       RowBox[{"Union", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"M", "->", "1"}], ",", 
           RowBox[{"\[Omega]", "->", "\[Omega]0"}], ",", 
           RowBox[{"\[Chi]", "->", "\[Chi]0"}], ",", 
           RowBox[{
            RowBox[{"hHor", "[", "0", "]"}], "->", "1"}], ",", 
           RowBox[{
            RowBox[{"gInf", "[", "0", "]"}], "->", "1"}], ",", 
           RowBox[{"l", "->", "2"}], ",", 
           RowBox[{"m", "->", "2"}], ",", 
           RowBox[{"s", "->", 
            RowBox[{"-", "2"}]}], ",", 
           RowBox[{"\[CapitalLambda]", "->", "\[Lambda]"}]}], "}"}], ",", 
         RowBox[{"Thread", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"eps", ",", "match", ",", "inf"}], "}"}], "->", "value"}],
           "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"prec", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"20", ",", 
         RowBox[{"Precision", "[", "param", "]"}]}], "]"}]}], ";", 
      RowBox[{"param", "=", 
       RowBox[{"SetPrecision", "[", 
        RowBox[{"param", ",", "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"rHor", "=", 
       RowBox[{
        RowBox[{"rp", 
         RowBox[{"(", 
          RowBox[{"1", "+", "eps"}], ")"}]}], "//.", "param"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rm", "=", 
       RowBox[{
        RowBox[{"match", "\[Times]", "M"}], "//.", "param"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rInf", "=", 
       RowBox[{
        RowBox[{"inf", "\[Times]", "M"}], "//.", "param"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"EQs", "=", 
       RowBox[{"SetPrecision", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"EQ2", "==", "0"}], "}"}], "//.", 
          RowBox[{"Union", "[", 
           RowBox[{"param", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"Y", "[", "r", "]"}], "->", 
               RowBox[{"\[Xi]", "[", "r", "]"}]}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"Y", "'"}], "[", "r", "]"}], "->", 
               RowBox[{
                RowBox[{"\[Xi]", "'"}], "[", "r", "]"}]}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"Y", "''"}], "[", "r", "]"}], "->", 
               RowBox[{
                RowBox[{"\[Xi]", "''"}], "[", "r", "]"}]}]}], "}"}]}], 
           "]"}]}], ",", "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Solution", " ", "integrating", " ", "from", " ", "the", " ", 
        "horizon"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"ordHor", "=", 
       RowBox[{"Length", "[", "coefHor", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"\[Xi]Hor", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "\[ImaginaryI]"}], " ", "k", " ", 
           RowBox[{"rs", "[", "r", "]"}]}], "]"}], 
         SuperscriptBox[
          RowBox[{"\[CapitalDelta]", "[", "r", "]"}], 
          RowBox[{
           RowBox[{"-", "s"}], "/", "2"}]], 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"hHor", "[", "i", "]"}], " ", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"r", "-", "rp"}], ")"}], "i"]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "0", ",", "ordHor"}], "}"}]}], "]"}]}], "//.", 
        RowBox[{"Union", "[", 
         RowBox[{"param", ",", "coefHor"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"BCs", "=", 
       RowBox[{"SetPrecision", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"\[Xi]", "[", "rHor", "]"}], "==", "\[Xi]Hor"}], "/.", 
            RowBox[{"r", "->", "rHor"}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"\[Xi]", "'"}], "[", "rHor", "]"}], "==", 
             RowBox[{"D", "[", 
              RowBox[{"\[Xi]Hor", ",", "r"}], "]"}]}], "/.", 
            RowBox[{"r", "->", "rHor"}]}]}], "}"}], ",", "prec"}], "]"}]}], ";",
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"\[CapitalUpsilon]hor", "=", 
       RowBox[{
        RowBox[{"\[Xi]", "[", "r", "]"}], "/.", 
        RowBox[{
         RowBox[{"NDSolve", "[", 
          RowBox[{
           RowBox[{"Union", "[", 
            RowBox[{"EQs", ",", "BCs"}], "]"}], ",", "\[Xi]", ",", 
           RowBox[{"{", 
            RowBox[{"r", ",", "rHor", ",", "rm"}], "}"}], ",", "rules"}], 
          "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Solution", " ", "integration", " ", "from", " ", "infinity"}],
        " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"ordInf", "=", 
       RowBox[{"Length", "[", "coefInf", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"\[Xi]Inf", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"\[ImaginaryI]", " ", "\[Omega]", " ", 
           RowBox[{"rs", "[", "r", "]"}]}], "]"}], 
         SuperscriptBox["r", 
          RowBox[{"-", "s"}]], 
         RowBox[{"Sum", "[", 
          RowBox[{
           FractionBox[
            RowBox[{"gInf", "[", "i", "]"}], 
            SuperscriptBox["r", "i"]], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "0", ",", "ordInf"}], "}"}]}], "]"}]}], "//.", 
        RowBox[{"Union", "[", 
         RowBox[{"param", ",", "coefInf"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"BCs", "=", 
       RowBox[{"SetPrecision", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"\[Xi]", "[", "rInf", "]"}], "\[Equal]", "\[Xi]Inf"}], "/.", 
            RowBox[{"r", "->", "rInf"}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"\[Xi]", "'"}], "[", "rInf", "]"}], "==", 
             RowBox[{"D", "[", 
              RowBox[{"\[Xi]Inf", ",", "r"}], "]"}]}], "/.", 
            RowBox[{"r", "->", "rInf"}]}]}], "}"}], ",", "prec"}], "]"}]}], ";",
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"\[CapitalUpsilon]inf", "=", 
       RowBox[{
        RowBox[{"\[Xi]", "[", "r", "]"}], "/.", 
        RowBox[{
         RowBox[{"NDSolve", "[", 
          RowBox[{
           RowBox[{"Union", "[", 
            RowBox[{"EQs", ",", "BCs"}], "]"}], ",", "\[Xi]", ",", 
           RowBox[{"{", 
            RowBox[{"r", ",", "rInf", ",", "rm"}], "}"}], ",", "rules"}], 
          "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Linear", " ", "combination"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"b", "=", 
       RowBox[{
        FractionBox["\[CapitalUpsilon]hor", "\[CapitalUpsilon]inf"], "/.", 
        RowBox[{"r", "\[Rule]", "rm"}]}]}], ";", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "we", " ", "fix", " ", "the", " ", "coefficients", " ", "of", " ", 
         "the", " ", "linear", " ", "combination", " ", "in", " ", "order", " ",
          "for", " ", "\[Psi]n", " ", "to", " ", "be", " ", "continuous", " ",
          "at", " ", "r"}], "=", "rm"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"\[CapitalUpsilon]n", "=", 
         RowBox[{"Piecewise", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"\[CapitalUpsilon]hor", ",", 
              RowBox[{"r", "<", "rm"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"b", "\[Times]", "\[CapitalUpsilon]inf"}], ",", 
              RowBox[{"r", "\[GreaterEqual]", "rm"}]}], "}"}]}], "}"}], 
          "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"\[CapitalDelta]\[CapitalUpsilon]p", "=", 
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{"\[CapitalUpsilon]hor", ",", "r"}], "]"}], "-", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"b", " ", "\[CapitalUpsilon]inf"}], ",", "r"}], "]"}]}], 
         RowBox[{"D", "[", 
          RowBox[{"\[CapitalUpsilon]hor", ",", "r"}], "]"}]], "/.", 
        RowBox[{"r", "\[Rule]", "rm"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"{", "\[CapitalDelta]\[CapitalUpsilon]p", "}"}]}]}], 
    "\[IndentingNewLine]", "]"}]}]}]], "Input",
