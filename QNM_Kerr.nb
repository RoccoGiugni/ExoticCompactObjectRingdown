Cell[BoxData[
 RowBox[{
  RowBox[{"FindQNM", "[", 
   RowBox[{"\[Omega]guess_", ",", "\[Chi]0_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "gg", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"gg", "[", 
       RowBox[{"xx_", "?", "NumericQ"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"IntQNM", "[", 
        RowBox[{"xx", ",", "\[Chi]0", ",", 
         RowBox[{"{", 
          RowBox[{
           SuperscriptBox["10", 
            RowBox[{"-", "3"}]], ",", "10", ",", "50"}], "}"}], ",", 
