Cell[CellGroupData[{

Cell["Numerical stability", "Section",
 CellChangeTimes->{{4.002790363724127*^9, 
  4.002790370441107*^9}},ExpressionUUID->"7cbd59d5-c603-8341-8acb-\
14744ae4a171"],

Cell["\<\
In this Section the QNM finder is tested against different sets of its \
hyperparameters. The latter are the \[OpenCurlyQuote]integration parameters\
\[CloseCurlyQuote] defining numerically the event horizon (\[Epsilon]), the \
point of match (\[Mu]) and infinity (\[Iota]), and the order at which the \
series expansion at the horizon and at infinity are truncated.

In the case of \[OpenCurlyQuote]integration parameters\[CloseCurlyQuote] the \
space is explored randomly. See `QNM_Compute.nb` for the functions handling \
the sampling and the computation.\
\>", "Text",
 CellChangeTimes->{{4.002952471921526*^9, 4.002952518150999*^9}, {
   4.002952554910614*^9, 4.002952740445652*^9}, 
   4.003550758503641*^9},ExpressionUUID->"cb32ad96-2d2b-d249-9953-\
5460e57618a6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"-", " ", 
      RowBox[{"MultiPlot", " ", "--"}]}]}], "-"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "xs", " ", "are", " ", "supposed", " ", "to", " ", "be", " ", "the", " ", 
    "first", " ", "n", " ", "element", " ", "of", " ", "each", " ", "data", " ",
     "point"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"MultiPlot", "[", 
     RowBox[{"data_", ",", "iy_", ",", "n_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"plots", ",", "l", ",", "s", ",", "point"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"plots", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"l", "=", 
           RowBox[{"Extract", "[", 
            RowBox[{"label", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", "ix", "}"}], ",", 
               RowBox[{"{", "iy", "}"}]}], "}"}]}], "]"}]}], ";", 
          RowBox[{"s", "=", 
           RowBox[{"Extract", "[", 
            RowBox[{"scale", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", "ix", "}"}], ",", 
               RowBox[{"{", "iy", "}"}]}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"point", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Extract", "[", 
              RowBox[{"j", ",", 
               RowBox[{"{", 
                RowBox[{";;", ",", 
                 RowBox[{"{", 
                  RowBox[{"ix", ",", "iy"}], "}"}]}], "}"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "data"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"plots", ",", 
            RowBox[{"ListPlot", "[", 
             RowBox[{"point", ",", 
              RowBox[{"AxesLabel", "->", "l"}], ",", 
              RowBox[{"ScalingFunctions", "->", "s"}], ",", 
              RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"ix", ",", "n"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "plots", "]"}], ";"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{4.0029530879054375`*^9, 4.002953219788595*^9}, {
   4.002953294908287*^9, 4.0029534604551697`*^9}, {4.0029534954100037`*^9, 
   4.002953512876295*^9}, {4.002953660664732*^9, 4.002953695842579*^9}, 
   4.002955162180519*^9, {4.0035507682462234`*^9, 4.0035507833310585`*^9}},
 CellLabel->"In[28]:=",ExpressionUUID->"02d27316-1464-b745-a98e-d16635b3dab4"],

