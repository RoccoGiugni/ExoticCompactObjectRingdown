         RowBox[{"n", "-", "1"}]]}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "1", ",", "3"}], "}"}]}], "]"}], "]"}]}], ";"}], 
  RowBox[{"(*", " ", 
   RowBox[{
   "angular", " ", "eigenvalues", " ", "in", " ", "the", " ", "limit", " ", 
    "a\[Omega]", " ", 
    RowBox[{"<<", " ", "1"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
