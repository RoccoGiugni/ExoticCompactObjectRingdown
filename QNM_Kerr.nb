  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "gg", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"gg", "[", 
       RowBox[{"xx_", "?", "NumericQ"}], "]"}], ":=", 
