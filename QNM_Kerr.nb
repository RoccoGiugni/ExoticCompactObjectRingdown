           RowBox[{
            RowBox[{"(", 
             RowBox[{"r", "-", "r1"}], ")"}], 
            RowBox[{"(", 
             RowBox[{"r", "-", "r2"}], ")"}]}]], ",", "r"}], "]"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"r1", "->", "rp"}], ",", 
          RowBox[{"r2", "->", "rm"}]}], "}"}]}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"r", ">", "rp", ">", "0"}], ",", 
         RowBox[{"a", ">", "0"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"rs", "[", "r", "]"}]}]}]], "Input",
