               RowBox[{
                RowBox[{"\[Gamma]", "'"}], "[", "r", "]"}], "->", 
               RowBox[{"D", "[", 
                RowBox[{
                 RowBox[{"\[CapitalGamma]", "[", "r", "]"}], ",", "r"}], 
                "]"}]}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"\[Gamma]", "''"}], "[", "r", "]"}], "->", 
               RowBox[{"D", "[", 
                RowBox[{
                 RowBox[{"\[CapitalGamma]", "[", "r", "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"r", ",", "2"}], "}"}]}], "]"}]}]}], "}"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"r", ",", "\[Infinity]", ",", "ord"}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"M", ">", "0"}], ",", 
           RowBox[{"a", ">", "0"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Solve", " ", "the", " ", "system"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Simplify", "[", 
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"SeriesCoefficient", "[", 
