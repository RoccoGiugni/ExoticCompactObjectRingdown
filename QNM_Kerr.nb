          RowBox[{"gInf", "[", "i", "]"}], 
          SuperscriptBox["r", "i"]], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", 
           RowBox[{"ord", "+", "5"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"s", "=", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"Series", "[", 
          RowBox[{
           RowBox[{"sInf", "/.", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"\[DoubleStruckG]", "[", "r", "]"}], "->", 
               RowBox[{"G", "[", "r", "]"}]}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"\[DoubleStruckG]", "'"}], "[", "r", "]"}], "->", 
               RowBox[{"D", "[", 
                RowBox[{
                 RowBox[{"G", "[", "r", "]"}], ",", "r"}], "]"}]}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"\[DoubleStruckG]", "''"}], "[", "r", "]"}], "->", 
               RowBox[{"D", "[", 
                RowBox[{
                 RowBox[{"G", "[", "r", "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"r", ",", "2"}], "}"}]}], "]"}]}]}], "}"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"r", ",", "\[Infinity]", ",", "ord"}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"M", ">", "0"}], ",", 
           RowBox[{"a", ">", "0"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Solve", " ", "the", " ", "system"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Simplify", "[", 
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"SeriesCoefficient", "[", 
             RowBox[{"s", ",", "i"}], "]"}], "==", "0"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "2", ",", "ord"}], "}"}]}], "]"}], ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"gInf", "[", "i", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", 
             RowBox[{"ord", "-", "1"}]}], "}"}]}], "]"}]}], "]"}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9950146344470024`*^9, 3.9950147357781334`*^9}, {
