       SuperscriptBox["l", "2"], "-", 
       SuperscriptBox["s", "2"]}], ")"}]}], 
    RowBox[{"2", 
     RowBox[{"(", 
      RowBox[{"l", "-", 
       FractionBox["1", "2"]}], ")"}], 
     SuperscriptBox["l", "3"], 
     RowBox[{"(", 
      RowBox[{"l", "+", 
       FractionBox["1", "2"]}], ")"}]}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fslm", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"l", 
        RowBox[{"(", 
         RowBox[{"l", "+", "1"}], ")"}]}], "\[Minus]", 
       RowBox[{"s", 
        RowBox[{"(", 
         RowBox[{"s", "+", "1"}], ")"}]}]}], ",", 
      RowBox[{
       RowBox[{"\[Minus]", "2"}], 
       FractionBox[
        RowBox[{"m", " ", 
         SuperscriptBox["s", "2"]}], 
        RowBox[{"l", 
         RowBox[{"(", 
          RowBox[{"l", "+", "1"}], ")"}]}]]}], ",", 
      RowBox[{
       RowBox[{"h", "[", 
        RowBox[{"l", "+", "1"}], "]"}], "\[Minus]", 
       RowBox[{"h", "[", "l", "]"}], "\[Minus]", "1"}]}], "}"}]}], ";"}], 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"see", " ", 
     RowBox[{"Eqs", ".", " ", "2.16"}], " ", "of", " ", 
     RowBox[{"https", ":"}]}], "//", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"arxiv", ".", "org"}], "/", "pdf"}], "/", "gr"}], "-", 
     RowBox[{"qc", "/", "0511111"}]}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Aslm", "=", 
