         RowBox[{"{", 
          RowBox[{
           RowBox[{"M", ">", "0"}], ",", 
           RowBox[{"a", ">", "0"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Solve", " ", "the", " ", "system"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Simplify", "[", 
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"SeriesCoefficient", "[", 
             RowBox[{"s", ",", "i"}], "]"}], "==", "0"}], ",", 
